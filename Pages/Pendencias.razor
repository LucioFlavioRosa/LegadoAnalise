@page "/pendencias"
@rendermode InteractiveAuto

@inject Services.Pendencias.Common.IPendenciasService PendenciasService
@inject Services.Common.IMessageBoxService MessageBoxService

<PageTitle>Pendências</PageTitle>

<div class="page-breadcrumb border-bottom">
    <div class="row">
        <div class="col-lg-3 col-md-4 col-xs-12 align-self-center">
            <h5 class="font-medium text-uppercase mb-0">Pendências</h5>
        </div>
        <div class="col-lg-9 col-md-8 col-xs-12 align-self-center">
            <nav aria-label="breadcrumb" class="mt-2 float-md-right float-left">
                <ol class="breadcrumb mb-0 justify-content-end p-0">
                    <li class="breadcrumb-item"><a href="/">Peers</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Pendências</li>
                </ol>
            </nav>
        </div>
    </div>
</div>

<div class="page-content container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-body">
                    <h4 class="card-title">Minhas pendências</h4>

                    @if (IsLoading)
                    {
                        <div class="text-center my-5">
                            <span class="spinner-border" role="status" aria-hidden="true"></span>
                            <span class="ml-2">Carregando pendências...</span>
                        </div>
                    }
                    else if (Pendencias?.Count > 0)
                    {
                        <div class="table-responsive">
                            <table class="table table-striped border dtInit">
                                <thead>
                                    <tr>
                                        <th>Foto</th>
                                        <th>Associado</th>
                                        <th>Projeto</th>
                                        <th>Pendência</th>
                                        <th>Período</th>
                                        <th>Data Limite</th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Pendencias)
                                    {
                                        <tr>
                                            <td>
                                                <img src="@item.FotoNome" width="120" height="120" alt="Foto do Associado" onerror="this.onerror=null;this.src='assets/images/users/usernophoto.jpg';" />
                                            </td>
                                            <td>@item.Nome</td>
                                            <td>@item.Projeto</td>
                                            <td>@item.Pendencia</td>
                                            <td>@item.Periodo</td>
                                            <td>@item.DataLimite</td>
                                            <td style="text-align:right;"></td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-info mt-4">Nenhuma pendência encontrada.</div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
