@using Services.Feedback.Common
@using Services.Feedback.Models
@inject Services.Common.IMessageBoxService MessageBoxService

@if (Competencias == null || Competencias.Count == 0)
{
    <div class="alert alert-warning">Nenhuma competência encontrada para este contexto.</div>
}
else
{
    <EditForm Model="Competencias" OnValidSubmit="HandleSalvar">
        <div class="form-body">
            <div class="row">
                <div class="col-md-12">
                    <div class="text-right">
                        <button type="submit" class="btn btn-dark" disabled="@IsReadOnly">Salvar Avaliação</button>
                    </div>
                </div>
            </div>
        </div>
        <div class="table-responsive" style="overflow-y:auto !important; height:600px">
            <table class="table table-striped border" style="width:100%;table-layout:fixed">
                <thead>
                    <tr>
                        <th colspan="8" style="background-color:#e5e019;color:#021240;position:sticky;top:-5px">Nível 1</th>
                        <th colspan="10" style="background-color:#e5e019;color:#021240;position:sticky;top:-5px">Nível 2</th>
                    </tr>
                    <tr>
                        <th colspan="4" style="color:#021240;background-color:#eae678;position:sticky;top:45px">Detalhamento Atual</th>
                        <th hidden>Nível Atual</th>
                        <th colspan="1" style="color:#021240;background-color:#eae678;position:sticky;top:45px">Nota Avaliado</th>
                        <th colspan="1" style="color:#021240;background-color:#eae678;position:sticky;top:45px">Nota Gestor</th>
                        <th colspan="2" style="color:#021240;background-color:#eae678;position:sticky;top:45px">Feedback</th>
                        <th colspan="4" style="color:#021240;background-color:#eae678;position:sticky;top:45px">Detalhamento Próximo Nível</th>
                        <th hidden>Próximo Nível</th>
                        <th colspan="1" style="color:#021240;background-color:#eae678;position:sticky;top:45px">Nota Avaliado</th>
                        <th colspan="1" style="color:#021240;background-color:#eae678;position:sticky;top:45px">Nota Gestor</th>
                        <th colspan="2" style="color:#021240;background-color:#eae678;position:sticky;top:45px">Feedback</th>
                        <th colspan="2" style="color:#021240;background-color:#eae678;position:sticky;top:45px">Considerações</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var comp in Competencias)
                    {
                        <tr style="font-style:italic;font-size:14px;font-weight:normal;background-color:#f2f2f2;vertical-align:bottom">
                            <th colspan="18" style="font-style:normal;font-size:21px;font-weight:normal;align-content:center;text-align:center;border-top:5px solid;border-color:#003150">
                                @comp.SubCompetencia
                            </th>
                        </tr>
                        <tr style="font-weight:bold;background-color:#f5f5f5;border-top:none">
                            <td colspan="18" style="text-align:center;border-top:none">@comp.PalavrasChave</td>
                        </tr>
                        <tr style="font-weight:normal;background-color:#f9f9f9;border-top:none">
                            <td colspan="4" style="border-top:none;background-color:#f9f9f9">
                                <a href="#det_@comp.IdCompetencia" data-bs-toggle="collapse" class="accordion-toggle">
                                    @FormatHelper.TruncarTexto(comp.DetalheNivelAtual, 70)
                                    <span style="font-weight:bold"> Ver+</span>
                                </a>
                            </td>
                            <td hidden colspan="1"></td>
                            <td colspan="1">@comp.Nota1Avaliado</td>
                            <td colspan="1">@comp.Nota1Gestor</td>
                            <td colspan="2">@comp.FeedbackNivel1</td>
                            <td colspan="4">
                                <a href="#detPrNivel_@comp.IdCompetencia" data-bs-toggle="collapse" class="accordion-toggle">
                                    @FormatHelper.TruncarTexto(comp.DetalheProximoNivel, 70)
                                    <span style="font-weight:bold"> Ver+</span>
                                </a>
                            </td>
                            <td hidden colspan="1"></td>
                            <td colspan="1">@comp.Nota2Avaliado</td>
                            <td colspan="1">@comp.Nota2Gestor</td>
                            <td colspan="2">@comp.FeedbackNivel2</td>
                            <td colspan="2" style="text-align:center">
                                <button type="button" class="accordion-toggle" style="background-color:#003150;padding:8px 15px;border:none" data-bs-toggle="collapse" data-bs-target="#cons_@comp.IdCompetencia">
                                    <span style="color:white;font-size:15px">Considerações</span>
                                </button>
                            </td>
                        </tr>
                        <tr>
                            <td colspan="18" class="hiddenRow" style="border-top:none;background-color:#ffffff">
                                <div class="collapse" id="det_@comp.IdCompetencia">
                                    <strong>Detalhamento Cargo Atual:</strong><br />@comp.DetalheNivelAtual
                                </div>
                            </td>
                        </tr>
                        <tr>
                            <td colspan="18" class="hiddenRow" style="border-top:none;background-color:#ffffff">
                                <div class="collapse" id="detPrNivel_@comp.IdCompetencia">
                                    <strong>Detalhamento Próximo Nível:</strong><br />@comp.DetalheProximoNivel
                                </div>
                            </td>
                        </tr>
                        <tr>
                            <td colspan="18" class="hiddenRow">
                                <div class="collapse" id="cons_@comp.IdCompetencia">
                                    <p>
                                        <strong>Observações do avaliado:</strong><br>
                                        @comp.ObservacaoAvaliado
                                    </p>
                                    <p>
                                        <strong>Observações do gestor:</strong><br>
                                        @comp.ObservacaoGestor
                                    </p>
                                    <div>
                                        <strong>Considerações do feedback:</strong><br />
                                        <textarea class="form-control" rows="5" @bind="comp.Consideracoes" disabled="@IsReadOnly"></textarea>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="form-body mt-3">
            <div class="row">
                <div class="col-md-12">
                    <div class="text-right">
                        <button type="submit" class="btn btn-dark" disabled="@IsReadOnly">Salvar Avaliação</button>
                    </div>
                </div>
            </div>
        </div>
    </EditForm>
}

@code {
    [Parameter]
    public List<CompetenciaModel> Competencias { get; set; } = new();
    [Parameter]
    public EventCallback<List<CompetenciaModel>> OnSalvar { get; set; }
    [Parameter]
    public EventCallback<List<CompetenciaModel>> OnFinalizar { get; set; }
    [Parameter]
    public EventCallback OnIrPerformance { get; set; }
    [Parameter]
    public IFeedbackValidationHelper ValidationHelper { get; set; } = default!;
    [Parameter]
    public IFeedbackComboHelper ComboHelper { get; set; } = default!;
    [Parameter]
    public IFeedbackFormatHelper FormatHelper { get; set; } = default!;
    [Parameter]
    public bool IsReadOnly { get; set; } = false;

    private async Task HandleSalvar()
    {
        if (OnSalvar.HasDelegate)
            await OnSalvar.InvokeAsync(Competencias);
    }
}
