@page "/feedback/competencia"
@rendermode InteractiveAuto
@inject Services.Feedback.IFeedbackService FeedbackService
@inject Services.Feedback.Common.IFeedbackValidationHelper FeedbackValidationHelper
@inject Services.Feedback.Common.IFeedbackComboHelper FeedbackComboHelper
@inject Services.Feedback.Common.IFeedbackFormatHelper FeedbackFormatHelper
@inject Services.Feedback.Common.IFeedbackChartHelper FeedbackChartHelper
@inject Services.Common.IMessageBoxService MessageBoxService
@inject NavigationManager NavigationManager
@using Pages.Feedback.Components

<PageTitle>Feedback - Competências</PageTitle>

@if (IsLoading)
{
    <div class="spinner-border text-primary" role="status">
        <span class="sr-only">Carregando...</span>
    </div>
}
else if (ErrorMessage != null)
{
    <div class="alert alert-danger">@ErrorMessage</div>
}
else
{
    <div class="page-breadcrumb border-bottom" style="position:sticky;top:0;z-index:1;width:100%">
        <div class="row">
            <div class="col-lg-3 col-md-4 col-xs-12 align-self-center">
                <h5 class="font-medium text-uppercase mb-0">Feedback</h5>
            </div>
            <div class="col-lg-9 col-md-8 col-xs-12 align-self-center">
                <nav aria-label="breadcrumb" class="mt-2 float-md-right float-left">
                    <ol class="breadcrumb mb-0 justify-content-end p-0">
                        <li class="breadcrumb-item"><a href="/">Peers</a></li>
                        <li class="breadcrumb-item"><a href="/feedback">Avaliação / Feedback</a></li>
                        <li class="breadcrumb-item active" aria-current="page">Competência</li>
                    </ol>
                </nav>
            </div>
        </div>
    </div>

    <div class="container-fluid page-content" style="overflow:initial !important">
        <div class="card col-md-10 mx-auto" style="position:sticky;top:56px;z-index:1;margin-top:21px;border-color:rgba(0,0,0,.25);border-width:1px">
            <div class="card-body">
                <div class="accordion" id="accordionDetalhes">
                    <div class="card">
                        <div class="card-header" id="headingDetalhes">
                            <h5 class="mb-0">
                                <button class="btn btn-link" type="button" data-bs-toggle="collapse" data-bs-target="#Detalhes" aria-expanded="true" aria-controls="Detalhes">
                                    Detalhes da avaliação
                                </button>
                            </h5>
                        </div>
                        <div id="Detalhes" class="collapse show" aria-labelledby="headingDetalhes" data-bs-parent="#accordionDetalhes">
                            <div class="row mb-2">
                                <div class="col-md-5">
                                    <div class="text-left">
                                        <button type="button" class="btn btn-facebook" disabled>Competência</button>
                                        <button class="btn btn-danger" @onclick="IrParaPerformance">Performance</button>
                                        <button class="btn btn-info" @onclick="IrParaFinalizacao">Ir para Finalização</button>
                                    </div>
                                </div>
                            </div>
                            <div class="row mb-2">
                                <div class="col-md-2"><b>Avaliado</b></div>
                                <div class="col-md-4">@Detalhes?.AssociadoNome</div>
                                <div class="col-md-2"><b>Período</b></div>
                                <div class="col-md-4">@Detalhes?.PeriodoNome</div>
                            </div>
                            <div class="row mb-2">
                                <div class="col-md-2"><b>Tempo de Cargo</b></div>
                                <div class="col-md-4">@Detalhes?.TempoCargo</div>
                                <div class="col-md-2"><b>Tempo de Peers</b></div>
                                <div class="col-md-4">@Detalhes?.TempoPeers</div>
                            </div>
                            <div class="row mb-2">
                                <div class="col-md-1"><b>Projeto</b></div>
                                <div class="col-md-3">@Detalhes?.ProjetoNome</div>
                                <div class="col-md-1"><b>Cliente</b></div>
                                <div class="col-md-3">@Detalhes?.ClienteNome</div>
                                <div class="col-md-2"><b>Tempo restante</b></div>
                                <div class="col-md-2">@Detalhes?.TempoRestante</div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="accordion mt-3" id="accordionCabecalho">
                    <div class="card">
                        <div class="card-header" id="headingCabecalho">
                            <h5 class="mb-0">
                                <button class="btn btn-link" type="button" data-bs-toggle="collapse" data-bs-target="#Cabecalho" aria-expanded="true" aria-controls="Cabecalho">
                                    Descrições nível atual e próximo nível
                                </button>
                            </h5>
                        </div>
                        <div id="Cabecalho" class="collapse show" aria-labelledby="headingCabecalho" data-bs-parent="#accordionCabecalho">
                            <div class="table-responsive">
                                <table class="table table-striped border" style="width:100%;table-layout:fixed">
                                    <thead>
                                        <tr>
                                            <th colspan="1"></th>
                                            <th colspan="2">Cargo</th>
                                            <th colspan="2">Função</th>
                                            <th colspan="2">Autonomia</th>
                                            <th colspan="2">Escopo de Atuação</th>
                                            <th colspan="2">Nível de interlocução principal no cliente</th>
                                            @foreach (var titulo in CabecalhoCompetencias?.Titulos ?? Enumerable.Empty<string>())
                                            {
                                                <th colspan="2">@titulo</th>
                                            }
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr>
                                            <td colspan="1">Nível atual</td>
                                            <td colspan="2">@CabecalhoCompetencias?.CargoAtual</td>
                                            <td colspan="2">@CabecalhoCompetencias?.FuncaoAtual</td>
                                            <td colspan="2">@CabecalhoCompetencias?.AutonomiaAtual</td>
                                            <td colspan="2">@CabecalhoCompetencias?.EscopoAtual</td>
                                            <td colspan="2">@CabecalhoCompetencias?.InterlocucaoAtual</td>
                                            @foreach (var desc in CabecalhoCompetencias?.DescricoesAtuais ?? Enumerable.Empty<string>())
                                            {
                                                <th colspan="2" style="font-weight:normal">@desc</th>
                                            }
                                        </tr>
                                        <tr>
                                            <td colspan="1">Próximo nível</td>
                                            <td colspan="2">@CabecalhoCompetencias?.CargoProximo</td>
                                            <td colspan="2">@CabecalhoCompetencias?.FuncaoProximo</td>
                                            <td colspan="2">@CabecalhoCompetencias?.AutonomiaProximo</td>
                                            <td colspan="2">@CabecalhoCompetencias?.EscopoProximo</td>
                                            <td colspan="2">@CabecalhoCompetencias?.InterlocucaoProximo</td>
                                            @foreach (var desc in CabecalhoCompetencias?.DescricoesProximos ?? Enumerable.Empty<string>())
                                            {
                                                <th colspan="2" style="font-weight:normal">@desc</th>
                                            }
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </div>

        <div class="card col-md-12 mx-auto mt-4">
            <div class="card-body">
                <div class="accordion" id="accordionCompetencia">
                    <div class="card">
                        <div class="card-header" id="headingRadar">
                            <h5 class="mb-0">
                                <button class="btn btn-link" type="button" data-bs-toggle="collapse" data-bs-target="#Radar" aria-expanded="true" aria-controls="Radar">
                                    Radar
                                </button>
                            </h5>
                        </div>
                        <div id="Radar" class="collapse show" aria-labelledby="headingRadar" data-bs-parent="#accordionCompetencia">
                            <div class="card-body">
                                <FeedbackRadar RadarData="RadarData" />
                            </div>
                        </div>
                    </div>

                    <div class="card mt-3">
                        <div class="card-header" id="headingCompetencia">
                            <h5 class="mb-0">
                                <button class="btn btn-link" type="button" data-bs-toggle="collapse" data-bs-target="#competencias" aria-expanded="true" aria-controls="competencias">
                                    Feedback - Competências
                                </button>
                            </h5>
                        </div>
                        <div id="competencias" class="collapse show" aria-labelledby="headingCompetencia" data-bs-parent="#accordionCompetencia">
                            <div class="card-body">
                                <CompetenciaTable
                                    Competencias="Competencias"
                                    OnSalvar="SalvarFeedback"
                                    OnFinalizar="FinalizarFeedback"
                                    OnIrPerformance="IrParaPerformance"
                                    ValidationHelper="FeedbackValidationHelper"
                                    ComboHelper="FeedbackComboHelper"
                                    FormatHelper="FeedbackFormatHelper"
                                    IsReadOnly="IsReadOnly"
                                />
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </div>

        <div class="card mt-4">
            <div class="card-body">
                <div class="col-md-5">
                    <div class="text-left">
                        <button type="button" class="btn btn-facebook" disabled>Competência</button>
                        <button class="btn btn-danger" @onclick="IrParaPerformance">Performance</button>
                        <button class="btn btn-info" @onclick="IrParaFinalizacao">Ir para Finalização</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private bool IsLoading = true;
    private string? ErrorMessage;
    private FeedbackDetalhesModel? Detalhes;
    private CabecalhoCompetenciasModel? CabecalhoCompetencias;
    private List<CompetenciaModel> Competencias = new();
    private object? RadarData;
    private bool IsReadOnly = false;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            IsLoading = true;
            ErrorMessage = null;
            var result = await FeedbackService.CarregarFeedbackCompetenciaAsync();
            Detalhes = result.Detalhes;
            CabecalhoCompetencias = result.CabecalhoCompetencias;
            Competencias = result.Competencias;
            RadarData = FeedbackChartHelper.PrepararRadarData(result.Radar);
            IsReadOnly = result.IsReadOnly;
        }
        catch (Exception ex)
        {
            ErrorMessage = "Erro ao carregar dados: " + ex.Message;
        }
        finally
        {
            IsLoading = false;
        }
    }

    private async Task SalvarFeedback(List<CompetenciaModel> competencias)
    {
        var valid = FeedbackValidationHelper.ValidarFeedback(competencias);
        if (!valid.IsValid)
        {
            await MessageBoxService.ShowError(valid.ErrorMessage);
            return;
        }
        var sucesso = await FeedbackService.SalvarFeedbackCompetenciaAsync(competencias);
        if (sucesso)
        {
            await MessageBoxService.ShowSuccess("Feedback salvo com sucesso.");
        }
        else
        {
            await MessageBoxService.ShowError("Falha ao salvar feedback.");
        }
    }

    private async Task FinalizarFeedback(List<CompetenciaModel> competencias)
    {
        var valid = FeedbackValidationHelper.ValidarFeedback(competencias);
        if (!valid.IsValid)
        {
            await MessageBoxService.ShowError(valid.ErrorMessage);
            return;
        }
        var sucesso = await FeedbackService.FinalizarFeedbackCompetenciaAsync(competencias);
        if (sucesso)
        {
            await MessageBoxService.ShowSuccess("Feedback finalizado com sucesso.");
            NavigationManager.NavigateTo("/feedback");
        }
        else
        {
            await MessageBoxService.ShowError("Falha ao finalizar feedback.");
        }
    }

    private void IrParaPerformance()
    {
        NavigationManager.NavigateTo("/feedback/performance");
    }

    private void IrParaFinalizacao()
    {
        NavigationManager.NavigateTo("/feedback/finalizacao");
    }
}
