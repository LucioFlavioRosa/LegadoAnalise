@using Microsoft.JSInterop
@inject IJSRuntime JS
@inject Services.Common.ChartJsInteropService ChartJsInteropService

<div>
    <canvas id="@ChartId" width="@Width" height="@Height"></canvas>
</div>

@code {
    [Parameter]
    public string ChartId { get; set; } = $"chart_{Guid.NewGuid()}";

    [Parameter]
    public string ChartType { get; set; } = "bar";

    [Parameter]
    public object? ChartData { get; set; }

    [Parameter]
    public object? ChartOptions { get; set; }

    [Parameter]
    public int Width { get; set; } = 600;

    [Parameter]
    public int Height { get; set; } = 400;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && ChartData != null)
        {
            await ChartJsInteropService.RenderChartAsync(JS, ChartId, ChartType, ChartData, ChartOptions);
        }
    }
}
