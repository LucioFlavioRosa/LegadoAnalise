@using Peers.Moderno.Services.Common
@inject IMessageBoxService MessageBoxService

@if (!string.IsNullOrEmpty(message))
{
    <div class="alert @GetAlertClass(type)" role="alert" style="position:fixed;top:20px;right:20px;z-index:9999;min-width:300px">
        @if (!string.IsNullOrEmpty(title))
        {
            <strong>@title</strong><br />
        }
        @message
        <button type="button" class="close" aria-label="Close" @onclick="Close">
            <span aria-hidden="true">&times;</span>
        </button>
    </div>
}

@code {
    private string? message;
    private string? title;
    private MessageBoxType type = MessageBoxType.Info;
    private int? delay;
    private System.Timers.Timer? timer;

    protected override void OnInitialized()
    {
        MessageBoxService.OnMessageReceived += ShowMessage;
    }

    private void ShowMessage(MessageBoxEventArgs args)
    {
        message = args.Message;
        title = args.Title;
        type = args.Type;
        delay = args.Delay;
        StateHasChanged();
        if (delay.HasValue && delay.Value > 0)
        {
            timer?.Dispose();
            timer = new System.Timers.Timer(delay.Value);
            timer.Elapsed += (s, e) => Close();
            timer.AutoReset = false;
            timer.Start();
        }
    }

    private void Close()
    {
        message = null;
        title = null;
        delay = null;
        StateHasChanged();
        timer?.Dispose();
        timer = null;
    }

    private string GetAlertClass(MessageBoxType type)
    {
        return type switch
        {
            MessageBoxType.Success => "alert alert-success",
            MessageBoxType.Error => "alert alert-danger",
            MessageBoxType.Warning => "alert alert-warning",
            _ => "alert alert-info"
        };
    }

    public void Dispose()
    {
        MessageBoxService.OnMessageReceived -= ShowMessage;
        timer?.Dispose();
    }
}
