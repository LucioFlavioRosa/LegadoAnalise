@page "/feedback-performance"
@rendermode InteractiveAuto
@inject Services.FeedbackPerformance.IFeedbackPerformanceService FeedbackPerformanceService
@inject Services.FeedbackPerformance.Common.FeedbackPerformanceHelper FeedbackPerformanceHelper
@inject Services.FeedbackPerformance.Common.FeedbackPerformanceValidator FeedbackPerformanceValidator
@inject Services.FeedbackPerformance.Common.FeedbackPerformanceComboHelper ComboHelper
@inject Services.Common.IMessageBoxService MessageBoxService
@inject NavigationManager NavigationManager

<PageTitle>Feedback de Performance</PageTitle>

<div class="container mt-4">
    <h2>Feedback de Performance</h2>
    <div class="row mb-3">
        <div class="col-md-3">
            <label>Projeto:</label>
            <span>@ProjetoNome</span>
        </div>
        <div class="col-md-3">
            <label>Associado:</label>
            <span>@AssociadoNome</span>
        </div>
        <div class="col-md-3">
            <label>Período:</label>
            <span>@PeriodoNome</span>
        </div>
        <div class="col-md-3">
            <label>Gestor:</label>
            <span>@GestorNome</span>
        </div>
    </div>
    <div class="row mb-3">
        <div class="col-md-3">
            <label>Cliente:</label>
            <span>@ClienteNome</span>
        </div>
        <div class="col-md-3">
            <label>Tempo Restante:</label>
            <span>@TempoRestante</span>
        </div>
    </div>

    <EditForm Model="FeedbackModel" OnValidSubmit="SalvarFeedback">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="table-responsive">
            <table class="table table-striped border">
                <thead>
                    <tr>
                        <th>Performance</th>
                        <th>Nota Avaliado</th>
                        <th>Observação Avaliado</th>
                        <th>Nota Cegas</th>
                        <th>Nota Gestor</th>
                        <th>Observação Gestor</th>
                        <th>Nota Feedback</th>
                        <th>Observação Feedback</th>
                    </tr>
                </thead>
                <tbody>
                    @if (FeedbackModel.Performances != null)
                    {
                        string abrangenciaAtual = null;
                        foreach (var perf in FeedbackModel.Performances)
                        {
                            if (!string.IsNullOrEmpty(perf.Abrangencia) && perf.Abrangencia != abrangenciaAtual)
                            {
                                abrangenciaAtual = perf.Abrangencia;
                                <tr class="table-secondary">
                                    <td colspan="8" style="text-align:center;font-size:16px">@abrangenciaAtual</td>
                                </tr>
                            }
                            <tr>
                                <td>@perf.Descricao</td>
                                <td>@perf.NotaAvaliado</td>
                                <td>@perf.ObservacaoAvaliado</td>
                                <td>@perf.NotaCegas</td>
                                <td>@perf.NotaGestor</td>
                                <td>@perf.ObservacaoGestor</td>
                                <td>
                                    <InputSelect class="form-control" @bind-Value="perf.NotaFeedback" disabled="@(!perf.InputAvaliacaoGestor)">
                                        @foreach (var nota in ComboHelper.GetNotasFeedbackItems())
                                        {
                                            <option value="@nota.Value" disabled="@nota.IsDisabled">@nota.Text</option>
                                        }
                                    </InputSelect>
                                </td>
                                <td>
                                    <InputTextArea class="form-control" @bind-Value="perf.ObservacaoFeedback" rows="3" disabled="@(!perf.InputAvaliacaoGestor)"></InputTextArea>
                                    @if (!perf.InputAvaliacaoGestor)
                                    {
                                        <div class="text-muted" style="font-size:13px;font-style:italic;">Esta nota não requer preenchimento em feedback</div>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        <div class="mt-4">
            <button type="submit" class="btn btn-primary" disabled="@IsFinalizado">Salvar</button>
            <button type="button" class="btn btn-success ms-2" @onclick="FinalizarFeedback" disabled="@IsFinalizado">Finalizar</button>
            <button type="button" class="btn btn-secondary ms-2" @onclick="IrParaCompetencia">Ir para Competência</button>
        </div>
    </EditForm>
</div>

@if (!string.IsNullOrEmpty(Mensagem))
{
    <div class="alert alert-info mt-3">@Mensagem</div>
}
