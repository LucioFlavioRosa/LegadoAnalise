@page "/avaliacoes-gestor-performance"
@rendermode InteractiveAuto
@inject Services.AvaliacoesGestor.Common.IAvaliacoesGestorService AvaliacoesGestorService
@inject Services.AvaliacoesGestor.Common.IAvaliacoesGestorHelper AvaliacoesGestorHelper
@inject Services.Common.IComboHelper ComboHelper
@inject Services.Common.IMessageBoxService MessageBoxService
@inject Services.Common.IFormatHelper FormatHelper
@inject NavigationManager NavigationManager

<PageTitle>Avaliação Gestor - Performance</PageTitle>

<div class="page-breadcrumb border-bottom">
    <div class="row">
        <div class="col-lg-3 col-md-4 col-xs-12 align-self-center">
            <h5 class="font-medium text-uppercase mb-0">Avaliação Gestor</h5>
        </div>
        <div class="col-lg-9 col-md-8 col-xs-12 align-self-center">
            <nav aria-label="breadcrumb" class="mt-2 float-md-right float-left">
                <ol class="breadcrumb mb-0 justify-content-end p-0">
                    <li class="breadcrumb-item"><a href="index">Peers</a></li>
                    <li class="breadcrumb-item"><a href="index">Avaliação / Avaliação Gestor</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Performance</li>
                </ol>
            </nav>
        </div>
    </div>
</div>

<div class="page-content container-fluid">
    <div class="card">
        <div class="card-body">
            <form>
                <div class="form-body">
                    <div class="row">
                        <div class="col-md-4">
                            <div class="text-left">
                                <button type="button" class="btn btn-danger" @onclick="IrCompetencia">Competencia</button>
                                <button type="button" class="btn btn-facebook" disabled>Performance</button>
                                <button type="button" class="btn btn-info" @onclick="IrFinalizacao">Ir para Finalização</button>
                            </div>
                        </div>
                        <div class="col-sm">
                            <div class="row">
                                <div class="col-md-1"><label><b>Avaliado</b></label></div>
                                <div class="col-md-3"><label>@ModelDados?.AssociadoNome</label></div>
                                <div class="col-md-1"><label><b>Período</b></label></div>
                                <div class="col-md-3"><label>@ModelDados?.Periodo</label></div>
                                <div class="col-md-1"><label><b>Gestor</b></label></div>
                                <div class="col-md-3"><label>@ModelDados?.GestorNome</label></div>
                            </div>
                            <div class="row">
                                <div class="col-md-1"><label><b>Cargo</b></label></div>
                                <div class="col-md-3"><label>@ModelDados?.Cargo</label></div>
                                <div class="col-md-1"><label><b>Tempo de Cargo:</b></label></div>
                                <div class="col-md-3"><label>@ModelDados?.TempoCargo</label></div>
                                <div class="col-md-1"><label><b>Tempo de Peers</b></label></div>
                                <div class="col-md-3"><label>@ModelDados?.TempoPeers</label></div>
                            </div>
                            <div class="row">
                                <div class="col-md-1"><label><b>Projeto</b></label></div>
                                <div class="col-md-3"><label>@ModelDados?.Projeto</label></div>
                                <div class="col-md-1"><label><b>Cliente</b></label></div>
                                <div class="col-md-3"><label>@ModelDados?.Cliente</label></div>
                                <div class="col-md-2"><label><b>Tempo restante</b></label></div>
                                <div class="col-md-2"><label>@ModelDados?.TempoRestante</label></div>
                            </div>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <div class="card">
        <div class="card-body">
            <div class="form-body">
                <div class="row">
                    <div class="col-md-4 offset-md-8">
                        <div class="text-right">
                            <button type="button" class="btn btn-dark" @onclick="SalvarAvaliacao" disabled="@(IsTudoFinalizado)">Salvar Avaliação</button>
                        </div>
                    </div>
                </div>
            </div>
            <br />
            <div class="table-responsive">
                <table class="table table-striped border">
                    <thead>
                        <tr>
                            <th>Performance</th>
                            <th>Abaixo</th>
                            <th>Esperado</th>
                            <th>Acima</th>
                            <th>Nota Avaliado</th>
                            <th>Nota às Cegas</th>
                            <th>Nota Gestor</th>
                            <th>Observações</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (ListaPerformances is not null)
                        {
                            string abrangenciaAtual = null;
                            foreach (var item in ListaPerformances)
                            {
                                if (item.SeparadorAbrangencia == "")
                                {
                                    <tr>
                                        <td colspan="8" style="text-align:center;font-size:16px">@item.Abrangencia</td>
                                    </tr>
                                }
                                <tr>
                                    <td>
                                        <input type="hidden" value="@item.IdPerformance" />
                                        @item.Descricao<br />
                                        @if (!string.IsNullOrEmpty(item.DisclaimerInput))
                                        {
                                            <label style="font-size:13px;font-weight:normal;font-style:italic;color:darkred">@item.DisclaimerInput</label>
                                        }
                                    </td>
                                    <td>
                                        <a href="#abaixo_@item.IdPerformance" data-bs-toggle="collapse" class="accordion-toggle">
                                            @AvaliacoesGestorHelper.TruncaTexto(item.Abaixo, 45)
                                            <span style="font-weight:bold">  Ver+</span>
                                        </a>
                                    </td>
                                    <td>
                                        <a href="#esperado_@item.IdPerformance" data-bs-toggle="collapse" class="accordion-toggle">
                                            @AvaliacoesGestorHelper.TruncaTexto(item.Esperado, 45)
                                            <span style="font-weight:bold">  Ver+</span>
                                        </a>
                                    </td>
                                    <td>
                                        <a href="#acima_@item.IdPerformance" data-bs-toggle="collapse" class="accordion-toggle">
                                            @AvaliacoesGestorHelper.TruncaTexto(item.Acima, 45)
                                            <span style="font-weight:bold">  Ver+</span>
                                        </a>
                                    </td>
                                    <td>@item.NotaAvaliado</td>
                                    <td>@item.NotaCegas</td>
                                    <td style="width: 120px;">
                                        <select class="form-control p-0 select2" style="width: 100%" @bind="item.NotaGestor" @onchange="(e) => OnNotaGestorChange(item, e)">
                                            @foreach (var nota in ComboNotas)
                                            {
                                                <option value="@nota.Value" selected="@(item.NotaGestor == nota.Value)">@nota.Text</option>
                                            }
                                        </select>
                                    </td>
                                    <td class="text-center">
                                        <button type="button" data-bs-toggle="collapse" data-bs-target="#obs_@item.IdPerformance" class="accordion-toggle" style="background-color:#003150;padding:8px 15px;border:none">
                                            <span aria-hidden="true" style="color:white;font-size:15px">Considerações</span>
                                        </button>
                                    </td>
                                </tr>
                                <tr>
                                    <td colspan="8" class="hiddenRow">
                                        <div class="accordian-body collapse" id="abaixo_@item.IdPerformance">[Abaixo] @item.Abaixo</div>
                                    </td>
                                </tr>
                                <tr>
                                    <td colspan="8" class="hiddenRow">
                                        <div class="accordian-body collapse" id="esperado_@item.IdPerformance">[Esperado] @item.Esperado</div>
                                    </td>
                                </tr>
                                <tr>
                                    <td colspan="8" class="hiddenRow">
                                        <div class="accordian-body collapse" id="acima_@item.IdPerformance">[Acima] @item.Acima</div>
                                    </td>
                                </tr>
                                <tr>
                                    <td colspan="8" class="hiddenRow">
                                        <div class="accordian-body collapse" id="obs_@item.IdPerformance">
                                            <p>
                                                <strong>Observações do Avaliado:</strong><br />
                                                @item.ObservacaoAvaliado
                                            </p>
                                            <p>
                                                <strong>Observações às Cegas:</strong><br />
                                                @item.ObservacaoCegas
                                            </p>
                                            <p>
                                                <strong>Considerações do Gestor:</strong><br />
                                                <textarea rows="5" class="form-control" @bind="item.ObservacaoGestor"></textarea>
                                            </p>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
            <div class="form-body">
                <div class="row">
                    <div class="col-md-4 offset-md-8">
                        <div class="text-right">
                            <button type="button" class="btn btn-dark" @onclick="SalvarAvaliacao" disabled="@(IsTudoFinalizado)">Salvar Avaliação</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-body">
            <div class="col-md-5">
                <div class="text-left">
                    <button type="button" class="btn btn-danger" @onclick="IrCompetencia">Competencia</button>
                    <button type="button" class="btn btn-facebook" disabled>Performance</button>
                    <button type="button" class="btn btn-info" @onclick="IrFinalizacao">Ir para Finalização</button>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .hiddenRow {
        padding: 0 !important;
    }
</style>
