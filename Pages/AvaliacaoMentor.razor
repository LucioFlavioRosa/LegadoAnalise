@page "/avaliacao-mentor"
@rendermode InteractiveAuto
@inject IMentoriaService MentoriaService
@inject IMentoriaHelper MentoriaHelper

<PageTitle>Avaliação Mentor</PageTitle>

<div class="page-breadcrumb border-bottom">
    <div class="row">
        <div class="col-lg-3 col-md-4 col-xs-12 align-self-center">
            <h5 class="font-medium text-uppercase mb-0">Mentor</h5>
        </div>
        <div class="col-lg-9 col-md-8 col-xs-12 align-self-center">
            <nav aria-label="breadcrumb" class="mt-2 float-md-right float-left">
                <ol class="breadcrumb mb-0 justify-content-end p-0">
                    <li class="breadcrumb-item"><a href="/">Peers</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Avaliação / Mentor</li>
                </ol>
            </nav>
        </div>
    </div>
</div>

<div class="page-content container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-body">
                    <h4 class="card-title">Filtro avaliações</h4>
                    <EditForm Model="@Filtro" OnValidSubmit="OnFiltrar">
                        <div class="form-body">
                            <div class="row">
                                <div class="col-md-3">
                                    <InputSelect class="form-control p-0 select2" style="width: 100%" @bind-Value="Filtro.IdProjeto">
                                        @foreach (var projeto in ProjetosCombo)
                                        {
                                            <option value="@projeto.Value">@projeto.Text</option>
                                        }
                                    </InputSelect>
                                    <label>Projeto</label>
                                </div>
                                <div class="col-md-3">
                                    <InputSelect class="form-control p-0 select2" style="width: 100%" @bind-Value="Filtro.IdCliente">
                                        @foreach (var cliente in ClientesCombo)
                                        {
                                            <option value="@cliente.Value">@cliente.Text</option>
                                        }
                                    </InputSelect>
                                    <label>Cliente</label>
                                </div>
                                <div class="col-md-2">
                                    <InputSelect class="form-control p-0 select2" style="width: 100%" @bind-Value="Filtro.IdPeriodo">
                                        @foreach (var periodo in PeriodosCombo)
                                        {
                                            <option value="@periodo.Value">@periodo.Text</option>
                                        }
                                    </InputSelect>
                                    <label>Período</label>
                                </div>
                                <div class="col-md-2">
                                    <InputSelect class="form-control p-0 select2" style="width: 100%" @bind-Value="Filtro.IdStatus">
                                        @foreach (var status in StatusCombo)
                                        {
                                            <option value="@status.Value">@status.Text</option>
                                        }
                                    </InputSelect>
                                    <label>Status</label>
                                </div>
                                <div class="col-md-2">
                                    <button type="submit" class="btn btn-danger" style="margin-top: 30px">Filtrar</button>
                                </div>
                            </div>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>

        <div class="col-12">
            <div class="card">
                <div class="card-body">
                    <h4 class="card-title">Mentorados do período atual</h4>
                    <div class="table-responsive">
                        <table class="table table-striped border dtInit">
                            <thead>
                                <tr>
                                    <th></th>
                                    <th>Mentorado</th>
                                    <th>Cargo</th>
                                    <th>Mentoria realizada</th>
                                    <th>Dados do RH disponíveis</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var mentorado in Mentorados)
                                {
                                    <tr>
                                        <td><img src="@mentorado.FotoNome" width="120" height="120" /></td>
                                        <td>@mentorado.Associado</td>
                                        <td>@mentorado.Cargo</td>
                                        <td>@MentoriaHelper.GetMentoriaRealizadaText(mentorado)</td>
                                        <td>@MentoriaHelper.GetDadosRHDisponiveisText(mentorado)</td>
                                        <td style="width:170px; text-align:center;align-content:center;vertical-align:central;align-items:center">
                                            <a href="/avaliacao-mentor-competencia?IdProjeto=@mentorado.idProjeto&IdAssociado=@mentorado.idAssociado&IdPeriodo=@mentorado.idPeriodo&TipoAvaliacao=@mentorado.TipoAvaliacao&Escopo=@mentorado.Escopo&idGestor=@mentorado.idGestor&Exibir=Tudo">
                                                <button type="button" class="btn btn-info">Mentoria</button>
                                            </a>
                                            <a href="/avaliacao-mentor-competencia?IdProjeto=@mentorado.idProjeto&IdAssociado=@mentorado.idAssociado&IdPeriodo=@mentorado.idPeriodo&TipoAvaliacao=@mentorado.TipoAvaliacao&Escopo=@mentorado.Escopo&idGestor=@mentorado.idGestor&Exibir=FeedbackRH">
                                                <button type="button" class="btn btn-facebook" @(MentoriaHelper.GetFeedbackRHVisibleAttr(mentorado))>Feedback RH</button>
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12">
            <div class="card">
                <div class="card-body">
                    <h4 class="card-title">Avaliações de seus mentorados</h4>
                    <div class="table-responsive">
                        <table class="table table-striped border dtInit">
                            <thead>
                                <tr>
                                    <th>Código</th>
                                    <th>Projeto</th>
                                    <th>Cliente</th>
                                    <th>Status(Ativo/Inativo)</th>
                                    <th>Início</th>
                                    <th>Término</th>
                                    <th>Responsável</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var projeto in ProjetosAvaliacoes)
                                {
                                    <tr>
                                        <td>@projeto.Id</td>
                                        <td>@projeto.Nome</td>
                                        <td>@projeto.Cliente?.Nome</td>
                                        <td>@projeto.Status?.Status</td>
                                        <td>@projeto.DataInicio</td>
                                        <td>@projeto.DataTermino</td>
                                        <td>@projeto.Responsavel?.Nome</td>
                                    </tr>
                                    <tr>
                                        <td>&nbsp;</td>
                                        <td colspan="6">
                                            @if (projeto.Associados != null && projeto.Associados.Count > 0)
                                            {
                                                <table class="table table-striped border dtInit">
                                                    <thead>
                                                        <tr>
                                                            <th>Foto</th>
                                                            <th>Profissional</th>
                                                            <th>Cargo</th>
                                                            <th>Período</th>
                                                            <th>Dt. Início Projeto</th>
                                                            <th>Dt. Término Projeto</th>
                                                            <th>Gestor</th>
                                                            <th>Avaliador</th>
                                                            <th>Mentor</th>
                                                            <th>Etapa</th>
                                                            <th></th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        @foreach (var associado in projeto.Associados)
                                                        {
                                                            <tr>
                                                                <td><img src="@associado.Associado.FotoNome" width="120" height="120" /></td>
                                                                <td>@associado.Associado.Nome</td>
                                                                <td>@associado.Associado.CARGOS?.Cargo</td>
                                                                <td>@associado.Periodo?.Periodo</td>
                                                                <td>@associado.DataInicio</td>
                                                                <td>@associado.DataTermino</td>
                                                                <td>@associado.Gestor?.Nome</td>
                                                                <td>@associado.Avaliador?.Nome</td>
                                                                <td>@associado.Associado.ASSOCIADOS3?.Nome</td>
                                                                <td>@associado.Etapa</td>
                                                                <td style="width:170px; text-align:right;align-content:center">
                                                                    <a href="/avaliacao-mentor-competencia?IdProjeto=@associado.Projeto.IdProjeto&IdAssociado=@associado.Associado.IdAssociado&IdPeriodo=@associado.Periodo.IdPeriodo&TipoAvaliacao=@associado.TipoAvaliacao&Escopo=@associado.Escopo&idGestor=@associado.Gestor.IdAssociado&Exibir=Tudo">
                                                                        <button type="button" class="btn btn-info" @(MentoriaHelper.GetExibirBotaoVerMentorAttr(associado))>Ver Avaliação</button>
                                                                    </a>
                                                                    <a href="/avaliacao-mentor-competencia?IdProjeto=@associado.Projeto.IdProjeto&IdAssociado=@associado.Associado.IdAssociado&IdPeriodo=@associado.Periodo.IdPeriodo&TipoAvaliacao=@associado.TipoAvaliacao&Escopo=@associado.Escopo&idGestor=@associado.Gestor.IdAssociado&Exibir=FeedbackRH">
                                                                        <button type="button" class="btn btn-facebook" @(MentoriaHelper.GetFeedbackRHVisibleAttr(associado))>FeedbackRH</button>
                                                                    </a>
                                                                </td>
                                                            </tr>
                                                        }
                                                    </tbody>
                                                </table>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
