@page "/radar"
@rendermode InteractiveAuto

@inject Services.Radar.RadarService RadarService
@inject Services.Common.ComboHelper ComboHelper
@inject Services.Common.ChartJsInteropService ChartJsInteropService
@inject Services.Common.FormatHelper FormatHelper
@inject NavigationManager NavigationManager

<PageTitle>Radar das Avaliações</PageTitle>

<div class="page-breadcrumb border-bottom">
    <div class="row">
        <div class="col-lg-3 col-md-4 col-xs-12 align-self-center">
            <h5 class="font-medium text-uppercase mb-0">Radar das Avaliações</h5>
        </div>
        <div class="col-lg-9 col-md-8 col-xs-12 align-self-center">
            <nav aria-label="breadcrumb" class="mt-2 float-md-right float-left">
                <ol class="breadcrumb mb-0 justify-content-end p-0">
                    <li class="breadcrumb-item"><a href="/">Peers</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Radar das Avaliações</li>
                </ol>
            </nav>
        </div>
    </div>
</div>

<div class="page-content container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-body">
                    <h4 class="card-title">Filtros</h4>
                    <div class="form-body">
                        <div class="row">
                            <div class="col-md-3">
                                <div class="form-group">
                                    <label>Período</label>
                                    <select class="form-control p-0 select2" style="width: 100%" @bind="SelectedPeriodoId" @onchange="OnPeriodoChanged">
                                        @foreach (var periodo in Periodos)
                                        {
                                            <option value="@periodo.Value">@periodo.Text</option>
                                        }
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="form-group">
                                    <label>Projeto</label>
                                    <select class="form-control p-0 select2" style="width: 100%" @bind="SelectedProjetoId" @onchange="OnProjetoChanged">
                                        @foreach (var projeto in Projetos)
                                        {
                                            <option value="@projeto.Value">@projeto.Text</option>
                                        }
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="form-group">
                                    <label>Associado</label>
                                    <select class="form-control p-0 select2" style="width: 100%" @bind="SelectedAssociadoId">
                                        @foreach (var associado in Associados)
                                        {
                                            <option value="@associado.Value">@associado.Text</option>
                                        }
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="form-group">
                                    <label>Tipo de Avaliação</label>
                                    <select class="form-control p-0 select2" style="width: 100%" @bind="SelectedTipo">
                                        @foreach (var tipo in TiposAvaliacao)
                                        {
                                            <option value="@tipo.Value">@tipo.Text</option>
                                        }
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="form-group">
                                    <label>Escopo</label>
                                    <select class="form-control p-0 select2" style="width: 100%" @bind="SelectedEscopo">
                                        @foreach (var escopo in Escopos)
                                        {
                                            <option value="@escopo.Value">@escopo.Text</option>
                                        }
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-1">
                                <div class="form-actions">
                                    <label>&nbsp;</label>
                                    <div>
                                        <button class="btn btn-info" @onclick="ExibirRadar">Exibir Radar</button>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-2">
                                <div class="form-group">
                                    <input type="checkbox" id="chkRotulo" @bind="ShowRotulo" />
                                    <label for="chkRotulo">Rótulos</label>
                                </div>
                                <div class="form-group">
                                    <input type="checkbox" id="chkBackground" @bind="ShowBackground" />
                                    <label for="chkBackground">Fundo Colorido</label>
                                </div>
                            </div>
                        </div>
                        @if (!string.IsNullOrEmpty(Message))
                        {
                            <div class="alert alert-info mt-2">@Message</div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="card" style="width: 100%; text-align: center;">
        <div class="card-body">
            <canvas id="radarChart" width="1200" height="600"></canvas>
        </div>
    </div>
</div>

@code {
    private List<Services.Common.ComboItem> Periodos = new();
    private List<Services.Common.ComboItem> Projetos = new();
    private List<Services.Common.ComboItem> Associados = new();
    private List<Services.Common.ComboItem> TiposAvaliacao = new();
    private List<Services.Common.ComboItem> Escopos = new();

    private string SelectedPeriodoId = "";
    private string SelectedProjetoId = "";
    private string SelectedAssociadoId = "";
    private string SelectedTipo = "";
    private string SelectedEscopo = "";
    private bool ShowRotulo = true;
    private bool ShowBackground = false;
    private string Message = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        Periodos = await ComboHelper.GetPeriodosComboAsync();
        TiposAvaliacao = Services.Common.ComboHelper.GetTiposAvaliacaoItems();
        Escopos = Services.Common.ComboHelper.GetEscoposItems();
        Projetos = new List<Services.Common.ComboItem> { new Services.Common.ComboItem { Value = "", Text = "[Selecionar]" } };
        Associados = new List<Services.Common.ComboItem> { new Services.Common.ComboItem { Value = "", Text = "[Selecionar]" } };
    }

    private async Task OnPeriodoChanged(ChangeEventArgs e)
    {
        SelectedPeriodoId = e.Value?.ToString() ?? "";
        if (!string.IsNullOrEmpty(SelectedPeriodoId))
        {
            Projetos = await ComboHelper.GetProjetosComboAsync(periodoId: int.Parse(SelectedPeriodoId));
        }
        else
        {
            Projetos = new List<Services.Common.ComboItem> { new Services.Common.ComboItem { Value = "", Text = "[Selecionar]" } };
        }
        SelectedProjetoId = "";
        Associados = new List<Services.Common.ComboItem> { new Services.Common.ComboItem { Value = "", Text = "[Selecionar]" } };
        SelectedAssociadoId = "";
        StateHasChanged();
    }

    private async Task OnProjetoChanged(ChangeEventArgs e)
    {
        SelectedProjetoId = e.Value?.ToString() ?? "";
        if (!string.IsNullOrEmpty(SelectedProjetoId))
        {
            Associados = await ComboHelper.GetProfissionaisComboAsync(projetoId: int.Parse(SelectedProjetoId));
        }
        else
        {
            Associados = new List<Services.Common.ComboItem> { new Services.Common.ComboItem { Value = "", Text = "[Selecionar]" } };
        }
        SelectedAssociadoId = "";
        StateHasChanged();
    }

    private async Task ExibirRadar()
    {
        Message = string.Empty;
        if (string.IsNullOrEmpty(SelectedPeriodoId) || string.IsNullOrEmpty(SelectedProjetoId) || string.IsNullOrEmpty(SelectedAssociadoId) || string.IsNullOrEmpty(SelectedTipo) || string.IsNullOrEmpty(SelectedEscopo))
        {
            Message = "Selecione Todos os Filtros para Gerar o Gráfico";
            await ChartJsInteropService.DestroyChartAsync("radarChart");
            return;
        }
        var radarData = await RadarService.GetRadarData(int.Parse(SelectedAssociadoId), int.Parse(SelectedProjetoId), int.Parse(SelectedPeriodoId), SelectedTipo, SelectedEscopo, ShowRotulo, ShowBackground);
        if (!radarData.Success)
        {
            Message = radarData.Message;
            await ChartJsInteropService.DestroyChartAsync("radarChart");
            return;
        }
        await ChartJsInteropService.RenderRadarChartAsync("radarChart", radarData.ChartData);
    }
}
