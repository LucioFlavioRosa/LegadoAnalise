@page "/resultado-lideranca"
@rendermode InteractiveAuto

@using Services.ResultadoLideranca
@using Services.ResultadoLideranca.Common
@using Services.Common
@using Peers.Moderno.Services.Common
@inject IResultadoLiderancaService ResultadoLiderancaService
@inject IMessageBoxService MessageBoxService
@inject ComboHelper ComboHelper
@inject FormatHelper FormatHelper

<PageTitle>Resultado das Avaliações de Liderança</PageTitle>

<div class="container-fluid">
    <MessageBox />
    <div class="card card-body form-body">
        <h4>Resultado das avaliações de liderança</h4>
        <div class="row">
            <div class="col-sm">
                <label>Líder: </label>
                <select class="form-control" @onchange="OnLiderChanged" @bind="filtro.IdLider">
                    @foreach (var item in comboLideres)
                    {
                        <option value="@item.Value">@item.Text</option>
                    }
                </select>
            </div>
            <div class="col-sm">
                <label>Ciclo: </label>
                <select class="form-control" @onchange="OnCicloChanged" @bind="filtro.IdCiclo">
                    @foreach (var item in comboCiclos)
                    {
                        <option value="@item.Value">@item.Text</option>
                    }
                </select>
            </div>
        </div>
        <br />
        <div class="row">
            @if (exibirNotificarLideres)
            {
                <button class="btn btn-danger" @onclick="NotificarLideres">Notificar Líderes</button>
            }
        </div>
        <h6>Ao carregar a página ou mudar os filtros, aguarde os painéis atualizarem.</h6>
    </div>
    <div class="card card-body form-body">
        @if (resultados != null && resultados.Any())
        {
            <div style="display:flex;flex-direction:row;align-items: flex-start;justify-content: space-evenly;">
                @foreach (var resultado in resultados)
                {
                    <div style="display:flex;flex-direction:column;align-items: center;gap: 40px">
                        <div style="display:flex;flex-direction:column;align-items: flex-start;min-height:180px;align-self:center">
                            <h1 style="text-align:center; align-self:center">@resultado.Ciclo</h1>
                            <h3 style="text-align:center; align-self:center">PROJETOS AVALIADOS</h3>
                            <div style="display:flex;flex-direction:column;">
                                @foreach (var projeto in resultado.Projetos)
                                {
                                    <li style="font-size:1.1em">@projeto.Projeto</li>
                                }
                            </div>
                        </div>
                        <div class="container-graph">
                            <h3 style="text-align:center; align-self:center">TOTAL</h3>
                            <Chart ChartId=$"graficoNotaTotal_{resultado.Index}" Type="bar" Data="@resultado.GraficoNotaTotal" />
                            <br />
                        </div>
                        <div class="container-graph">
                            <h3 style="text-align:center; align-self:center">PILARES</h3>
                            <Chart ChartId=$"graficoNotaPilares_{resultado.Index}" Type="bar" Data="@resultado.GraficoNotaPilares" />
                            <br />
                        </div>
                        <div class="container-graph">
                            <h3 style="text-align:center; align-self:center">SUBCOMPETÊNCIAS</h3>
                            <Chart ChartId=$"graficoNotaSubcompetencias_{resultado.Index}" Type="radar" Data="@resultado.GraficoNotaSubcompetencias" />
                            <br />
                        </div>
                        <div style="display:flex;flex-direction:row;width:100%;justify-content:center;min-height:550px">
                            <div style="display:flex;flex-direction:row;width:90%;justify-content:space-around">
                                <div style="display:flex;flex-direction:column;width:40%;gap:1px">
                                    <h3 style="text-align:center">Maiores notas</h3>
                                    @foreach (var delta in resultado.DeltaMaior)
                                    {
                                        <div style="width:100%;height:50px;background-color:#021240;color:white;border-radius:4px;text-align:center">
                                            <label>@delta.Subcompetencia</label>
                                            <br />
                                            <label>@FormatHelper.FormatDecimalNullable(delta.Resultado)</label>
                                        </div>
                                    }
                                </div>
                                <div style="display:flex;flex-direction:column;width:40%;gap:1px">
                                    <h3 style="text-align:center">Menores notas</h3>
                                    @foreach (var delta in resultado.DeltaMenor)
                                    {
                                        <div style="width:100%;height:50px;background-color:#E5F419;color:#021240;border-radius:4px;text-align:center">
                                            <label>@delta.Subcompetencia</label>
                                            <br />
                                            <label>@FormatHelper.FormatDecimalNullable(delta.Resultado)</label>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                        <div>
                            <h3 style="text-align:center; align-self:center">COMENTÁRIOS</h3>
                            <ul class="listaCloud">
                                @foreach (var palavra in resultado.Palavras)
                                {
                                    <li><a data-weight="@palavra.DataWeight"> @palavra.Palavra </a></li>
                                }
                            </ul>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="alert alert-info">Nenhum resultado encontrado para os filtros selecionados.</div>
        }
    </div>
</div>

@code {
    private List<ComboItem> comboLideres = new();
    private List<ComboItem> comboCiclos = new();
    private bool exibirNotificarLideres = false;
    private ResultadoLiderancaFiltro filtro = new();
    private List<ResultadoLiderancaViewModel> resultados = new();

    protected override async Task OnInitializedAsync()
    {
        await CarregarCombosAsync();
        await CarregarResultadosAsync();
    }

    private async Task CarregarCombosAsync()
    {
        comboLideres = await ResultadoLiderancaService.GetComboLideresAsync();
        comboCiclos = await ResultadoLiderancaService.GetComboCiclosAsync(filtro.IdLider);
        exibirNotificarLideres = await ResultadoLiderancaService.PodeNotificarLideresAsync();
        if (comboLideres.Any())
            filtro.IdLider = comboLideres.First().Value;
        if (comboCiclos.Any())
            filtro.IdCiclo = comboCiclos.First().Value;
    }

    private async Task CarregarResultadosAsync()
    {
        resultados = await ResultadoLiderancaService.GetResultadosAsync(filtro);
        StateHasChanged();
    }

    private async Task OnLiderChanged(ChangeEventArgs e)
    {
        filtro.IdLider = e.Value?.ToString();
        comboCiclos = await ResultadoLiderancaService.GetComboCiclosAsync(filtro.IdLider);
        if (comboCiclos.Any())
            filtro.IdCiclo = comboCiclos.First().Value;
        await CarregarResultadosAsync();
    }

    private async Task OnCicloChanged(ChangeEventArgs e)
    {
        filtro.IdCiclo = e.Value?.ToString();
        await CarregarResultadosAsync();
    }

    private async Task NotificarLideres()
    {
        var sucesso = await ResultadoLiderancaService.NotificarLideresAsync();
        if (sucesso)
        {
            MessageBoxService.ShowSuccess("Emails disparados aos líderes com sucesso.", "Sucesso");
        }
        else
        {
            MessageBoxService.ShowError("Falha ao enviar e-mail de notificação!", "Notificação");
        }
    }
}

<style>
.listaCloud{
    list-style: none;
    padding-left: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    line-height: 3.3rem;
    width: 650px;
}
.listaCloud a[data-weight="1"] { --size: 1; }
.listaCloud a[data-weight="2"] { --size: 1; }
.listaCloud a[data-weight="3"] { --size: 2; }
.listaCloud a[data-weight="4"] { --size: 3; }
.listaCloud a[data-weight="5"] { --size: 4; }
.listaCloud a[data-weight="6"] { --size: 5; }
.listaCloud a[data-weight="7"] { --size: 6; }
.listaCloud a[data-weight="8"] { --size: 7; }
.listaCloud a[data-weight="9"] { --size: 8; }
.listaCloud a[data-weight="10"] { --size: 9; }
.listaCloud a[data-weight="11"] { --size: 10; }
.listaCloud a[data-weight="12"] { --size: 11; }
.listaCloud a{
    display: block;
    padding: 0.125rem 0.25rem;
    text-decoration: none;
    position: relative;
    --size: 4;
    font-size: calc(var(--size) * 0.70rem + 0.5rem);
    font-weight: calc(var(--size) * 83);
}
.container-graph {
    width: 100%;
}
</style>
