@page "/workflowdeprojetos"
@rendermode InteractiveAuto

@inject Services.Workflow.IWorkflowService WorkflowService
@inject Services.Workflow.IWorkflowComboHelper WorkflowComboHelper
@inject Services.Common.IMessageBoxService MessageBoxService

<PageTitle>Workflow de Projetos</PageTitle>

<div class="page-breadcrumb border-bottom">
    <div class="row">
        <div class="col-lg-3 col-md-4 col-xs-12 align-self-center">
            <h5 class="font-medium text-uppercase mb-0">Workflow de Projetos</h5>
        </div>
        <div class="col-lg-9 col-md-8 col-xs-12 align-self-center">
            <nav aria-label="breadcrumb" class="mt-2 float-md-right float-left">
                <ol class="breadcrumb mb-0 justify-content-end p-0">
                    <li class="breadcrumb-item"><a href="/">Peers</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Workflow de Projetos</li>
                </ol>
            </nav>
        </div>
    </div>
</div>

<div class="page-content container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-body">
                    <h4 class="card-title">Prazo das Avaliações (em dias)</h4>
                    <EditForm Model="@this" OnValidSubmit="SalvarWorkflow">
                        <div class="form-body">
                            <div class="row">
                                <div class="col-md-2">
                                    <div class="form-group">
                                        <label>Período</label>
                                        <InputSelect class="form-control p-0 select2" style="width: 100%" @bind-Value="PeriodoSelecionadoId">
                                            <option value="">[Selecionar]</option>
                                            @foreach (var periodo in Periodos)
                                            {
                                                <option value="@periodo.Value">@periodo.Text</option>
                                            }
                                        </InputSelect>
                                    </div>
                                </div>
                                <div class="col-md-2">
                                    <div class="form-group">
                                        <label>Data de Início</label>
                                        <InputDate class="form-control" @bind-Value="DataInicio" />
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-2">
                                    <div class="form-group">
                                        <label>Auto-Avaliação</label>
                                        <InputNumber class="form-control text-center" @bind-Value="DiasAutoAvaliacao" />
                                    </div>
                                </div>
                                <div class="col-md-2">
                                    <div class="form-group">
                                        <label>Avaliação às Cegas</label>
                                        <InputNumber class="form-control text-center" @bind-Value="DiasAvaliacaoCegas" />
                                    </div>
                                </div>
                                <div class="col-md-2">
                                    <div class="form-group">
                                        <label>Avaliação do Gestor</label>
                                        <InputNumber class="form-control text-center" @bind-Value="DiasAvaliacaoGestor" />
                                    </div>
                                </div>
                                <div class="col-md-2">
                                    <div class="form-group">
                                        <label>Feedback</label>
                                        <InputNumber class="form-control text-center" @bind-Value="DiasFeedback" />
                                    </div>
                                </div>
                                <div class="col-md-2">
                                    <div class="form-group">
                                        <label>Alerta Sem Alteração</label>
                                        <InputNumber class="form-control text-center" @bind-Value="DiasAlertaSemAlteracao" />
                                    </div>
                                </div>
                                <div class="col-md-2">
                                    <div class="form-actions">
                                        <button type="submit" class="btn btn-info">@((WorkflowEditId == 0) ? "Cadastrar" : "Salvar")</button>
                                        @if (WorkflowEditId != 0)
                                        {
                                            <button type="button" class="btn btn-secondary ml-2" @onclick="LimparCampos">Cancelar</button>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-body">
            <h4 style="float: left;" class="card-title">Configurações do Workflow</h4>
            <br />
            <br />
            <div class="table-responsive">
                <table class="table table-striped border dtInit">
                    <thead>
                        <tr>
                            <th>Período</th>
                            <th>Data Início</th>
                            <th>Auto-Avaliação</th>
                            <th>Avaliação Às Cegas</th>
                            <th>Avaliação do Gestor</th>
                            <th>Avaliação Feedback</th>
                            <th>Alerta Sem Alteração</th>
                            <th>Ação</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Workflows != null && Workflows.Count > 0)
                        {
                            @foreach (var wf in Workflows)
                            {
                                <tr>
                                    <td>@wf.PeriodoNome</td>
                                    <td>@wf.DataInicio.ToString("dd/MM/yyyy")</td>
                                    <td>@wf.DiasAutoAvaliacao</td>
                                    <td>@wf.DiasAvaliacaoCegas</td>
                                    <td>@wf.DiasAvaliacaoGestor</td>
                                    <td>@wf.DiasFeedback</td>
                                    <td>@wf.DiasAlertaSemAlteracao</td>
                                    <td>
                                        <button class="btn btn-info btn-outline btn-circle btn-lg m-r-5" title="Alterar" @onclick="() => EditarWorkflow(wf)"><i class="ti-pencil-alt"></i></button>
                                        <button class="btn btn-dark btn-outline btn-circle btn-lg m-r-5" title="Deletar" @onclick="() => DeletarWorkflow(wf.IdWorkflow)"><i class="ti-trash"></i></button>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr><td colspan="8" class="text-center">Nenhum workflow cadastrado.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
