@page "/"
@rendermode InteractiveAuto

<PageTitle>Home - Sistema de Avaliação</PageTitle>

<MudText Typo="Typo.h3" GutterBottom="true">Bem-vindo ao Sistema de Avaliação Moderno</MudText>
<MudText Typo="Typo.body1">
    Sistema migrado para Blazor .NET 9 com arquitetura moderna e responsiva.
</MudText>

<MudGrid Class="mt-4">
    <MudItem xs="12" sm="6" md="4">
        <MudCard>
            <MudCardContent>
                <MudText Typo="Typo.h5">Associados</MudText>
                <MudText Typo="Typo.body2">Gerencie cadastros de associados, promoções e fotos</MudText>
            </MudCardContent>
            <MudCardActions>
                <MudButton Variant="Variant.Text" Color="Color.Primary" Href="/associados">Acessar</MudButton>
            </MudCardActions>
        </MudCard>
    </MudItem>
</MudGrid>