@using Peers.Moderno.Services.Common
@inject IPasswordService PasswordService
@inject IUserContextService UserContextService
@inject IMessageBoxService MessageBoxService
@inject NavigationManager Navigation

<div class="card">
    <h4 class="modal-title" style="text-align:center">Sua senha foi reiniciada</h4>
    <h4 class="modal-title" style="text-align:center">Altere-a antes de continuar utilizando o portal</h4>
    
    <EditForm Model="@passwordModel" OnValidSubmit="@HandlePasswordChange">
        <div class="form-body">
            <div class="row">
                <div class="col-md-2"></div>
                <div class="col-md-8">
                    <div class="input-group mb-3">
                        <div class="input-group-prepend">
                            <span class="input-group-text"><i class="ti-lock"></i></span>
                        </div>
                        <InputText @bind-Value="passwordModel.NewPassword" type="password" class="form-control form-control-lg" placeholder="Nova Senha" />
                    </div>
                </div>
                <div class="col-md-2"></div>
            </div>
            <div class="row">
                <div class="col-md-2"></div>
                <div class="col-md-8">
                    <div class="input-group mb-3">
                        <div class="input-group-prepend">
                            <span class="input-group-text"><i class="ti-check"></i></span>
                        </div>
                        <InputText @bind-Value="passwordModel.ConfirmPassword" type="password" class="form-control form-control-lg" placeholder="Confirme a Senha" />
                    </div>
                </div>
                <div class="col-md-2"></div>
            </div>
        </div>
        <div class="modal-footer" style="place-content:center">
            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="text-left">
                    <span class="text-danger">@errorMessage</span>
                </div>
            }
            <button type="submit" class="btn btn-danger" disabled="@isProcessing">
                @if (isProcessing)
                {
                    <span class="spinner-border spinner-border-sm" role="status"></span>
                    <span>Alterando...</span>
                }
                else
                {
                    <span>Alterar</span>
                }
            </button>
        </div>
    </EditForm>
</div>

@code {
    [Parameter] public EventCallback OnPasswordChanged { get; set; }
    
    private PasswordChangeModel passwordModel = new();
    private string errorMessage = string.Empty;
    private bool isProcessing = false;

    private async Task HandlePasswordChange()
    {
        try
        {
            isProcessing = true;
            errorMessage = string.Empty;
            
            var currentUser = await UserContextService.GetUsuarioLogadoAsync();
            if (currentUser == null)
            {
                errorMessage = "Usuário não encontrado";
                return;
            }

            var validationResult = await PasswordService.ValidatePasswordAsync(
                passwordModel.NewPassword, 
                passwordModel.ConfirmPassword);

            if (!validationResult.IsValid)
            {
                errorMessage = validationResult.ErrorMessage;
                return;
            }

            var changeResult = await PasswordService.ChangePasswordAsync(
                currentUser.Id, 
                passwordModel.NewPassword);

            if (changeResult.IsSuccess)
            {
                MessageBoxService.ShowSuccess("Senha alterada com sucesso!");
                await OnPasswordChanged.InvokeAsync();
                Navigation.NavigateTo("/", true);
            }
            else
            {
                errorMessage = changeResult.ErrorMessage;
            }
        }
        catch (Exception ex)
        {
            errorMessage = "Erro interno ao alterar senha";
        }
        finally
        {
            isProcessing = false;
        }
    }

    private class PasswordChangeModel
    {
        public string NewPassword { get; set; } = string.Empty;
        public string ConfirmPassword { get; set; } = string.Empty;
    }
}