@inject IPasswordService PasswordService
@inject IMessageBoxService MessageBoxService
@inject IUserContextService UserContextService

<div class="card">
    <h4 class="modal-title" style="text-align:center">Sua senha foi reiniciada</h4>
    <h4 class="modal-title" style="text-align:center">Altere-a antes de continuar utilizando o portal</h4>
    
    <div class="form-body">
        <div class="row">
            <div class="col-md-2"></div>
            <div class="col-md-8">
                <div class="input-group mb-3">
                    <div class="input-group-prepend">
                        <span class="input-group-text"><i class="ti-lock"></i></span>
                    </div>
                    <input @bind="newPassword" type="password" class="form-control form-control-lg" placeholder="Nova Senha" />
                </div>
            </div>
            <div class="col-md-2"></div>
        </div>
        <div class="row">
            <div class="col-md-2"></div>
            <div class="col-md-8">
                <div class="input-group mb-3">
                    <div class="input-group-prepend">
                        <span class="input-group-text"><i class="ti-check"></i></span>
                    </div>
                    <input @bind="confirmPassword" type="password" class="form-control form-control-lg" placeholder="Confirme a Senha" />
                </div>
            </div>
            <div class="col-md-2"></div>
        </div>
    </div>
    
    <div class="modal-footer" style="place-content:center">
        <div class="text-left">
            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <label style="color: darkred;">@errorMessage</label>
            }
            @if (!string.IsNullOrEmpty(successMessage))
            {
                <label style="color: blue;">@successMessage</label>
            }
        </div>
        <button @onclick="ChangePassword" type="button" class="btn btn-danger" disabled="@isProcessing">
            @if (isProcessing)
            {
                <span class="spinner-border spinner-border-sm" role="status"></span>
                <span>Alterando...</span>
            }
            else
            {
                <span>Alterar</span>
            }
        </button>
    </div>
</div>

@code {
    [Parameter] public EventCallback OnPasswordChanged { get; set; }
    
    private string newPassword = string.Empty;
    private string confirmPassword = string.Empty;
    private string errorMessage = string.Empty;
    private string successMessage = string.Empty;
    private bool isProcessing = false;

    private async Task ChangePassword()
    {
        if (isProcessing) return;
        
        isProcessing = true;
        errorMessage = string.Empty;
        successMessage = string.Empty;
        
        try
        {
            var currentUser = UserContextService.GetUsuarioLogado();
            if (currentUser == null)
            {
                errorMessage = "Usuário não encontrado";
                return;
            }

            var validationResult = await PasswordService.ValidatePasswordAsync(newPassword, confirmPassword);
            if (!validationResult.IsValid)
            {
                errorMessage = validationResult.ErrorMessage;
                return;
            }

            var changeResult = await PasswordService.ChangePasswordAsync(currentUser.Id, newPassword);
            if (changeResult.IsSuccess)
            {
                successMessage = changeResult.SuccessMessage;
                MessageBoxService.ShowSuccess(changeResult.SuccessMessage);
                
                await Task.Delay(1500);
                await OnPasswordChanged.InvokeAsync();
            }
            else
            {
                errorMessage = changeResult.ErrorMessage;
                MessageBoxService.ShowError(changeResult.ErrorMessage);
            }
        }
        catch (Exception ex)
        {
            errorMessage = "Erro interno ao alterar senha";
            MessageBoxService.ShowError(errorMessage);
        }
        finally
        {
            isProcessing = false;
        }
    }
}