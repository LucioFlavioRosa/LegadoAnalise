@using Peers.Moderno.Services.Common
@inject IFooterLinksService FooterLinksService
@inject ITelemetryService TelemetryService

<div class="footer-links" style="background: #e6f1f9; padding: 20px 0; position: fixed;bottom: 0;width: 100%;">
    <div style="display: flex; justify-content: center;">
        @if (footerLinks != null && footerLinks.Any())
        {
            @foreach (var link in footerLinks)
            {
                <div style="text-align: center; margin: 0 24px;">
                    <a href="@link.Url" target="@link.Target" style="text-decoration: none; color: inherit;" @onclick="() => TrackLinkClick(link.Name)">
                        <img src="@link.Icon" alt="@link.Name" style="width:32px; height:32px; display:block; margin:0 auto 4px auto;" />
                        <span style="font-size: 16px;">@link.Name</span>
                    </a>
                </div>
            }
        }
        else
        {
            <div style="text-align: center; color: #666;">
                <span>Carregando links...</span>
            </div>
        }
    </div>
</div>

@code {
    [Parameter] public int? UserId { get; set; }
    [Parameter] public int? UserProfileId { get; set; }
    
    private List<FooterLink>? footerLinks;
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            isLoading = true;
            footerLinks = await FooterLinksService.GetFooterLinksAsync(UserId, UserProfileId);
        }
        catch (Exception ex)
        {
            TelemetryService.TrackException(ex, new Dictionary<string, string>
            {
                { "Component", "FooterLinks" },
                { "Method", "OnInitializedAsync" }
            });
            footerLinks = new List<FooterLink>();
        }
        finally
        {
            isLoading = false;
        }
    }

    private void TrackLinkClick(string linkName)
    {
        try
        {
            TelemetryService.TrackEvent("FooterLinkClicked", new Dictionary<string, string>
            {
                { "LinkName", linkName },
                { "UserId", UserId?.ToString() ?? "Anonymous" },
                { "Timestamp", DateTime.UtcNow.ToString("yyyy-MM-dd HH:mm:ss") }
            });
        }
        catch
        {
            // Silently ignore telemetry errors
        }
    }
}