@using Peers.Moderno.Services.Common

@if (MentorshipItems?.Any() == true)
{
    <div class="card">
        <div class="card-body">
            <h4 class="card-title">Mentoria</h4>
            <div class="form-body">
                @if (HasMentorados)
                {
                    <div class="row">
                        <div class="col-md-12">
                            <div class="form-group">
                                @foreach (var item in GetMentorItems())
                                {
                                    <a href="@item.Url" class="@item.CssClass">@item.Title</a>
                                }
                            </div>
                        </div>
                    </div>
                }
                <div class="row">
                    <div class="col-md-12">
                        <div class="form-group">
                            @foreach (var item in GetMentoradoItems())
                            {
                                <a href="@item.Url" class="@item.CssClass">@item.Title</a>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public List<MentorshipMenuItem> MentorshipItems { get; set; } = new();
    [Parameter] public bool HasMentorados { get; set; }

    private List<MentorshipMenuItem> GetMentorItems()
    {
        return MentorshipItems?.Where(x => x.IsMentorSection && x.IsVisible).ToList() ?? new List<MentorshipMenuItem>();
    }

    private List<MentorshipMenuItem> GetMentoradoItems()
    {
        return MentorshipItems?.Where(x => !x.IsMentorSection && x.IsVisible).ToList() ?? new List<MentorshipMenuItem>();
    }
}