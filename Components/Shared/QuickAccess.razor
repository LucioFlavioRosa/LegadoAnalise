@using Peers.Moderno.Services.Common

@if (QuickAccessItems?.Any() == true)
{
    <div class="card">
        <div class="card-body">
            <h4 class="card-title">Acesso rápido</h4>
            <div class="form-body">
                <div class="row">
                    <div class="col-md-12">
                        <div class="form-group">
                            @foreach (var item in QuickAccessItems.Where(x => x.IsVisible))
                            {
                                <a href="@item.Url" class="@item.CssClass">@item.Title</a>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public List<QuickAccessItem> QuickAccessItems { get; set; } = new();
}