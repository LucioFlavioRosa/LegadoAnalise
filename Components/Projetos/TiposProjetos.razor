@page "/tipos-projetos"
@using Peers.Moderno.Models
@using Peers.Moderno.Services.Projetos.Common
@using Peers.Moderno.Services.Common
@inject ITiposProjetosService TiposProjetosService
@inject IMessageBoxService MessageBoxService
@rendermode InteractiveAuto

<PageTitle>Tipos de Projeto</PageTitle>

<div class="page-breadcrumb border-bottom">
    <div class="row">
        <div class="col-lg-3 col-md-4 col-xs-12 align-self-center">
            <h5 class="font-medium text-uppercase mb-0">Tipos de projeto</h5>
        </div>
        <div class="col-lg-9 col-md-8 col-xs-12 align-self-center">
            <nav aria-label="breadcrumb" class="mt-2 float-md-right float-left">
                <ol class="breadcrumb mb-0 justify-content-end p-0">
                    <li class="breadcrumb-item"><a href="/">Peers / Cadastro Básico de Projetos</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Tipos de Projeto</li>
                </ol>
            </nav>
        </div>
    </div>
</div>

<div class="page-content container-fluid">
    <!-- Formulário de Cadastro/Edição -->
    <div class="card">
        <div class="card-body">
            <h4 class="card-title">Dados do Tipo de Projeto</h4>
            <EditForm Model="@TipoProjetoAtual" OnValidSubmit="@SalvarTipoProjeto">
                <DataAnnotationsValidator />
                <ValidationSummary />
                
                <div class="form-body">
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label>Tipo de Projeto</label>
                                <InputText @bind-Value="TipoProjetoAtual.Nome" class="form-control" placeholder="Digite o tipo de projeto" />
                                <ValidationMessage For="@(() => TipoProjetoAtual.Nome)" />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label>Status</label>
                                <InputSelect @bind-Value="TipoProjetoAtual.ATV" class="form-control">
                                    <option value="1">Ativo</option>
                                    <option value="0">Inativo</option>
                                </InputSelect>
                            </div>
                        </div>
                    </div>
                </div>
                
                <div class="form-actions">
                    <div class="text-right">
                        <button type="submit" class="btn btn-info" disabled="@IsProcessing">
                            @if (IsProcessing)
                            {
                                <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                                <span>Processando...</span>
                            }
                            else
                            {
                                <span>@(IsEdicao ? "Salvar Alterações" : "Cadastrar")</span>
                            }
                        </button>
                        @if (IsEdicao)
                        {
                            <button type="button" class="btn btn-secondary ml-2" @onclick="CancelarEdicao">
                                Cancelar
                            </button>
                        }
                    </div>
                </div>
            </EditForm>
        </div>
    </div>

    <!-- Lista de Tipos de Projeto -->
    <div class="card">
        <div class="card-body">
            <h4 class="card-title">Lista de Tipos de Projeto</h4>
            <h6 class="card-subtitle">Filtre as informações separadas por espaço para busca em qualquer coluna em qualquer ordem, completo ou parcial: <code>tipo de projeto código</code>.</h6>
            
            @if (IsCarregando)
            {
                <div class="text-center p-4">
                    <div class="spinner-border" role="status">
                        <span class="sr-only">Carregando...</span>
                    </div>
                    <p class="mt-2">Carregando tipos de projeto...</p>
                </div>
            }
            else if (TiposProjetos?.Any() == true)
            {
                <div class="table-responsive">
                    <table class="table table-striped border dtInit">
                        <thead>
                            <tr>
                                <th>Código</th>
                                <th>Tipo Projeto</th>
                                <th>Status(Ativo/Inativo)</th>
                                <th data-sort="0">Ação</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var tipo in TiposProjetos)
                            {
                                <tr>
                                    <td>@tipo.IdTipo</td>
                                    <td>@tipo.Nome</td>
                                    <td>
                                        <span class="badge @(tipo.Ativo ? "badge-success" : "badge-secondary")">
                                            @tipo.StatusTexto
                                        </span>
                                    </td>
                                    <td>
                                        <button class="btn btn-info btn-sm" @onclick="() => EditarTipoProjeto(tipo)" disabled="@IsProcessing">
                                            Alterar
                                        </button>
                                        @if (tipo.Ativo)
                                        {
                                            <button class="btn btn-dark btn-sm ml-1" @onclick="() => InativarTipoProjeto(tipo.IdTipo)" disabled="@IsProcessing">
                                                Inativar
                                            </button>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr>
                                <th>Código</th>
                                <th>Tipo Projeto</th>
                                <th>Status(Ativo/Inativo)</th>
                                <th data-sort="0">Ação</th>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            }
            else
            {
                <div class="alert alert-info" role="alert">
                    <i class="fas fa-info-circle"></i>
                    Nenhum tipo de projeto encontrado.
                </div>
            }
        </div>
    </div>
</div>