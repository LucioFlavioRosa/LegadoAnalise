@page "/projetos"
@using Peers.Moderno.Models
@using Peers.Moderno.Services.Projetos
@using Peers.Moderno.Services.Common
@inject IProjetosService ProjetosService
@inject IMessageBoxService MessageBoxService
@inject ITelemetryService TelemetryService
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@rendermode InteractiveAuto

<div class="page-breadcrumb border-bottom">
    <div class="row">
        <div class="col-lg-3 col-md-4 col-xs-12 align-self-center">
            <h5 class="font-medium text-uppercase mb-0">Projetos</h5>
        </div>
        <div class="col-lg-9 col-md-8 col-xs-12 align-self-center">
            <nav aria-label="breadcrumb" class="mt-2 float-md-right float-left">
                <ol class="breadcrumb mb-0 justify-content-end p-0">
                    <li class="breadcrumb-item"><a href="/">Peers</a></li>
                    <li class="breadcrumb-item active">Lista de Projetos</li>
                </ol>
            </nav>
        </div>
    </div>
</div>

<div class="page-content container-fluid">
    <div class="row mb-3">
        <div class="col-md-6">
            <div class="input-group">
                <input type="text" class="form-control" placeholder="Filtrar projetos..." @bind="filtro" @onkeyup="FiltrarProjetos" />
                <div class="input-group-append">
                    <button class="btn btn-outline-secondary" type="button" @onclick="LimparFiltro">
                        <i class="fa fa-times"></i>
                    </button>
                </div>
            </div>
        </div>
        <div class="col-md-6 text-right">
            <button class="btn btn-success" @onclick="NovoProjeto">
                <i class="fa fa-plus"></i> Novo Projeto
            </button>
        </div>
    </div>
    
    <div class="card">
        <div class="card-body">
            <h4 class="card-title">Lista de Projetos</h4>
            <h6 class="card-subtitle mb-3">Filtre as informações separadas por espaço para busca em qualquer coluna: <code>projeto status datas</code></h6>
            
            @if (isLoading)
            {
                <div class="text-center p-4">
                    <div class="spinner-border" role="status">
                        <span class="sr-only">Carregando...</span>
                    </div>
                    <p class="mt-2">Carregando projetos...</p>
                </div>
            }
            else if (!projetosFiltrados.Any())
            {
                <div class="alert alert-info text-center">
                    <i class="fa fa-info-circle"></i>
                    @if (string.IsNullOrEmpty(filtro))
                    {
                        <span>Nenhum projeto encontrado.</span>
                    }
                    else
                    {
                        <span>Nenhum projeto encontrado para o filtro "@filtro".</span>
                    }
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-striped border">
                        <thead>
                            <tr>
                                <th @onclick="() => OrdenarPor(nameof(Projeto.Codigo))" style="cursor: pointer;">
                                    Código
                                    @if (ordenacao == nameof(Projeto.Codigo))
                                    {
                                        <i class="fa @(ordemCrescente ? "fa-sort-up" : "fa-sort-down")"></i>
                                    }
                                </th>
                                <th @onclick="() => OrdenarPor(nameof(Projeto.Nome))" style="cursor: pointer;">
                                    Projeto
                                    @if (ordenacao == nameof(Projeto.Nome))
                                    {
                                        <i class="fa @(ordemCrescente ? "fa-sort-up" : "fa-sort-down")"></i>
                                    }
                                </th>
                                <th @onclick="() => OrdenarPor(nameof(Projeto.DataInicio))" style="cursor: pointer;">
                                    Data Início
                                    @if (ordenacao == nameof(Projeto.DataInicio))
                                    {
                                        <i class="fa @(ordemCrescente ? "fa-sort-up" : "fa-sort-down")"></i>
                                    }
                                </th>
                                <th @onclick="() => OrdenarPor(nameof(Projeto.DataFim))" style="cursor: pointer;">
                                    Data Término
                                    @if (ordenacao == nameof(Projeto.DataFim))
                                    {
                                        <i class="fa @(ordemCrescente ? "fa-sort-up" : "fa-sort-down")"></i>
                                    }
                                </th>
                                <th>Status</th>
                                <th>Ações</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var projeto in projetosFiltrados)
                            {
                                <tr>
                                    <td>@projeto.Codigo</td>
                                    <td>@projeto.Nome</td>
                                    <td>@projeto.DataInicio.ToString("dd/MM/yyyy")</td>
                                    <td>@projeto.DataFim?.ToString("dd/MM/yyyy")</td>
                                    <td>
                                        <span class="badge @(projeto.Ativo ? "badge-success" : "badge-secondary")">
                                            @(projeto.Ativo ? "Ativo" : "Inativo")
                                        </span>
                                    </td>
                                    <td>
                                        <div class="btn-group" role="group">
                                            <button type="button" class="btn btn-sm btn-outline-primary" @onclick="() => EditarProjeto(projeto.Id)" title="Editar">
                                                <i class="fa fa-edit"></i>
                                            </button>
                                            <button type="button" class="btn btn-sm btn-outline-info" @onclick="() => VisualizarProjeto(projeto.Id)" title="Visualizar">
                                                <i class="fa fa-eye"></i>
                                            </button>
                                            @if (projeto.Ativo)
                                            {
                                                <button type="button" class="btn btn-sm btn-outline-warning" @onclick="() => InativarProjeto(projeto.Id)" title="Inativar">
                                                    <i class="fa fa-pause"></i>
                                                </button>
                                            }
                                            else
                                            {
                                                <button type="button" class="btn btn-sm btn-outline-success" @onclick="() => AtivarProjeto(projeto.Id)" title="Ativar">
                                                    <i class="fa fa-play"></i>
                                                </button>
                                            }
                                            <button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => ExcluirProjeto(projeto.Id)" title="Excluir">
                                                <i class="fa fa-trash"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                
                <div class="row mt-3">
                    <div class="col-md-6">
                        <p class="text-muted">Mostrando @projetosFiltrados.Count de @projetos.Count projetos</p>
                    </div>
                    <div class="col-md-6 text-right">
                        @if (projetosFiltrados.Count > 10)
                        {
                            <nav>
                                <ul class="pagination pagination-sm justify-content-end">
                                    <li class="page-item @(paginaAtual == 1 ? "disabled" : "")">
                                        <button class="page-link" @onclick="() => IrParaPagina(paginaAtual - 1)" disabled="@(paginaAtual == 1)">Anterior</button>
                                    </li>
                                    @for (int i = 1; i <= totalPaginas; i++)
                                    {
                                        <li class="page-item @(i == paginaAtual ? "active" : "")">
                                            <button class="page-link" @onclick="() => IrParaPagina(i)">@i</button>
                                        </li>
                                    }
                                    <li class="page-item @(paginaAtual == totalPaginas ? "disabled" : "")">
                                        <button class="page-link" @onclick="() => IrParaPagina(paginaAtual + 1)" disabled="@(paginaAtual == totalPaginas)">Próximo</button>
                                    </li>
                                </ul>
                            </nav>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@code {
    private List<Projeto> projetos = new();
    private List<Projeto> projetosFiltrados = new();
    private string filtro = string.Empty;
    private bool isLoading = true;
    
    private string ordenacao = nameof(Projeto.Nome);
    private bool ordemCrescente = true;
    
    private int paginaAtual = 1;
    private int itensPorPagina = 10;
    private int totalPaginas => (int)Math.Ceiling((double)projetosFiltrados.Count / itensPorPagina);
    
    protected override async Task OnInitializedAsync()
    {
        await CarregarProjetos();
    }
    
    private async Task CarregarProjetos()
    {
        try
        {
            isLoading = true;
            projetos = await ProjetosService.ObterProjetosAsync();
            AplicarFiltroEOrdenacao();
            
            TelemetryService.TrackEvent("ProjetosListLoaded", new Dictionary<string, string>
            {
                { "Count", projetos.Count.ToString() }
            });
        }
        catch (Exception ex)
        {
            TelemetryService.TrackException(ex);
            MessageBoxService.ShowError("Erro ao carregar lista de projetos");
        }
        finally
        {
            isLoading = false;
        }
    }
    
    private void FiltrarProjetos()
    {
        AplicarFiltroEOrdenacao();
        paginaAtual = 1;
    }
    
    private void LimparFiltro()
    {
        filtro = string.Empty;
        AplicarFiltroEOrdenacao();
        paginaAtual = 1;
    }
    
    private void OrdenarPor(string campo)
    {
        if (ordenacao == campo)
        {
            ordemCrescente = !ordemCrescente;
        }
        else
        {
            ordenacao = campo;
            ordemCrescente = true;
        }
        
        AplicarFiltroEOrdenacao();
    }
    
    private void AplicarFiltroEOrdenacao()
    {
        var query = projetos.AsQueryable();
        
        if (!string.IsNullOrEmpty(filtro))
        {
            var filtroLower = filtro.ToLower();
            query = query.Where(p => 
                p.Codigo.ToLower().Contains(filtroLower) ||
                p.Nome.ToLower().Contains(filtroLower) ||
                p.DataInicio.ToString("dd/MM/yyyy").Contains(filtroLower) ||
                (p.DataFim?.ToString("dd/MM/yyyy") ?? "").Contains(filtroLower)
            );
        }
        
        query = ordenacao switch
        {
            nameof(Projeto.Codigo) => ordemCrescente ? query.OrderBy(p => p.Codigo) : query.OrderByDescending(p => p.Codigo),
            nameof(Projeto.Nome) => ordemCrescente ? query.OrderBy(p => p.Nome) : query.OrderByDescending(p => p.Nome),
            nameof(Projeto.DataInicio) => ordemCrescente ? query.OrderBy(p => p.DataInicio) : query.OrderByDescending(p => p.DataInicio),
            nameof(Projeto.DataFim) => ordemCrescente ? query.OrderBy(p => p.DataFim) : query.OrderByDescending(p => p.DataFim),
            _ => query.OrderBy(p => p.Nome)
        };
        
        projetosFiltrados = query.ToList();
    }
    
    private void IrParaPagina(int pagina)
    {
        if (pagina >= 1 && pagina <= totalPaginas)
        {
            paginaAtual = pagina;
        }
    }
    
    private void NovoProjeto()
    {
        Navigation.NavigateTo("/projetos/form");
    }
    
    private void EditarProjeto(int projetoId)
    {
        Navigation.NavigateTo($"/projetos/form/{projetoId}");
    }
    
    private void VisualizarProjeto(int projetoId)
    {
        Navigation.NavigateTo($"/projetos/detalhes/{projetoId}");
    }
    
    private async Task AtivarProjeto(int projetoId)
    {
        try
        {
            var success = await ProjetosService.AlterarStatusProjetoAsync(projetoId, true);
            if (success)
            {
                MessageBoxService.ShowSuccess("Projeto ativado com sucesso!");
                await CarregarProjetos();
            }
        }
        catch (Exception ex)
        {
            TelemetryService.TrackException(ex);
            MessageBoxService.ShowError("Erro ao ativar projeto");
        }
    }
    
    private async Task InativarProjeto(int projetoId)
    {
        try
        {
            var success = await ProjetosService.AlterarStatusProjetoAsync(projetoId, false);
            if (success)
            {
                MessageBoxService.ShowSuccess("Projeto inativado com sucesso!");
                await CarregarProjetos();
            }
        }
        catch (Exception ex)
        {
            TelemetryService.TrackException(ex);
            MessageBoxService.ShowError("Erro ao inativar projeto");
        }
    }
    
    private async Task ExcluirProjeto(int projetoId)
    {
        try
        {
            var confirmado = await JSRuntime.InvokeAsync<bool>("confirm", "Tem certeza que deseja excluir este projeto?");
            if (confirmado)
            {
                var success = await ProjetosService.ExcluirProjetoAsync(projetoId);
                if (success)
                {
                    MessageBoxService.ShowSuccess("Projeto excluído com sucesso!");
                    await CarregarProjetos();
                }
            }
        }
        catch (Exception ex)
        {
            TelemetryService.TrackException(ex);
            MessageBoxService.ShowError("Erro ao excluir projeto");
        }
    }
}