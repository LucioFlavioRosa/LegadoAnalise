@page "/premissas"
@using Peers.Moderno.Models
@using Peers.Moderno.Services.Premissas.Common
@using Peers.Moderno.Services.Common
@inject IPremissasService PremissasService
@inject IMessageBoxService MessageBoxService
@inject IJSRuntime JSRuntime
@rendermode InteractiveAuto

<PageTitle>Premissas do Radar</PageTitle>

<div class="page-breadcrumb border-bottom">
    <div class="row">
        <div class="col-lg-3 col-md-4 col-xs-12 align-self-center">
            <h5 class="font-medium text-uppercase mb-0">Competências</h5>
        </div>
        <div class="col-lg-9 col-md-8 col-xs-12 align-self-center">
            <nav aria-label="breadcrumb" class="mt-2 float-md-right float-left">
                <ol class="breadcrumb mb-0 justify-content-end p-0">
                    <li class="breadcrumb-item"><a href="/">Peers / Cadastro Básico de Premissas</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Premissas do Radar</li>
                </ol>
            </nav>
        </div>
    </div>
</div>

<div class="page-content container-fluid">
    <div class="card">
        <div class="card-body">
            <h4 class="card-title">Dados da Premissa</h4>
            <div class="form-body">
                <div class="row">
                    <div class="col-md-4">
                        <div class="form-group">
                            <label>Eixo</label>
                            <select @bind="SelectedEixoId" class="form-control">
                                <option value="0">[Selecionar]</option>
                                @foreach (var eixo in Eixos)
                                {
                                    <option value="@eixo.IdEixo">@eixo.Nome</option>
                                }
                            </select>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-group">
                            <label>Cargo</label>
                            <select @bind="SelectedCargoId" class="form-control">
                                <option value="0">[Selecionar]</option>
                                @foreach (var cargo in Cargos)
                                {
                                    <option value="@cargo.IdCargo">@cargo.Nome</option>
                                }
                            </select>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-group">
                            <label>Nível</label>
                            <select @bind="SelectedNivelId" class="form-control">
                                <option value="0">[Selecionar]</option>
                                @foreach (var nivel in Niveis)
                                {
                                    <option value="@nivel.IdNivel">@nivel.Nivel</option>
                                }
                            </select>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-3">
                        <div class="form-group">
                            <label>Valor Radar Peers</label>
                            <input @bind="ValorPeers" type="number" class="form-control text-right" />
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-group">
                            <label>Valor Base Avaliado</label>
                            <input @bind="ValorAvaliado" type="number" class="form-control text-right" />
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-group">
                            <label>Valor Base Gestor</label>
                            <input @bind="ValorGestor" type="number" class="form-control text-right" />
                        </div>
                    </div>
                    <div class="form-actions col-md-3">
                        <label>&nbsp;</label>
                        <div class="text-right">
                            <button @onclick="CadastrarSalvar" class="btn btn-info" disabled="@IsLoading">
                                @if (IsLoading)
                                {
                                    <span class="spinner-border spinner-border-sm" role="status"></span>
                                }
                                @(EditingId > 0 ? "Salvar" : "Cadastrar")
                            </button>
                            @if (EditingId > 0)
                            {
                                <button @onclick="CancelarEdicao" class="btn btn-secondary ml-2">
                                    Cancelar
                                </button>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-body">
            <h4 class="card-title">Lista de Premissas</h4>
            <h6 class="card-subtitle">Filtre as informações separadas por espaço para busca em qualquer coluna em qualquer ordem, completo ou parcial.</h6>
            
            @if (IsLoadingList)
            {
                <div class="text-center p-4">
                    <div class="spinner-border" role="status">
                        <span class="sr-only">Carregando...</span>
                    </div>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-striped border" id="premissasTable">
                        <thead>
                            <tr>
                                <th>Eixo</th>
                                <th>Cargo</th>
                                <th>Nível</th>
                                <th>Base Peers</th>
                                <th>Base Avaliado</th>
                                <th>Base Gestor</th>
                                <th>Status</th>
                                <th>Ação</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var premissa in Premissas)
                            {
                                <tr>
                                    <td>@premissa.Eixo?.Nome</td>
                                    <td>@premissa.Cargo?.Nome</td>
                                    <td>@premissa.CargoNivel?.Nivel</td>
                                    <td>@premissa.ValorRadarPeers</td>
                                    <td>@premissa.ValorBaseAutoAvaliacao</td>
                                    <td>@premissa.ValorBaseAvaliacaoGestor</td>
                                    <td>
                                        <span class="@StatusHelper.GetStatusClass(premissa.ATV)">
                                            @StatusHelper.StatusRadar(premissa.ATV)
                                        </span>
                                    </td>
                                    <td>
                                        <button @onclick="() => EditarPremissa(premissa.IdPremissa)" class="btn btn-info btn-sm">
                                            Alterar
                                        </button>
                                        <button @onclick="() => InativarPremissa(premissa.IdPremissa)" class="btn btn-dark btn-sm ml-1">
                                            @(premissa.ATV == 1 ? "Inativar" : "Ativar")
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr>
                                <th>Eixo</th>
                                <th>Cargo</th>
                                <th>Nível</th>
                                <th>Base Peers</th>
                                <th>Base Avaliado</th>
                                <th>Base Gestor</th>
                                <th>Status</th>
                                <th>Ação</th>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

@code {
    private List<PremissasRadar> Premissas = new();
    private List<Eixo> Eixos = new();
    private List<Cargo> Cargos = new();
    private List<CargoNivel> Niveis = new();
    
    private int SelectedEixoId = 0;
    private int SelectedCargoId = 0;
    private int SelectedNivelId = 0;
    private int ValorPeers = 0;
    private int ValorAvaliado = 0;
    private int ValorGestor = 0;
    private int EditingId = 0;
    
    private bool IsLoading = false;
    private bool IsLoadingList = true;

    protected override async Task OnInitializedAsync()
    {
        await CarregarDados();
    }

    private async Task CarregarDados()
    {
        IsLoadingList = true;
        StateHasChanged();
        
        try
        {
            var tasks = new Task[4]
            {
                CarregarPremissas(),
                CarregarEixos(),
                CarregarCargos(),
                CarregarNiveis()
            };
            
            await Task.WhenAll(tasks);
        }
        finally
        {
            IsLoadingList = false;
            StateHasChanged();
        }
    }

    private async Task CarregarPremissas()
    {
        Premissas = await PremissasService.ListarAsync();
    }

    private async Task CarregarEixos()
    {
        Eixos = await PremissasService.ListarEixosAsync();
    }

    private async Task CarregarCargos()
    {
        Cargos = await PremissasService.ListarCargosAsync();
    }

    private async Task CarregarNiveis()
    {
        Niveis = await PremissasService.ListarNiveisAsync();
    }

    private async Task CadastrarSalvar()
    {
        if (!ValidarCampos())
            return;

        IsLoading = true;
        StateHasChanged();

        try
        {
            var premissa = new PremissasRadar
            {
                IdPremissa = EditingId,
                IdEixo = SelectedEixoId,
                IdCargo = SelectedCargoId,
                IdNivel = SelectedNivelId,
                ValorRadarPeers = ValorPeers,
                ValorBaseAutoAvaliacao = ValorAvaliado,
                ValorBaseAvaliacaoGestor = ValorGestor
            };

            bool sucesso;
            if (EditingId > 0)
            {
                sucesso = await PremissasService.AlterarAsync(premissa);
                if (sucesso)
                {
                    MessageBoxService.ShowSuccess("Premissa alterada com sucesso.");
                    CancelarEdicao();
                }
                else
                {
                    MessageBoxService.ShowError("Houve uma falha na tentativa de alteração.");
                }
            }
            else
            {
                sucesso = await PremissasService.InserirAsync(premissa);
                if (sucesso)
                {
                    MessageBoxService.ShowSuccess("Premissa cadastrada com sucesso.");
                    LimparCampos();
                }
                else
                {
                    MessageBoxService.ShowError("Houve uma falha na tentativa de cadastro. Verifique se já existe uma premissa com os mesmos dados.");
                }
            }

            if (sucesso)
            {
                await CarregarPremissas();
            }
        }
        catch (Exception)
        {
            MessageBoxService.ShowError("Erro interno. Tente novamente.");
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }

    private async Task EditarPremissa(int id)
    {
        var premissa = await PremissasService.ObterAsync(id);
        if (premissa != null)
        {
            EditingId = premissa.IdPremissa;
            SelectedEixoId = premissa.IdEixo;
            SelectedCargoId = premissa.IdCargo;
            SelectedNivelId = premissa.IdNivel;
            ValorPeers = premissa.ValorRadarPeers;
            ValorAvaliado = premissa.ValorBaseAutoAvaliacao;
            ValorGestor = premissa.ValorBaseAvaliacaoGestor;
            StateHasChanged();
        }
    }

    private async Task InativarPremissa(int id)
    {
        var sucesso = await PremissasService.InativarAsync(id);
        if (sucesso)
        {
            MessageBoxService.ShowSuccess("Premissa alterada com sucesso!");
            await CarregarPremissas();
        }
        else
        {
            MessageBoxService.ShowError("Erro ao alterar a premissa!");
        }
    }

    private void CancelarEdicao()
    {
        EditingId = 0;
        LimparCampos();
    }

    private void LimparCampos()
    {
        SelectedEixoId = 0;
        SelectedCargoId = 0;
        SelectedNivelId = 0;
        ValorPeers = 0;
        ValorAvaliado = 0;
        ValorGestor = 0;
    }

    private bool ValidarCampos()
    {
        if (SelectedEixoId == 0)
        {
            MessageBoxService.ShowWarning("Selecione o Eixo.");
            return false;
        }

        if (SelectedCargoId == 0)
        {
            MessageBoxService.ShowWarning("Selecione o Cargo.");
            return false;
        }

        if (SelectedNivelId == 0)
        {
            MessageBoxService.ShowWarning("Selecione o Nível.");
            return false;
        }

        if (ValorPeers <= 0)
        {
            MessageBoxService.ShowWarning("Informe o Valor Radar Peers.");
            return false;
        }

        if (ValorAvaliado <= 0)
        {
            MessageBoxService.ShowWarning("Informe o Valor Base Avaliado.");
            return false;
        }

        if (ValorGestor <= 0)
        {
            MessageBoxService.ShowWarning("Informe o Valor Base Gestor.");
            return false;
        }

        return true;
    }
}