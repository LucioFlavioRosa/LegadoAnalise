@page "/eixos"
@using Peers.Moderno.Models
@using Peers.Moderno.Services.Eixos
@using Peers.Moderno.Services.Common
@inject IEixosService EixosService
@inject IMessageBoxService MessageBoxService
@inject IJSRuntime JSRuntime
@rendermode InteractiveAuto

<PageTitle>Eixos - Sistema de Avaliação</PageTitle>

<div class="page-breadcrumb border-bottom">
    <div class="row">
        <div class="col-lg-3 col-md-4 col-xs-12 align-self-center">
            <h5 class="font-medium text-uppercase mb-0">Eixos</h5>
        </div>
        <div class="col-lg-9 col-md-8 col-xs-12 align-self-center">
            <nav aria-label="breadcrumb" class="mt-2 float-md-right float-left">
                <ol class="breadcrumb mb-0 justify-content-end p-0">
                    <li class="breadcrumb-item"><a href="/">Peers / Cadastro Básico de Projetos</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Eixos</li>
                </ol>
            </nav>
        </div>
    </div>
</div>

<div class="page-content container-fluid">
    <!-- Editor de Campos -->
    <div class="card">
        <div class="card-body">
            <h4 class="card-title">Dados do eixo</h4>
            <EditForm Model="@CurrentEixo" OnValidSubmit="@HandleSubmit">
                <DataAnnotationsValidator />
                <ValidationSummary />
                
                <div class="form-body">
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label>Eixo</label>
                                <InputText @bind-Value="CurrentEixo.Nome" class="form-control" />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label>Status</label>
                                <InputSelect @bind-Value="CurrentEixo.ATV" class="form-control">
                                    <option value="1">Ativo</option>
                                    <option value="0">Inativo</option>
                                </InputSelect>
                            </div>
                        </div>
                    </div>
                </div>
                
                <div class="form-actions">
                    <div class="text-right">
                        <button type="submit" class="btn btn-info" disabled="@IsLoading">
                            @if (IsLoading)
                            {
                                <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                                <span>Processando...</span>
                            }
                            else
                            {
                                <span>@(IsEditing ? "Salvar" : "Cadastrar")</span>
                            }
                        </button>
                        @if (IsEditing)
                        {
                            <button type="button" class="btn btn-secondary" @onclick="CancelEdit">
                                Cancelar
                            </button>
                        }
                    </div>
                </div>
            </EditForm>
        </div>
    </div>

    <!-- Exportar Eixos -->
    <div class="card">
        <div class="card-body">
            <h4 class="card-title">Exportar Eixos</h4>
            <button type="button" class="btn btn-info" @onclick="ExportEixos" disabled="@IsExporting">
                @if (IsExporting)
                {
                    <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                    <span>Exportando...</span>
                }
                else
                {
                    <span>Exportar</span>
                }
            </button>
        </div>
    </div>

    <!-- Lista de Eixos -->
    <div class="card">
        <div class="card-body">
            <h4 class="card-title">Lista de eixos</h4>
            <h6 class="card-subtitle">Filtre as informações separadas por espaço para busca em qualquer coluna em qualquer ordem, completo ou parcial: <code>eixo código</code>.</h6>
            
            @if (IsLoadingList)
            {
                <div class="text-center p-4">
                    <div class="spinner-border" role="status">
                        <span class="sr-only">Carregando...</span>
                    </div>
                </div>
            }
            else if (Eixos?.Any() == true)
            {
                <div class="table-responsive">
                    <table class="table table-striped border">
                        <thead>
                            <tr>
                                <th>Código</th>
                                <th>Eixos</th>
                                <th>Status(Ativo/Inativo)</th>
                                <th>Ação</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var eixo in Eixos)
                            {
                                <tr>
                                    <td>@eixo.IdEixo</td>
                                    <td>@eixo.Nome</td>
                                    <td>@(eixo.ATV == 1 ? "Ativo" : "Inativo")</td>
                                    <td>
                                        <button class="btn btn-info btn-sm" @onclick="() => EditEixo(eixo)">
                                            Alterar
                                        </button>
                                        @if (eixo.ATV == 1)
                                        {
                                            <button class="btn btn-dark btn-sm" @onclick="() => InactivateEixo(eixo.IdEixo)">
                                                Inativar
                                            </button>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr>
                                <th>Código</th>
                                <th>Eixo</th>
                                <th>Status(Ativo/Inativo)</th>
                                <th>Ação</th>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            }
            else
            {
                <div class="alert alert-info">
                    Nenhum eixo encontrado.
                </div>
            }
        </div>
    </div>
</div>