@rendermode InteractiveAuto
@page "/feedback"
@inject Services.Feedback.Common.IFeedbackService FeedbackService
@inject Services.Feedback.Common.IFeedbackFinalizationService FeedbackFinalizationService
@inject Services.Feedback.Common.IFeedbackComboHelper FeedbackComboHelper
@inject Services.Common.IMessageBoxService MessageBoxService
@inject NavigationManager NavigationManager

<PageTitle>Feedback</PageTitle>

<div class="page-breadcrumb border-bottom">
    <div class="row">
        <div class="col-lg-3 col-md-4 col-xs-12 align-self-center">
            <h5 class="font-medium text-uppercase mb-0">Feedback</h5>
        </div>
        <div class="col-lg-9 col-md-8 col-xs-12 align-self-center">
            <nav aria-label="breadcrumb" class="mt-2 float-md-right float-left">
                <ol class="breadcrumb mb-0 justify-content-end p-0">
                    <li class="breadcrumb-item"><a href="/">Peers</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Avaliação / Feedback</li>
                </ol>
            </nav>
        </div>
    </div>
</div>

<Components.Common.MessageBox @ref="MessageBoxRef" />

<div class="page-content container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-body">
                    <h4 class="card-title">Filtro avaliações</h4>
                    <form @onsubmit="OnFilterSubmit">
                        <div class="form-body">
                            <div class="row">
                                <div class="col-md-3">
                                    <div class="form-group">
                                        <label>Projeto</label>
                                        <select class="form-control p-0 select2" style="width: 100%" @bind="Filtro.IdProjeto">
                                            <option value="">[Selecionar]</option>
                                            @foreach (var projeto in ProjetosCombo)
                                            {
                                                <option value="@projeto.Value">@projeto.Text</option>
                                            }
                                        </select>
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="form-group">
                                        <label>Cliente</label>
                                        <select class="form-control p-0 select2" style="width: 100%" @bind="Filtro.IdCliente">
                                            <option value="">[Selecionar]</option>
                                            @foreach (var cliente in ClientesCombo)
                                            {
                                                <option value="@cliente.Value">@cliente.Text</option>
                                            }
                                        </select>
                                    </div>
                                </div>
                                <div class="col-md-2">
                                    <div class="form-group">
                                        <label>Período</label>
                                        <select class="form-control p-0 select2" style="width: 100%" @bind="Filtro.IdPeriodo">
                                            <option value="">[Selecionar]</option>
                                            @foreach (var periodo in PeriodosCombo)
                                            {
                                                <option value="@periodo.Value">@periodo.Text</option>
                                            }
                                        </select>
                                    </div>
                                </div>
                                <div class="col-md-2">
                                    <div class="form-group">
                                        <label>Status</label>
                                        <select class="form-control p-0 select2" style="width: 100%" @bind="Filtro.IdStatus">
                                            <option value="">[Selecionar]</option>
                                            @foreach (var status in StatusCombo)
                                            {
                                                <option value="@status.Value">@status.Text</option>
                                            }
                                        </select>
                                    </div>
                                </div>
                                <div class="col-md-2 d-flex align-items-end">
                                    <button type="submit" class="btn btn-danger w-100">Filtrar</button>
                                </div>
                            </div>
                        </div>
                    </form>

                    <div class="table-responsive mt-4">
                        @if (ProjetosAvaliacoes == null)
                        {
                            <div>Carregando avaliações...</div>
                        }
                        else if (!ProjetosAvaliacoes.Any())
                        {
                            <div>Nenhuma avaliação encontrada para os filtros selecionados.</div>
                        }
                        else
                        {
                            <table class="table table-striped border dtInit">
                                <thead>
                                    <tr>
                                        <th>Código</th>
                                        <th>Projeto</th>
                                        <th>Cliente</th>
                                        <th>Status(Ativo/Inativo)</th>
                                        <th>Dt. Início Projeto</th>
                                        <th>Dt. Término Projeto</th>
                                        <th>Responsável</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var projeto in ProjetosAvaliacoes)
                                    {
                                        <tr>
                                            <td>@projeto.Id</td>
                                            <td>@projeto.Nome</td>
                                            <td>@projeto.Cliente?.Nome</td>
                                            <td>@projeto.Status?.Nome</td>
                                            <td>@projeto.DataInicio</td>
                                            <td>@projeto.DataTermino</td>
                                            <td>@projeto.Responsavel?.Nome</td>
                                        </tr>
                                        <tr>
                                            <td></td>
                                            <td colspan="6">
                                                @if (projeto.Associados != null && projeto.Associados.Any())
                                                {
                                                    <table class="table table-striped border dtInit">
                                                        <thead>
                                                            <tr>
                                                                <th>Foto</th>
                                                                <th>Profissional</th>
                                                                <th>Cargo</th>
                                                                <th>Período</th>
                                                                <th>Início</th>
                                                                <th>Término</th>
                                                                <th>Gestor</th>
                                                                <th>Avaliador</th>
                                                                <th>Mentor</th>
                                                                <th>Etapa</th>
                                                                <th></th>
                                                            </tr>
                                                        </thead>
                                                        <tbody>
                                                            @foreach (var associado in projeto.Associados)
                                                            {
                                                                <tr>
                                                                    <td>
                                                                        <img src="@associado.FotoAssociado?.Imagem" width="120" height="120" />
                                                                    </td>
                                                                    <td>@associado.Associado?.Nome</td>
                                                                    <td>@associado.Associado?.CARGOS?.Cargo</td>
                                                                    <td>@associado.Periodo?.Periodo</td>
                                                                    <td>@associado.DataInicio</td>
                                                                    <td>@associado.DataTermino</td>
                                                                    <td>@associado.Gestor?.Nome</td>
                                                                    <td>@associado.Avaliador?.Nome</td>
                                                                    <td>@associado.Associado?.ASSOCIADOS3?.Nome</td>
                                                                    <td>@associado.Etapa</td>
                                                                    <td style="text-align:right;">
                                                                        <a href="avalizacao_feedback_competencia.aspx?IdProjeto=@associado.Projeto?.Id&IdAssociado=@associado.Associado?.Id&IdPeriodo=@associado.Periodo?.IdPeriodo&TipoAvaliacao=@associado.TipoAvaliacao&Escopo=@associado.Escopo&idGestor=@associado.Gestor?.Id">
                                                                            <button type="button" class="btn btn-info" disabled="@(associado.ExibirFeedback == "hidden")">@associado.RotuloBotao</button>
                                                                        </a>
                                                                        @if (associado.ExibirBotaoFinalizar)
                                                                        {
                                                                            <button type="button" class="btn btn-dark ml-2" @onclick="() => OnFinalizarClick(associado)">Finalizar Avaliação</button>
                                                                        }
                                                                    </td>
                                                                </tr>
                                                            }
                                                        </tbody>
                                                    </table>
                                                }
                                                else
                                                {
                                                    <div class="text-muted">Nenhum associado disponível para este projeto.</div>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private Components.Common.MessageBox MessageBoxRef;

    private List<Services.Feedback.Common.ComboItem> ProjetosCombo = new();
    private List<Services.Feedback.Common.ComboItem> ClientesCombo = new();
    private List<Services.Feedback.Common.ComboItem> PeriodosCombo = new();
    private List<Services.Feedback.Common.ComboItem> StatusCombo = new();

    private Services.Feedback.Common.FeedbackFiltroModel Filtro = new();
    private List<Services.Feedback.Common.ProjetoModel> ProjetosAvaliacoes;

    protected override async Task OnInitializedAsync()
    {
        await CarregarCombosAsync();
        await CarregarAvaliacoesAsync();
    }

    private async Task CarregarCombosAsync()
    {
        ProjetosCombo = await FeedbackComboHelper.GetProjetosAsync();
        ClientesCombo = await FeedbackComboHelper.GetClientesAsync();
        PeriodosCombo = await FeedbackComboHelper.GetPeriodosAsync();
        StatusCombo = await FeedbackComboHelper.GetStatusAsync();
    }

    private async Task CarregarAvaliacoesAsync()
    {
        ProjetosAvaliacoes = await FeedbackService.ListarAvaliacoesAsync(Filtro);
        StateHasChanged();
    }

    private async Task OnFilterSubmit()
    {
        await CarregarAvaliacoesAsync();
    }

    private async Task OnFinalizarClick(Services.Feedback.Common.ProjetosAssociadosModel associado)
    {
        var resultado = await FeedbackFinalizationService.FinalizarAvaliacaoAsync(associado.IdEmail);
        if (resultado.Sucesso)
        {
            MessageBoxRef.ShowInfo(resultado.Mensagem);
            await CarregarAvaliacoesAsync();
        }
        else
        {
            MessageBoxRef.ShowWarning(resultado.Mensagem);
        }
    }
}
