@using Peers.Moderno.Services.FrentesInternas
@using Peers.Moderno.Services.Common
@using Peers.Moderno.Models
@inject IFrentesInternasService FrentesInternasService
@inject IMessageBoxService MessageBoxService
@inject ITelemetryService TelemetryService

<div class="card">
    <div class="card-body">
        <h4 class="card-title">Lista de Alocações Internas</h4>
        <h6 class="card-subtitle">Filtre as informações separadas por espaço para busca em qualquer coluna em qualquer ordem, completo ou parcial.</h6>
        
        @if (isLoading)
        {
            <div class="text-center">
                <div class="spinner-border" role="status">
                    <span class="sr-only">Carregando...</span>
                </div>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-striped border dtInit">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Alocação Interna</th>
                            <th>Líderes</th>
                            <th>Status(Ativo/Inativo)</th>
                            <th data-sort="0">Ação</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (frentesInternas?.Any() == true)
                        {
                            @foreach (var frente in frentesInternas)
                            {
                                <tr>
                                    <td>@frente.IdFrenteInterna</td>
                                    <td>@frente.Nome</td>
                                    <td>@((MarkupString)frente.LideresFormatados)</td>
                                    <td>@(frente.Status ? "Ativo" : "Inativo")</td>
                                    <td>
                                        @if (podeEditar)
                                        {
                                            <button class="btn btn-info btn-sm" @onclick="() => EditarFrenteInterna(frente)" disabled="@isProcessing">
                                                Alterar
                                            </button>
                                        }
                                        @if (frente.Status && podeInativar)
                                        {
                                            <button class="btn btn-dark btn-sm ml-1" @onclick="() => InativarFrenteInterna(frente.IdFrenteInterna)" disabled="@isProcessing">
                                                @if (isProcessing && frenteProcessandoId == frente.IdFrenteInterna)
                                                {
                                                    <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                                                }
                                                Inativar
                                            </button>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="text-center">Nenhuma alocação interna encontrada.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@code {
    [Parameter] public EventCallback<FrenteInternaModel> OnEditarFrenteInterna { get; set; }
    [Parameter] public EventCallback<int> OnInativarFrenteInterna { get; set; }

    private List<FrenteInternaModel>? frentesInternas;
    private bool isLoading = false;
    private bool isProcessing = false;
    private int frenteProcessandoId = 0;
    private bool podeEditar = true;
    private bool podeInativar = true;

    protected override async Task OnInitializedAsync()
    {
        await RefreshAsync();
    }

    public async Task RefreshAsync()
    {
        try
        {
            isLoading = true;
            StateHasChanged();

            frentesInternas = await FrentesInternasService.ObterFrentesInternasAsync();
            
            // TODO: Implementar verificação de permissões baseada no usuário logado
            // var usuarioLogado = await ObterUsuarioLogado();
            // podeEditar = usuarioLogado.IdPerfil >= 3;
            // podeInativar = usuarioLogado.IdPerfil >= 3;
        }
        catch (Exception ex)
        {
            TelemetryService.TrackException(ex);
            MessageBoxService.ShowError($"Erro ao carregar lista de frentes internas: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task EditarFrenteInterna(FrenteInternaModel frente)
    {
        try
        {
            await OnEditarFrenteInterna.InvokeAsync(frente);
            TelemetryService.TrackEvent("FrenteInterna_IniciarEdicao", new Dictionary<string, string> 
            { 
                { "Id", frente.IdFrenteInterna.ToString() }
            });
        }
        catch (Exception ex)
        {
            TelemetryService.TrackException(ex);
            MessageBoxService.ShowError($"Erro ao iniciar edição: {ex.Message}");
        }
    }

    private async Task InativarFrenteInterna(int idFrenteInterna)
    {
        if (isProcessing) return;

        try
        {
            isProcessing = true;
            frenteProcessandoId = idFrenteInterna;
            StateHasChanged();

            await OnInativarFrenteInterna.InvokeAsync(idFrenteInterna);
        }
        catch (Exception ex)
        {
            TelemetryService.TrackException(ex);
            MessageBoxService.ShowError($"Erro ao inativar frente interna: {ex.Message}");
        }
        finally
        {
            isProcessing = false;
            frenteProcessandoId = 0;
            StateHasChanged();
        }
    }
}