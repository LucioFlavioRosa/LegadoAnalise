@using Peers.Moderno.Services.FrentesInternas
@using Peers.Moderno.Services.Common
@using Peers.Moderno.Models
@inject IFrentesInternasService FrentesInternasService
@inject IMessageBoxService MessageBoxService
@inject ITelemetryService TelemetryService

<div class="card">
    <div class="card-body">
        <h4 class="card-title">Lista de Alocações Internas</h4>
        <h6 class="card-subtitle">Filtre as informações separadas por espaço para busca em qualquer coluna em qualquer ordem, completo ou parcial.</h6>
        
        <div class="table-responsive">
            @if (frentesInternas?.Any() == true)
            {
                <table class="table table-striped border dtInit">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Alocação Interna</th>
                            <th>Líderes</th>
                            <th>Status(Ativo/Inativo)</th>
                            <th>Ação</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var frente in frentesInternas)
                        {
                            <tr>
                                <td>@frente.Id</td>
                                <td>@frente.Nome</td>
                                <td>
                                    @if (!string.IsNullOrEmpty(frente.NomesLideres))
                                    {
                                        @((MarkupString)frente.NomesLideres)
                                    }
                                    else
                                    {
                                        <span class="text-muted">Nenhum líder</span>
                                    }
                                </td>
                                <td>
                                    <span class="badge @(frente.Ativo ? "badge-success" : "badge-secondary")">
                                        @(frente.Ativo ? "Ativo" : "Inativo")
                                    </span>
                                </td>
                                <td>
                                    <button class="btn btn-info btn-sm" @onclick="() => EditarFrenteInterna(frente.Id)">
                                        Alterar
                                    </button>
                                    @if (frente.Ativo)
                                    {
                                        <button class="btn btn-dark btn-sm ml-1" @onclick="() => ExcluirFrenteInterna(frente.Id)">
                                            Inativar
                                        </button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <div class="alert alert-info">
                    <i class="fas fa-info-circle"></i>
                    Nenhuma alocação interna encontrada.
                </div>
            }
        </div>
        
        @if (carregando)
        {
            <div class="text-center mt-3">
                <div class="spinner-border" role="status">
                    <span class="sr-only">Carregando...</span>
                </div>
            </div>
        }
    </div>
</div>

@code {
    [Parameter] public EventCallback<int> OnEditarFrenteInterna { get; set; }
    [Parameter] public EventCallback<int> OnExcluirFrenteInterna { get; set; }

    private List<FrenteInternaModel>? frentesInternas;
    private bool carregando = false;

    protected override async Task OnInitializedAsync()
    {
        await AtualizarLista();
    }

    public async Task AtualizarLista()
    {
        try
        {
            carregando = true;
            StateHasChanged();
            
            frentesInternas = await FrentesInternasService.ObterFrentesInternasComLideresAsync();
        }
        catch (Exception ex)
        {
            MessageBoxService.ShowError($"Erro ao carregar lista de frentes internas: {ex.Message}");
            TelemetryService.TrackException(ex);
        }
        finally
        {
            carregando = false;
            StateHasChanged();
        }
    }

    private async Task EditarFrenteInterna(int idFrenteInterna)
    {
        await OnEditarFrenteInterna.InvokeAsync(idFrenteInterna);
    }

    private async Task ExcluirFrenteInterna(int idFrenteInterna)
    {
        await OnExcluirFrenteInterna.InvokeAsync(idFrenteInterna);
    }
}