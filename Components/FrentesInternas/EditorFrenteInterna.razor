@using Peers.Moderno.Services.FrentesInternas
@using Peers.Moderno.Services.Common
@using Peers.Moderno.Models
@inject IFrentesInternasService FrentesInternasService
@inject IMessageBoxService MessageBoxService
@inject ITelemetryService TelemetryService

<div class="card">
    <div class="card-body">
        <h4>Dados da Alocação Interna</h4>
        
        <EditForm Model="@frenteInternaModel" OnValidSubmit="@HandleValidSubmit">
            <DataAnnotationsValidator />
            <ValidationSummary />
            
            <div class="form-body">
                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label>Nome</label>
                            <InputText @bind-Value="frenteInternaModel.Nome" class="form-control" />
                            <ValidationMessage For="@(() => frenteInternaModel.Nome)" />
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label>Status</label>
                            <InputSelect @bind-Value="frenteInternaModel.Status" class="form-control">
                                <option value="true">Ativo</option>
                                <option value="false">Inativo</option>
                            </InputSelect>
                        </div>
                    </div>
                </div>
            </div>

            @if (isEditMode && frenteInternaModel.IdFrenteInterna > 0)
            {
                <!-- Líderes da Alocação Interna -->
                <LideresFrenteInterna @ref="lideresRef" 
                                     IdFrenteInterna="frenteInternaModel.IdFrenteInterna" 
                                     OnLideresChanged="OnLideresChanged" />

                <!-- Participantes da Alocação Interna -->
                <ParticipantesFrenteInterna @ref="participantesRef" 
                                           IdFrenteInterna="frenteInternaModel.IdFrenteInterna" 
                                           OnParticipantesChanged="OnParticipantesChanged" />
            }

            <div class="form-actions">
                <div class="text-right">
                    <button type="submit" class="btn btn-info" disabled="@isLoading">
                        @if (isLoading)
                        {
                            <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                            <span>Processando...</span>
                        }
                        else
                        {
                            @(isEditMode ? "Alterar" : "Cadastrar")
                        }
                    </button>
                    @if (isEditMode)
                    {
                        <button type="button" class="btn btn-secondary ml-2" @onclick="CancelarEdicao">
                            Cancelar
                        </button>
                    }
                </div>
            </div>
        </EditForm>
    </div>
</div>

@code {
    [Parameter] public EventCallback OnFrenteInternaSalva { get; set; }
    [Parameter] public EventCallback OnFrenteInternaEditada { get; set; }

    private FrenteInternaEditModel frenteInternaModel = new();
    private bool isEditMode = false;
    private bool isLoading = false;
    private LideresFrenteInterna? lideresRef;
    private ParticipantesFrenteInterna? participantesRef;

    private async Task HandleValidSubmit()
    {
        if (isLoading) return;

        try
        {
            isLoading = true;
            StateHasChanged();

            if (string.IsNullOrWhiteSpace(frenteInternaModel.Nome))
            {
                MessageBoxService.ShowWarning("Preencha o campo Frente Interna");
                return;
            }

            if (isEditMode)
            {
                await FrentesInternasService.AtualizarFrenteInternaAsync(frenteInternaModel);
                await OnFrenteInternaEditada.InvokeAsync();
            }
            else
            {
                var novaFrenteInterna = await FrentesInternasService.CriarFrenteInternaAsync(frenteInternaModel);
                frenteInternaModel.IdFrenteInterna = novaFrenteInterna.IdFrenteInterna;
                await OnFrenteInternaSalva.InvokeAsync();
            }

            LimparFormulario();
        }
        catch (Exception ex)
        {
            TelemetryService.TrackException(ex);
            MessageBoxService.ShowError($"Erro ao salvar frente interna: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    public async Task EditarFrenteInterna(FrenteInternaModel frenteInterna)
    {
        try
        {
            var frenteCompleta = await FrentesInternasService.ObterFrenteInternaPorIdAsync(frenteInterna.IdFrenteInterna);
            
            frenteInternaModel = new FrenteInternaEditModel
            {
                IdFrenteInterna = frenteCompleta.IdFrenteInterna,
                Nome = frenteCompleta.Nome,
                Status = frenteCompleta.Status
            };

            isEditMode = true;
            StateHasChanged();

            await Task.Delay(100); // Aguarda renderização
            
            if (lideresRef != null)
            {
                await lideresRef.RefreshAsync();
            }
            if (participantesRef != null)
            {
                await participantesRef.RefreshAsync();
            }
        }
        catch (Exception ex)
        {
            TelemetryService.TrackException(ex);
            MessageBoxService.ShowError($"Erro ao carregar dados para edição: {ex.Message}");
        }
    }

    private void CancelarEdicao()
    {
        LimparFormulario();
    }

    private void LimparFormulario()
    {
        frenteInternaModel = new FrenteInternaEditModel();
        isEditMode = false;
        StateHasChanged();
    }

    private async Task OnLideresChanged()
    {
        await Task.CompletedTask;
        StateHasChanged();
    }

    private async Task OnParticipantesChanged()
    {
        await Task.CompletedTask;
        StateHasChanged();
    }
}