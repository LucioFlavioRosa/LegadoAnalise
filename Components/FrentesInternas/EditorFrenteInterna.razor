@using Peers.Moderno.Services.FrentesInternas
@using Peers.Moderno.Services.Common
@using Peers.Moderno.Models
@inject IFrentesInternasService FrentesInternasService
@inject IMessageBoxService MessageBoxService
@inject ITelemetryService TelemetryService

<div class="card">
    <div class="card-body">
        <h4>Dados da Alocação Interna</h4>
        <EditForm Model="@frenteInterna" OnValidSubmit="@SalvarFrenteInterna">
            <DataAnnotationsValidator />
            <ValidationSummary />
            
            <div class="form-body">
                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label>Nome</label>
                            <InputText @bind-Value="frenteInterna.Nome" class="form-control" />
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label>Status</label>
                            <InputSelect @bind-Value="frenteInterna.Ativo" class="form-control">
                                <option value="true">Ativo</option>
                                <option value="false">Inativo</option>
                            </InputSelect>
                        </div>
                    </div>
                </div>
            </div>

            @if (modoEdicao && frenteInterna.Id > 0)
            {
                <!-- Líderes da Frente Interna -->
                <LideresFrenteInterna @ref="lideresRef" 
                                     IdFrenteInterna="frenteInterna.Id" 
                                     OnLideresAtualizados="OnLideresAtualizados" />

                <!-- Participantes da Frente Interna -->
                <ParticipantesFrenteInterna @ref="participantesRef" 
                                           IdFrenteInterna="frenteInterna.Id" 
                                           OnParticipantesAtualizados="OnParticipantesAtualizados" />
            }

            <div class="form-actions">
                <div class="text-right">
                    <button type="submit" class="btn btn-info">
                        @(modoEdicao ? "Alterar" : "Cadastrar")
                    </button>
                    @if (modoEdicao)
                    {
                        <button type="button" class="btn btn-secondary ml-2" @onclick="LimparFormulario">
                            Cancelar
                        </button>
                    }
                </div>
            </div>
        </EditForm>
    </div>
</div>

@code {
    [Parameter] public EventCallback OnFrenteInternaSalva { get; set; }
    [Parameter] public EventCallback OnFrenteInternaEditada { get; set; }

    private FrenteInternaModel frenteInterna = new();
    private bool modoEdicao = false;
    private LideresFrenteInterna? lideresRef;
    private ParticipantesFrenteInterna? participantesRef;

    public async Task EditarFrenteInterna(int idFrenteInterna)
    {
        try
        {
            var frente = await FrentesInternasService.ObterFrenteInternaPorIdAsync(idFrenteInterna);
            if (frente != null)
            {
                frenteInterna = frente;
                modoEdicao = true;
                StateHasChanged();
                
                await Task.Delay(100); // Aguarda renderização dos componentes filhos
                await lideresRef?.CarregarLideres()!;
                await participantesRef?.CarregarParticipantes()!;
            }
        }
        catch (Exception ex)
        {
            MessageBoxService.ShowError($"Erro ao carregar frente interna: {ex.Message}");
            TelemetryService.TrackException(ex);
        }
    }

    private async Task SalvarFrenteInterna()
    {
        try
        {
            if (string.IsNullOrWhiteSpace(frenteInterna.Nome))
            {
                MessageBoxService.ShowWarning("Preencha o campo Nome");
                return;
            }

            if (modoEdicao)
            {
                await FrentesInternasService.AtualizarFrenteInternaAsync(frenteInterna);
                await OnFrenteInternaEditada.InvokeAsync();
            }
            else
            {
                await FrentesInternasService.CriarFrenteInternaAsync(frenteInterna);
                await OnFrenteInternaSalva.InvokeAsync();
                LimparFormulario();
            }
        }
        catch (Exception ex)
        {
            MessageBoxService.ShowError($"Erro ao salvar frente interna: {ex.Message}");
            TelemetryService.TrackException(ex);
        }
    }

    private void LimparFormulario()
    {
        frenteInterna = new FrenteInternaModel();
        modoEdicao = false;
        StateHasChanged();
    }

    private async Task OnLideresAtualizados()
    {
        await InvokeAsync(StateHasChanged);
    }

    private async Task OnParticipantesAtualizados()
    {
        await InvokeAsync(StateHasChanged);
    }
}