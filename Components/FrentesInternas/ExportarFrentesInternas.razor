@using Peers.Moderno.Services.FrentesInternas
@using Peers.Moderno.Services.FrentesInternas.Common
@using Peers.Moderno.Services.Common
@inject IFrentesInternasService FrentesInternasService
@inject IExportHelper ExportHelper
@inject IMessageBoxService MessageBoxService
@inject ITelemetryService TelemetryService
@inject IJSRuntime JSRuntime

@if (exibirSecaoExportacao)
{
    <div class="card card-body">
        <h4 class="card-title">Exportar Avaliações de Alocações Internas</h4>
        <div class="form-actions">
            <button class="btn btn-facebook" @onclick="ExportarAvaliacoes" disabled="@exportando">
                @if (exportando)
                {
                    <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                    <span>Exportando...</span>
                }
                else
                {
                    <span>Exportar</span>
                }
            </button>
        </div>
    </div>
}

@code {
    private bool exibirSecaoExportacao = false;
    private bool exportando = false;
    private int usuarioLogadoId = 0;
    private int perfilUsuarioLogado = 0;

    protected override async Task OnInitializedAsync()
    {
        await VerificarPermissaoExportacao();
    }

    private async Task VerificarPermissaoExportacao()
    {
        try
        {
            // TODO: Implementar obtenção do usuário logado via serviço de autenticação
            // var usuarioLogado = await AuthService.ObterUsuarioLogado();
            // usuarioLogadoId = usuarioLogado.Id;
            // perfilUsuarioLogado = usuarioLogado.IdPerfil;
            
            // Verificar se o usuário tem permissão para exportar (perfil >= 3)
            exibirSecaoExportacao = perfilUsuarioLogado >= 3;
        }
        catch (Exception ex)
        {
            MessageBoxService.ShowError($"Erro ao verificar permissões de exportação: {ex.Message}");
            TelemetryService.TrackException(ex);
        }
    }

    private async Task ExportarAvaliacoes()
    {
        try
        {
            exportando = true;
            StateHasChanged();

            var avaliacoes = await FrentesInternasService.ObterAvaliacoesAlocacoesInternasAsync();
            
            if (avaliacoes?.Any() != true)
            {
                MessageBoxService.ShowWarning("Não há avaliações para exportar");
                return;
            }

            var nomeArquivo = $"AvaliacoesAlocacaoInterna_{DateTime.Now:yyyyMMdd_HHmmss}.xlsx";
            var bytesArquivo = await ExportHelper.GerarExcelAvaliacoesAsync(avaliacoes, nomeArquivo);

            await JSRuntime.InvokeVoidAsync("downloadFileFromByteArray", new
            {
                ByteArray = bytesArquivo,
                FileName = nomeArquivo,
                ContentType = "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"
            });

            MessageBoxService.ShowSuccess("Exportação realizada com sucesso!");
            TelemetryService.TrackEvent("ExportacaoAvaliacoesAlocacaoInterna", new Dictionary<string, string>
            {
                { "UsuarioId", usuarioLogadoId.ToString() },
                { "QuantidadeRegistros", avaliacoes.Count.ToString() },
                { "NomeArquivo", nomeArquivo }
            });
        }
        catch (Exception ex)
        {
            MessageBoxService.ShowError($"Erro ao exportar avaliações: {ex.Message}");
            TelemetryService.TrackException(ex);
        }
        finally
        {
            exportando = false;
            StateHasChanged();
        }
    }
}