@page "/frentes-internas"
@rendermode InteractiveAuto
@using Peers.Moderno.Services.FrentesInternas
@using Peers.Moderno.Services.Common
@inject IFrentesInternasService FrentesInternasService
@inject IMessageBoxService MessageBoxService
@inject ITelemetryService TelemetryService

<PageTitle>Alocações Internas</PageTitle>

<div class="page-breadcrumb border-bottom">
    <div class="row">
        <div class="col-lg-3 col-md-4 col-xs-12 align-self-center">
            <h5 class="font-medium text-uppercase mb-0">ALOCAÇÕES INTERNAS</h5>
        </div>
        <div class="col-lg-9 col-md-8 col-xs-12 align-self-center">
            <nav aria-label="breadcrumb" class="mt-2 float-md-right float-left">
                <ol class="breadcrumb mb-0 justify-content-end p-0">
                    <li class="breadcrumb-item"><a href="/">Peers / Gerenciar Métricas</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Alocações Internas</li>
                </ol>
            </nav>
        </div>
    </div>
</div>

<div class="page-content container-fluid">
    <!-- Editor de Frente Interna -->
    <EditorFrenteInterna @ref="editorRef" 
                        OnFrenteInternaSalva="OnFrenteInternaSalva" 
                        OnFrenteInternaEditada="OnFrenteInternaEditada" />

    <!-- Lista de Frentes Internas -->
    <ListaFrentesInternas @ref="listaRef" 
                         OnEditarFrenteInterna="OnEditarFrenteInterna" 
                         OnExcluirFrenteInterna="OnExcluirFrenteInterna" />

    <!-- Seção de Avaliação -->
    <AvaliarFrenteInterna @ref="avaliarRef" />

    <!-- Seção de Exportação -->
    <ExportarFrentesInternas @ref="exportarRef" />
</div>

@code {
    private EditorFrenteInterna? editorRef;
    private ListaFrentesInternas? listaRef;
    private AvaliarFrenteInterna? avaliarRef;
    private ExportarFrentesInternas? exportarRef;

    protected override async Task OnInitializedAsync()
    {
        TelemetryService.TrackPageView("FrentesInternas");
        await base.OnInitializedAsync();
    }

    private async Task OnFrenteInternaSalva()
    {
        await listaRef!.AtualizarLista();
        MessageBoxService.ShowSuccess("Frente interna salva com sucesso!");
    }

    private async Task OnFrenteInternaEditada()
    {
        await listaRef!.AtualizarLista();
        MessageBoxService.ShowSuccess("Frente interna atualizada com sucesso!");
    }

    private async Task OnEditarFrenteInterna(int idFrenteInterna)
    {
        await editorRef!.EditarFrenteInterna(idFrenteInterna);
    }

    private async Task OnExcluirFrenteInterna(int idFrenteInterna)
    {
        try
        {
            await FrentesInternasService.InativarFrenteInternaAsync(idFrenteInterna);
            await listaRef!.AtualizarLista();
            MessageBoxService.ShowSuccess("Frente interna inativada com sucesso!");
        }
        catch (Exception ex)
        {
            MessageBoxService.ShowError($"Erro ao inativar frente interna: {ex.Message}");
            TelemetryService.TrackException(ex);
        }
    }
}