@using Peers.Moderno.Services.FrentesInternas
@using Peers.Moderno.Services.Associados
@using Peers.Moderno.Services.Common
@using Peers.Moderno.Models
@inject IFrentesInternasService FrentesInternasService
@inject IAssociadosService AssociadosService
@inject IMessageBoxService MessageBoxService
@inject ITelemetryService TelemetryService

<div class="form-body">
    <br />
    <h4>Líderes da Alocação Interna</h4>
    
    @if (lideres?.Any() == true)
    {
        <table class="table table-striped border">
            <thead>
                <tr>
                    <th>IdAssociado</th>
                    <th>Líder</th>
                    <th>Status(Ativo/Inativo)</th>
                    <th>Ação</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var lider in lideres)
                {
                    <tr>
                        <td>@lider.IdAssociado</td>
                        <td>@lider.NomeAssociado</td>
                        <td>@(lider.Ativo ? "Ativo" : "Inativo")</td>
                        <td>
                            @if (lider.Ativo)
                            {
                                <button class="btn btn-dark" @onclick="() => InativarLider(lider.Id)">
                                    Inativar
                                </button>
                            }
                        </td>
                    </tr>
                }
                <tr>
                    <td colspan="3">
                        <select @bind="novoLiderIdAssociado" class="form-control">
                            <option value="0">Selecione um associado</option>
                            @if (associadosDisponiveis?.Any() == true)
                            {
                                @foreach (var associado in associadosDisponiveis)
                                {
                                    <option value="@associado.Id">@associado.Nome</option>
                                }
                            }
                        </select>
                    </td>
                    <td>
                        <button class="btn btn-dark" @onclick="AdicionarLider" disabled="@(novoLiderIdAssociado == 0)">
                            Adicionar
                        </button>
                    </td>
                </tr>
            </tbody>
        </table>
    }
    else
    {
        <div class="alert alert-info">
            <p>Nenhum líder cadastrado para esta alocação interna.</p>
            <div class="row">
                <div class="col-md-9">
                    <select @bind="novoLiderIdAssociado" class="form-control">
                        <option value="0">Selecione um associado</option>
                        @if (associadosDisponiveis?.Any() == true)
                        {
                            @foreach (var associado in associadosDisponiveis)
                            {
                                <option value="@associado.Id">@associado.Nome</option>
                            }
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <button class="btn btn-dark" @onclick="AdicionarLider" disabled="@(novoLiderIdAssociado == 0)">
                        Adicionar
                    </button>
                </div>
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public int IdFrenteInterna { get; set; }
    [Parameter] public EventCallback OnLideresAtualizados { get; set; }

    private List<LiderFrenteInternaModel>? lideres;
    private List<Associado>? associadosDisponiveis;
    private int novoLiderIdAssociado = 0;

    protected override async Task OnParametersSetAsync()
    {
        if (IdFrenteInterna > 0)
        {
            await CarregarLideres();
            await CarregarAssociadosDisponiveis();
        }
    }

    public async Task CarregarLideres()
    {
        try
        {
            lideres = await FrentesInternasService.ObterLideresFrenteInternaAsync(IdFrenteInterna);
            StateHasChanged();
        }
        catch (Exception ex)
        {
            MessageBoxService.ShowError($"Erro ao carregar líderes: {ex.Message}");
            TelemetryService.TrackException(ex);
        }
    }

    private async Task CarregarAssociadosDisponiveis()
    {
        try
        {
            associadosDisponiveis = await AssociadosService.ObterAssociadosAtivosAsync();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            MessageBoxService.ShowError($"Erro ao carregar associados: {ex.Message}");
            TelemetryService.TrackException(ex);
        }
    }

    private async Task AdicionarLider()
    {
        try
        {
            if (novoLiderIdAssociado == 0)
            {
                MessageBoxService.ShowWarning("Selecione um associado");
                return;
            }

            var novoLider = new LiderFrenteInternaModel
            {
                IdFrenteInterna = IdFrenteInterna,
                IdAssociado = novoLiderIdAssociado,
                Ativo = true
            };

            await FrentesInternasService.AdicionarLiderFrenteInternaAsync(novoLider);
            await CarregarLideres();
            novoLiderIdAssociado = 0;
            await OnLideresAtualizados.InvokeAsync();
            MessageBoxService.ShowSuccess("Líder adicionado com sucesso!");
        }
        catch (Exception ex)
        {
            MessageBoxService.ShowError($"Erro ao adicionar líder: {ex.Message}");
            TelemetryService.TrackException(ex);
        }
    }

    private async Task InativarLider(int idLiderFrenteInterna)
    {
        try
        {
            await FrentesInternasService.InativarLiderFrenteInternaAsync(idLiderFrenteInterna);
            await CarregarLideres();
            await OnLideresAtualizados.InvokeAsync();
            MessageBoxService.ShowSuccess("Líder inativado com sucesso!");
        }
        catch (Exception ex)
        {
            MessageBoxService.ShowError($"Erro ao inativar líder: {ex.Message}");
            TelemetryService.TrackException(ex);
        }
    }
}