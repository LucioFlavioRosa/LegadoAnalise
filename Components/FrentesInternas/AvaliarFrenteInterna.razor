@using Peers.Moderno.Services.FrentesInternas
@using Peers.Moderno.Services.Common
@using Peers.Moderno.Models
@inject IFrentesInternasService FrentesInternasService
@inject IMessageBoxService MessageBoxService
@inject ITelemetryService TelemetryService
@inject NavigationManager Navigation

@if (exibirSecaoAvaliacao)
{
    <div class="card card-body">
        <h4>Avaliar</h4>
        <h5>Siga o botão abaixo para avaliar os associados das alocações internas que você for líder no período de @periodoAtual</h5>
        <div class="form-actions">
            <button class="btn btn-facebook" @onclick="RedirecionarParaAvaliacao" style="width:20%">
                Avaliar
            </button>
        </div>
    </div>
}

@code {
    private bool exibirSecaoAvaliacao = false;
    private string periodoAtual = string.Empty;
    private int usuarioLogadoId = 0;

    protected override async Task OnInitializedAsync()
    {
        await VerificarPermissaoAvaliacao();
    }

    private async Task VerificarPermissaoAvaliacao()
    {
        try
        {
            // TODO: Implementar obtenção do usuário logado via serviço de autenticação
            // usuarioLogadoId = await AuthService.ObterUsuarioLogadoId();
            
            // Verificar se o usuário é líder de alguma frente interna
            var frentesLideradas = await FrentesInternasService.ObterFrentesLideradasPorUsuarioAsync(usuarioLogadoId);
            
            if (frentesLideradas?.Any() == true)
            {
                exibirSecaoAvaliacao = true;
                periodoAtual = await FrentesInternasService.ObterPeriodoAtualAsync();
            }
        }
        catch (Exception ex)
        {
            MessageBoxService.ShowError($"Erro ao verificar permissões de avaliação: {ex.Message}");
            TelemetryService.TrackException(ex);
        }
    }

    private void RedirecionarParaAvaliacao()
    {
        try
        {
            Navigation.NavigateTo("/avaliacao-frentes-internas");
        }
        catch (Exception ex)
        {
            MessageBoxService.ShowError($"Erro ao redirecionar para avaliação: {ex.Message}");
            TelemetryService.TrackException(ex);
        }
    }
}