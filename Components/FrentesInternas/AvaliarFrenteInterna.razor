@using Peers.Moderno.Services.FrentesInternas
@using Peers.Moderno.Services.Common
@using Peers.Moderno.Models
@inject IFrentesInternasService FrentesInternasService
@inject IMessageBoxService MessageBoxService
@inject ITelemetryService TelemetryService
@inject NavigationManager NavigationManager

@if (exibirSecaoAvaliacao)
{
    <div class="card card-body">
        <h4>Avaliar</h4>
        <h5>Siga o botão abaixo para avaliar os associados das alocações internas que você for líder no período de @periodoAtual</h5>
        <div class="form-actions">
            <button class="btn btn-facebook" style="width:20%" @onclick="RedirecionarParaAvaliacao" disabled="@isProcessing">
                @if (isProcessing)
                {
                    <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                    <span>Carregando...</span>
                }
                else
                {
                    <span>Avaliar</span>
                }
            </button>
        </div>
    </div>
}

@code {
    private bool exibirSecaoAvaliacao = false;
    private string periodoAtual = string.Empty;
    private bool isProcessing = false;

    protected override async Task OnInitializedAsync()
    {
        await VerificarPermissaoAvaliacao();
    }

    private async Task VerificarPermissaoAvaliacao()
    {
        try
        {
            // TODO: Implementar verificação de usuário logado e suas frentes lideradas
            // var usuarioLogado = await ObterUsuarioLogado();
            // var frentesLideradas = await FrentesInternasService.ObterFrentesLideradasPorUsuarioAsync(usuarioLogado.Id);
            
            // Por enquanto, simular verificação
            var temFrentesLideradas = await FrentesInternasService.UsuarioTemFrentesLideradasAsync();
            
            if (temFrentesLideradas)
            {
                exibirSecaoAvaliacao = true;
                periodoAtual = await FrentesInternasService.ObterPeriodoAtualAsync();
            }
            else
            {
                exibirSecaoAvaliacao = false;
            }
        }
        catch (Exception ex)
        {
            TelemetryService.TrackException(ex);
            MessageBoxService.ShowError($"Erro ao verificar permissões de avaliação: {ex.Message}");
            exibirSecaoAvaliacao = false;
        }
        finally
        {
            StateHasChanged();
        }
    }

    private async Task RedirecionarParaAvaliacao()
    {
        if (isProcessing) return;

        try
        {
            isProcessing = true;
            StateHasChanged();

            TelemetryService.TrackEvent("FrenteInterna_IniciarAvaliacao");
            
            // Redirecionar para página de avaliação
            NavigationManager.NavigateTo("/avaliacao-frentes-internas");
        }
        catch (Exception ex)
        {
            TelemetryService.TrackException(ex);
            MessageBoxService.ShowError($"Erro ao redirecionar para avaliação: {ex.Message}");
        }
        finally
        {
            isProcessing = false;
            StateHasChanged();
        }
    }

    public async Task RefreshAsync()
    {
        await VerificarPermissaoAvaliacao();
    }
}