@page "/avaliacoes-gestorascegas-performance"
@rendermode InteractiveAuto

@inject Services.AvaliacoesGestorasCegas.IAvaliacaoGestorasCegasPerformanceService AvaliacaoService
@inject Services.Common.IMessageBoxService MessageBoxService
@inject NavigationManager Navigation

<PageTitle>Avaliação às Cegas - Performance</PageTitle>

<div class="page-breadcrumb border-bottom">
    <div class="row">
        <div class="col-lg-3 col-md-4 col-xs-12 align-self-center">
            <h5 class="font-medium text-uppercase mb-0">Avaliação às Cegas</h5>
        </div>
        <div class="col-lg-9 col-md-8 col-xs-12 align-self-center">
            <nav aria-label="breadcrumb" class="mt-2 float-md-right float-left">
                <ol class="breadcrumb mb-0 justify-content-end p-0">
                    <li class="breadcrumb-item"><a href="/">Peers</a></li>
                    <li class="breadcrumb-item"><a href="/avaliacoes-gestorascegas">Avaliação / Avaliação às Cegas</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Performance</li>
                </ol>
            </nav>
        </div>
    </div>
</div>

<div class="page-content container-fluid">
    <div class="card">
        <div class="card-body">
            <div class="form-body">
                <div class="row">
                    <div class="col-md-4">
                        <div class="text-left">
                            <button class="btn btn-danger" @onclick="IrCompetencia">Competência</button>
                            <button class="btn btn-facebook" disabled>Performance</button>
                            <button class="btn btn-info" @onclick="Finalizar">Ir para Finalização</button>
                        </div>
                    </div>
                    <div class="col-sm">
                        <div class="row">
                            <div class="col-md-1"><label><b>Avaliado</b></label></div>
                            <div class="col-md-3"><label>@Cabecalho?.AssociadoNome</label></div>
                            <div class="col-md-1"><label><b>Período</b></label></div>
                            <div class="col-md-3"><label>@Cabecalho?.PeriodoNome</label></div>
                            <div class="col-md-1"><label><b>Gestor</b></label></div>
                            <div class="col-md-3"><label>@Cabecalho?.GestorNome</label></div>
                        </div>
                        <div class="row">
                            <div class="col-md-2"><label><b>Tempo de Cargo:</b></label></div>
                            <div class="col-md-4"><label>@Cabecalho?.TempoCargo</label></div>
                            <div class="col-md-2"><label><b>Tempo de Peers</b></label></div>
                            <div class="col-md-4"><label>@Cabecalho?.TempoPeers</label></div>
                        </div>
                        <div class="row">
                            <div class="col-md-1"><label><b>Projeto</b></label></div>
                            <div class="col-md-3"><label>@Cabecalho?.ProjetoNome</label></div>
                            <div class="col-md-1"><label><b>Cliente</b></label></div>
                            <div class="col-md-3"><label>@Cabecalho?.ClienteNome</label></div>
                            <div class="col-md-2"><label><b>Tempo restante</b></label></div>
                            <div class="col-md-2"><label>@Cabecalho?.TempoRestante</label></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-body">
            <div class="form-body">
                <div class="row">
                    <div class="col-md-4 offset-md-8">
                        <div class="text-right">
                            <button class="btn btn-dark" @onclick="Salvar">Salvar Avaliação</button>
                        </div>
                    </div>
                </div>
            </div>
            <br />
            <PerformanceTable Items="Performances" OnNotaChanged="OnNotaChanged" OnObservacaoChanged="OnObservacaoChanged" />
            <div class="form-body">
                <div class="row">
                    <div class="col-md-4 offset-md-8">
                        <div class="text-right">
                            <button class="btn btn-dark" @onclick="Salvar">Salvar Avaliação</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="card">
        <div class="card-body">
            <div class="col-md-5">
                <div class="text-left">
                    <button class="btn btn-danger" @onclick="IrCompetencia">Competência</button>
                    <button class="btn btn-facebook" disabled>Performance</button>
                    <button class="btn btn-info" @onclick="Finalizar">Ir para Finalização</button>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private CabecalhoAvaliacaoGestorasCegasPerformanceDto? Cabecalho;
    private List<PerformanceAvaliacaoGestorasCegasDto> Performances = new();

    protected override async Task OnInitializedAsync()
    {
        Cabecalho = await AvaliacaoService.GetDadosCabecalhoAsync();
        Performances = await AvaliacaoService.GetListaPerformancesAsync();
    }

    private async Task Salvar()
    {
        var result = await AvaliacaoService.SalvarAvaliacaoAsync(Performances);
        if (result.Sucesso)
            MessageBoxService.ShowSuccess(result.Mensagem);
        else
            MessageBoxService.ShowError(result.Mensagem);
    }

    private async Task Finalizar()
    {
        var result = await AvaliacaoService.FinalizarAvaliacaoAsync(Performances);
        if (result.Sucesso)
        {
            MessageBoxService.ShowSuccess(result.Mensagem);
            Navigation.NavigateTo("/avaliacoes-gestorascegas");
        }
        else
        {
            MessageBoxService.ShowError(result.Mensagem);
        }
    }

    private void IrCompetencia()
    {
        Navigation.NavigateTo("/avaliacoes-gestorascegas-competencia");
    }

    private void OnNotaChanged(int idPerformance, int? nota)
    {
        var perf = Performances.FirstOrDefault(p => p.IdPerformance == idPerformance);
        if (perf != null)
            perf.Nota = nota;
    }

    private void OnObservacaoChanged(int idPerformance, string? obs)
    {
        var perf = Performances.FirstOrDefault(p => p.IdPerformance == idPerformance);
        if (perf != null)
            perf.Observacao = obs;
    }
}
