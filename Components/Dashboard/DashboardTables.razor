@using Peers.Moderno.Models

<div class="row">
    <div class="col-xl-4 col-lg-4">
        <div class="card shadow">
            <div class="card-header py-3 d-flex flex-row align-items-center justify-content-between">
                <h6 class="m-0 font-weight-bold text-primary">Andamento das Avaliações</h6>
            </div>
            <div class="card-body">
                <div class="table-responsive" style="clear: both;">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>Status</th>
                                <th class="text-center">Qtd.</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in AndamentoData)
                            {
                                <tr>
                                    <td>@item.Status</td>
                                    <td class="text-center">@item.QtdStatus</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xl-8 col-lg-8">
        <div class="card shadow">
            <div class="card-header py-3">
                <h6 class="m-0 font-weight-bold text-primary">Avaliados por Projeto</h6>
            </div>
            <div class="card-body" style="overflow-y: scroll; height: 300px; width: auto;">
                <div class="table-responsive" style="clear: both;">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>Projeto</th>
                                <th class="text-center">Qtd.</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in ProjetosData)
                            {
                                <tr>
                                    <td>@item.Status</td>
                                    <td class="text-center">@item.QtdStatus</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter] public List<DashboardItemModel> AndamentoData { get; set; } = new();
    [Parameter] public List<DashboardItemModel> ProjetosData { get; set; } = new();
}