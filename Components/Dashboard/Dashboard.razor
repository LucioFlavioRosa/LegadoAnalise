@page "/dashboard"
@using Peers.Moderno.Services.Dashboard
@using Peers.Moderno.Services.Common
@using Peers.Moderno.Models
@inject IDashboardService DashboardService
@inject IMessageBoxService MessageBoxService
@inject IJSRuntime JSRuntime
@rendermode InteractiveAuto

<PageTitle>Dashboard - Sistema de Avaliação</PageTitle>

<div class="page-breadcrumb border-bottom">
    <div class="row">
        <div class="col-lg-3 col-md-4 col-xs-12 align-self-center">
            <h5 class="font-medium text-uppercase mb-0">Dashboard</h5>
        </div>
        <div class="col-lg-9 col-md-8 col-xs-12 align-self-center">
            <nav aria-label="breadcrumb" class="mt-2 float-md-right float-left">
                <ol class="breadcrumb mb-0 justify-content-end p-0">
                    <li class="breadcrumb-item"><a href="/">Peers</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Dashboard</li>
                </ol>
            </nav>
        </div>
    </div>
</div>

<div class="page-content container-fluid">
    @if (isLoading)
    {
        <div class="text-center">
            <div class="spinner-border" role="status">
                <span class="sr-only">Carregando...</span>
            </div>
        </div>
    }
    else
    {
        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-body">
                        <div class="form-body">
                            <div class="row">
                                <div class="col-md-3">
                                    <div class="form-group">
                                        <label>Período</label>
                                        <select class="form-control" @bind="selectedPeriodoId" @bind:after="OnPeriodoChanged">
                                            @foreach (var periodo in periodos)
                                            {
                                                <option value="@periodo.IdPeriodo">@periodo.Periodo</option>
                                            }
                                        </select>
                                    </div>
                                </div>
                                <div class="col-md-2">
                                    <button type="button" class="btn btn-danger" style="margin-top: 30px" @onclick="CarregarDashboard">
                                        Trocar Período
                                    </button>
                                </div>
                                <div class="col-md-7 text-center">
                                    <h4 class="card-title" style="margin-top: 40px">
                                        @periodoAtual
                                    </h4>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <DashboardCards Numeros="@numeros" />
        <DashboardCharts AndamentoJson="@andamentoJson" 
                        AvaliadosJson="@avaliadosJson" 
                        CompetenciaJson="@competenciaJson" 
                        PerformanceJson="@performanceJson" />
        <DashboardTables AndamentoData="@andamentoData" ProjetosData="@projetosData" />
    }
</div>

@code {
    private bool isLoading = true;
    private int selectedPeriodoId;
    private string periodoAtual = string.Empty;
    private List<Periodo> periodos = new();
    private DashboardModel numeros = new();
    private List<DashboardItemModel> andamentoData = new();
    private List<DashboardItemModel> projetosData = new();
    private string andamentoJson = string.Empty;
    private string avaliadosJson = string.Empty;
    private string competenciaJson = string.Empty;
    private string performanceJson = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await CarregarPeriodos();
            await CarregarDashboard();
        }
        catch (Exception ex)
        {
            MessageBoxService.ShowError($"Erro ao carregar o Dashboard: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task CarregarPeriodos()
    {
        periodos = await DashboardService.ObterPeriodosAsync(1); // TODO: Obter IdEmpresa do usuário logado
        var periodoAtualObj = await DashboardService.ObterPeriodoAtualAsync();
        selectedPeriodoId = periodoAtualObj.IdPeriodo;
    }

    private async Task CarregarDashboard()
    {
        if (selectedPeriodoId <= 0)
        {
            MessageBoxService.ShowWarning("Período não selecionado!");
            return;
        }

        try
        {
            isLoading = true;
            StateHasChanged();

            var periodo = await DashboardService.ObterPeriodoAsync(selectedPeriodoId);
            periodoAtual = $"{periodo.DataInicio?.ToString("dd/MM/yyyy")} - {periodo.DataFim?.ToString("dd/MM/yyyy")}";

            numeros = await DashboardService.ObterNumerosAsync(selectedPeriodoId);
            
            var andamento = await DashboardService.ObterAndamentoAvaliacoesAsync(selectedPeriodoId);
            andamentoData = andamento.ListAndamento ?? new List<DashboardItemModel>();
            
            var projetos = await DashboardService.ObterAvaliadosPorProjetoAsync(selectedPeriodoId);
            projetosData = projetos.FirstOrDefault()?.ListAndamento ?? new List<DashboardItemModel>();

            // Preparar dados para gráficos (será implementado no componente DashboardCharts)
            // andamentoJson, avaliadosJson, competenciaJson, performanceJson serão populados
        }
        catch (Exception ex)
        {
            MessageBoxService.ShowError($"Erro ao carregar dados do Dashboard: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task OnPeriodoChanged()
    {
        await CarregarDashboard();
    }
}