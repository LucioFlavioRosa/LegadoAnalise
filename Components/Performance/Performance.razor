@page "/performance"
@using Peers.Moderno.Models
@using Peers.Moderno.Services.Performance
@using Peers.Moderno.Services.Common
@using Peers.Moderno.Services.Cargos
@using Peers.Moderno.Services.Avaliacoes
@inject IPerformanceService PerformanceService
@inject ICargosService CargosService
@inject IAvaliacoesService AvaliacoesService
@inject IMessageBoxService MessageBoxService
@inject ITelemetryService TelemetryService
@inject IJSRuntime JSRuntime
@inherits PerformanceBase

<PageTitle>Performance</PageTitle>

<div class="page-breadcrumb border-bottom">
    <div class="row">
        <div class="col-lg-3 col-md-4 col-xs-12 align-self-center">
            <h5 class="font-medium text-uppercase mb-0">Performance</h5>
        </div>
        <div class="col-lg-9 col-md-8 col-xs-12 align-self-center">
            <nav aria-label="breadcrumb" class="mt-2 float-md-right float-left">
                <ol class="breadcrumb mb-0 justify-content-end p-0">
                    <li class="breadcrumb-item"><a href="/">Peers / Cadastro Básico de Projetos</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Performance</li>
                </ol>
            </nav>
        </div>
    </div>
</div>

<div class="page-content container-fluid">
    <!-- Formulário de Cadastro -->
    <div class="card">
        <div class="card-body">
            <h4 class="card-title">Dados da performance</h4>
            <EditForm Model="@CurrentPerformance" OnValidSubmit="@HandleSubmit">
                <DataAnnotationsValidator />
                <ValidationSummary />
                
                <div class="form-body">
                    <div class="row">
                        <div class="col-md-3">
                            <div class="form-group">
                                <label>Cargo</label>
                                <InputSelect @bind-Value="CurrentPerformance.IdCargo" class="form-control select2" style="width: 100%">
                                    <option value="0">[Selecionar]</option>
                                    @foreach (var cargo in Cargos)
                                    {
                                        <option value="@cargo.IdCargo">@cargo.Nome</option>
                                    }
                                </InputSelect>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group">
                                <label>Status</label>
                                <InputSelect @bind-Value="CurrentPerformance.ATV" class="form-control" style="width: 100%">
                                    <option value="1">Ativo</option>
                                    <option value="0">Inativo</option>
                                </InputSelect>
                            </div>
                        </div>
                    </div>
                    
                    <div class="row">
                        <div class="col-sm">
                            <div class="form-group">
                                <label>Performance</label>
                                <InputText @bind-Value="CurrentPerformance.Nome" class="form-control" />
                            </div>
                        </div>
                        <div class="col-sm">
                            <div class="form-group">
                                <label>Abrangência</label>
                                <InputSelect @bind-Value="CurrentPerformance.Abrangencia" class="form-control" style="width: 100%">
                                    <option value="Individual">Individual</option>
                                    <option value="Coletivo">Coletivo</option>
                                </InputSelect>
                            </div>
                        </div>
                    </div>
                    
                    <div class="row">
                        <div class="col-md-4">
                            <div class="form-group">
                                <label>Abaixo</label>
                                <InputText @bind-Value="CurrentPerformance.PerformanceAbaixo" class="form-control" />
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group">
                                <label>Esperado</label>
                                <InputText @bind-Value="CurrentPerformance.PerformanceEsperado" class="form-control" />
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group">
                                <label>Acima</label>
                                <InputText @bind-Value="CurrentPerformance.PerformanceAcima" class="form-control" />
                            </div>
                        </div>
                    </div>
                    
                    <!-- Seção de Inputs de Avaliação -->
                    <div class="row">
                        <div class="col-md-4">
                            <div class="form-group">
                                <label>Input auto-avaliação</label>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group">
                                <label>Input avaliação às cegas</label>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group">
                                <label>Input avaliação do gestor</label>
                            </div>
                        </div>
                    </div>
                    
                    <div class="row" style="margin-top:-16px">
                        <!-- Auto Avaliação -->
                        <div class="col-sm">
                            <div class="form-group">
                                <InputCheckbox @bind-Value="CurrentPerformance.InputAutoavaliacao" 
                                             @onchange="@((ChangeEventArgs e) => OnInputCheckboxChanged(0, (bool)e.Value!))"
                                             style="transform: scale(2.1); margin-left:7px" />
                            </div>
                        </div>
                        <div class="col-sm">
                            <div class="form-group" style="margin-left:-100px">
                                <label style="@GetNotaPadraoLabelStyle(CurrentPerformance.InputAutoavaliacao)">Nota padrão:</label>
                            </div>
                        </div>
                        <div class="col-2">
                            <div class="form-group" style="@GetNotaPadraoDivStyle(CurrentPerformance.InputAutoavaliacao)">
                                <InputSelect @bind-Value="CurrentPerformance.NotaPadraoAutoAvaliacao" class="form-control" style="width: 100%">
                                    <option value="">[Selecionar]</option>
                                    @foreach (var nota in NotasPerformance)
                                    {
                                        <option value="@nota.IdNota">@nota.CodigoNota</option>
                                    }
                                </InputSelect>
                            </div>
                        </div>
                        
                        <!-- Avaliação às Cegas -->
                        <div class="col-sm">
                            <div class="form-group">
                                <InputCheckbox @bind-Value="CurrentPerformance.InputAvaliacaoAsCegas" 
                                             @onchange="@((ChangeEventArgs e) => OnInputCheckboxChanged(1, (bool)e.Value!))"
                                             style="transform: scale(2.1); margin-left:7px" />
                            </div>
                        </div>
                        <div class="col-sm">
                            <div class="form-group" style="margin-left:-100px">
                                <label style="@GetNotaPadraoLabelStyle(CurrentPerformance.InputAvaliacaoAsCegas)">Nota padrão:</label>
                            </div>
                        </div>
                        <div class="col-2">
                            <div class="form-group" style="@GetNotaPadraoDivStyle(CurrentPerformance.InputAvaliacaoAsCegas)">
                                <InputSelect @bind-Value="CurrentPerformance.NotaPadraoAvaliacaoAsCegas" class="form-control" style="width: 100%">
                                    <option value="">[Selecionar]</option>
                                    @foreach (var nota in NotasPerformance)
                                    {
                                        <option value="@nota.IdNota">@nota.CodigoNota</option>
                                    }
                                </InputSelect>
                            </div>
                        </div>
                        
                        <!-- Avaliação do Gestor -->
                        <div class="col-sm">
                            <div class="form-group">
                                <InputCheckbox @bind-Value="CurrentPerformance.InputAvaliacaoGestor" 
                                             @onchange="@((ChangeEventArgs e) => OnInputCheckboxChanged(2, (bool)e.Value!))"
                                             style="transform: scale(2.1); margin-left:7px" />
                            </div>
                        </div>
                        <div class="col-sm">
                            <div class="form-group" style="margin-left:-100px">
                                <label style="@GetNotaPadraoLabelStyle(CurrentPerformance.InputAvaliacaoGestor)">Nota padrão:</label>
                            </div>
                        </div>
                        <div class="col-2">
                            <div class="form-group" style="@GetNotaPadraoDivStyle(CurrentPerformance.InputAvaliacaoGestor)">
                                <InputSelect @bind-Value="CurrentPerformance.NotaPadraoAvaliacaoGestor" class="form-control" style="width: 100%">
                                    <option value="">[Selecionar]</option>
                                    @foreach (var nota in NotasPerformance)
                                    {
                                        <option value="@nota.IdNota">@nota.CodigoNota</option>
                                    }
                                </InputSelect>
                            </div>
                        </div>
                    </div>
                    
                    <div class="form-actions">
                        <div class="text-right">
                            <button type="submit" class="btn btn-info" disabled="@IsLoading">
                                @if (IsLoading)
                                {
                                    <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                                    <span>Processando...</span>
                                }
                                else
                                {
                                    <span>@(IsEditing ? "Salvar" : "Cadastrar")</span>
                                }
                            </button>
                            @if (IsEditing)
                            {
                                <button type="button" class="btn btn-secondary ml-2" @onclick="CancelEdit">
                                    Cancelar
                                </button>
                            }
                        </div>
                    </div>
                </div>
            </EditForm>
        </div>
    </div>
    
    <!-- Seção de Export/Import -->
    <div class="card">
        <div class="card-body">
            <h4 class="card-title">Exportar e Importar Performances</h4>
            <h6 class="card-subtitle">Utilize o modelo de arquivo exportado para alterar ou adicionar competências.</h6>
            <h6 class="card-subtitle">Mantenha uma linha SEM um valor na coluna IdPerformance para adicionar uma nova performance.</h6>
            <h6 class="card-subtitle">O cargo deve ser identificado pelo ID.</h6>
            <h6 class="card-subtitle">Para fazer com que uma etapa possua uma nota padrão sem preenchimento do usuário, indique a coluna INPUT da etapa com o valor 0 e identifique o IdNotaPadrao na próxima coluna.</h6>
            <h6 class="card-subtitle">NÃO altere a ordem e quantidade das colunas, a quantidade de abas do arquivo ou coloque linhas acima da linha de títulos.</h6>
            
            <div class="mt-3">
                <button type="button" class="btn btn-info mr-2" @onclick="ExportPerformances" disabled="@IsLoading">
                    @if (IsExporting)
                    {
                        <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                        <span>Exportando...</span>
                    }
                    else
                    {
                        <span>Exportar</span>
                    }
                </button>
                
                <button type="button" class="btn btn-info mr-2" @onclick="TriggerFileUpload" disabled="@IsLoading">
                    Importar
                </button>
                
                <InputFile OnChange="@HandleFileUpload" @ref="fileUploadInput" accept=".xlsx" class="d-none" />
            </div>
        </div>
    </div>
    
    <!-- Lista de Performances -->
    <div class="card">
        <div class="card-body">
            <h4 class="card-title">Lista de Performance</h4>
            <h6 class="card-subtitle">Filtre as informações separadas por espaço para busca em qualquer coluna em qualquer ordem, completo ou parcial: <code>performance código</code>.</h6>
            
            @if (IsLoadingList)
            {
                <div class="text-center p-4">
                    <div class="spinner-border" role="status">
                        <span class="sr-only">Carregando...</span>
                    </div>
                </div>
            }
            else if (Performances.Any())
            {
                <div class="table-responsive">
                    <table class="table table-striped border dtInit">
                        <thead>
                            <tr>
                                <th>Código</th>
                                <th>Performance</th>
                                <th>Cargo</th>
                                <th>Nível</th>
                                <th>Status(Ativo/Inativo)</th>
                                <th data-sort="0">Ação</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var performance in Performances)
                            {
                                <tr>
                                    <td>@performance.IdPerformance</td>
                                    <td>@performance.Nome</td>
                                    <td>@performance.Cargo?.Nome</td>
                                    <td>@performance.CargoNivel?.Nivel</td>
                                    <td>@(performance.ATV == 1 ? "Ativo" : "Inativo")</td>
                                    <td>
                                        <button class="btn btn-info btn-sm mr-1" @onclick="() => EditPerformance(performance.IdPerformance)">
                                            Alterar
                                        </button>
                                        @if (performance.ATV == 1)
                                        {
                                            <button class="btn btn-dark btn-sm" @onclick="() => InactivatePerformance(performance.IdPerformance)">
                                                Inativar
                                            </button>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr>
                                <th>Código</th>
                                <th>Performance</th>
                                <th>Cargo</th>
                                <th>Nível</th>
                                <th>Status(Ativo/Inativo)</th>
                                <th data-sort="0">Ação</th>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            }
            else
            {
                <div class="alert alert-info" role="alert">
                    Nenhuma performance encontrada.
                </div>
            }
        </div>
    </div>
</div>

@* Scripts necessários para compatibilidade *@
<script src="~/assets/libs/jquery/dist/jquery.min.js"></script>
<script src="~/dist/js/app.min.js"></script>
<script src="~/dist/js/app.init.js"></script>
<script src="~/dist/js/app-style-switcher.js"></script>
<script src="~/assets/libs/perfect-scrollbar/dist/perfect-scrollbar.jquery.min.js"></script>
<script src="~/assets/extra-libs/sparkline/sparkline.js"></script>
<script src="~/dist/js/waves.js"></script>
<script src="~/assets/extra-libs/datatables.net/js/jquery.dataTables.min.js"></script>
<script src="~/assets/libs/select2/dist/js/select2.full.min.js"></script>
<script src="~/dist/js/custom.min.js"></script>

<script>
    window.blazorCulture = {
        get: () => window.localStorage['BlazorCulture'],
        set: (value) => window.localStorage['BlazorCulture'] = value
    };
    
    window.downloadFile = (filename, contentStreamReference) => {
        const arrayBuffer = contentStreamReference;
        const blob = new Blob([arrayBuffer]);
        const url = URL.createObjectURL(blob);
        const anchorElement = document.createElement('a');
        anchorElement.href = url;
        anchorElement.download = filename ?? '';
        anchorElement.click();
        anchorElement.remove();
        URL.revokeObjectURL(url);
    };
</script>