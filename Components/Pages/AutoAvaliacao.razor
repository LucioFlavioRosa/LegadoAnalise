@page "/autoavaliacao"
@using Peers.Moderno.Services.Avaliacoes
@using Peers.Moderno.Services.Avaliacoes.Common
@using Peers.Moderno.Services.Common
@using Peers.Moderno.Models
@rendermode InteractiveAuto
@inject IAutoAvaliacaoService AutoAvaliacaoService
@inject IMessageBoxService MessageBoxService
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime

<PageTitle>Auto Avaliação</PageTitle>

<div class="page-breadcrumb border-bottom">
    <div class="row">
        <div class="col-lg-3 col-md-4 col-xs-12 align-self-center">
            <h5 class="font-medium text-uppercase mb-0">Auto Avaliação</h5>
        </div>
        <div class="col-lg-9 col-md-8 col-xs-12 align-self-center">
            <nav aria-label="breadcrumb" class="mt-2 float-md-right float-left">
                <ol class="breadcrumb mb-0 justify-content-end p-0">
                    <li class="breadcrumb-item"><a href="/">Peers</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Avaliação / Auto Avaliação</li>
                </ol>
            </nav>
        </div>
    </div>
</div>

<div class="page-content container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-body">
                    <h4 class="card-title">Filtro avaliações</h4>
                    
                    <div class="form-body" style="position:sticky;z-index:1;top:0">
                        <div class="row">
                            <div class="col-md-3">
                                <div class="form-group">
                                    <label>Projeto</label>
                                    <select @bind="ProjetoSelecionado" class="form-control p-0 select2" style="width: 100%">
                                        @foreach (var projeto in Projetos)
                                        {
                                            <option value="@projeto.Value">@projeto.Text</option>
                                        }
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="form-group">
                                    <label>Cliente</label>
                                    <select @bind="ClienteSelecionado" class="form-control p-0 select2" style="width: 100%">
                                        @foreach (var cliente in Clientes)
                                        {
                                            <option value="@cliente.Value">@cliente.Text</option>
                                        }
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-2">
                                <div class="form-group">
                                    <label>Período</label>
                                    <select @bind="PeriodoSelecionado" class="form-control p-0 select2" style="width: 100%">
                                        @foreach (var periodo in Periodos)
                                        {
                                            <option value="@periodo.Value">@periodo.Text</option>
                                        }
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-2">
                                <div class="form-group">
                                    <label>Status</label>
                                    <select @bind="StatusSelecionado" class="form-control p-0 select2" style="width: 100%">
                                        @foreach (var status in StatusList)
                                        {
                                            <option value="@status.Value">@status.Text</option>
                                        }
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-2">
                                <button type="button" @onclick="FiltrarAvaliacoes" style="margin-top: 30px" class="btn btn-danger">
                                    Filtrar
                                </button>
                            </div>
                        </div>
                    </div>

                    <div class="table-responsive">
                        @if (ProjetosAvaliacao != null && ProjetosAvaliacao.Any())
                        {
                            <table class="table table-striped border dtInit">
                                <thead>
                                    <tr>
                                        <th>Código</th>
                                        <th>Projeto</th>
                                        <th>Cliente</th>
                                        <th>Status(Ativo/Inativo)</th>
                                        <th>Dt. Início Projeto</th>
                                        <th>Dt. Término Projeto</th>
                                        <th>Responsável</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var projeto in ProjetosAvaliacao)
                                    {
                                        <tr>
                                            <td>@projeto.Id</td>
                                            <td>@projeto.Nome</td>
                                            <td>@projeto.Cliente?.Nome</td>
                                            <td>@projeto.Status?.Nome</td>
                                            <td>@projeto.DataInicio</td>
                                            <td>@projeto.DataTermino</td>
                                            <td>@projeto.Responsavel?.Nome</td>
                                        </tr>
                                        <tr>
                                            <td>&nbsp;</td>
                                            <td colspan="6">
                                                @if (projeto.Associados != null && projeto.Associados.Any())
                                                {
                                                    <table class="table table-striped border dtInit">
                                                        <thead>
                                                            <tr>
                                                                <th>Foto</th>
                                                                <th>Profissional</th>
                                                                <th>Cargo</th>
                                                                <th>Período</th>
                                                                <th>Início</th>
                                                                <th>Término</th>
                                                                <th>Gestor</th>
                                                                <th>Avaliador</th>
                                                                <th>Mentor</th>
                                                                <th>Etapa</th>
                                                                <th></th>
                                                            </tr>
                                                        </thead>
                                                        <tbody>
                                                            @foreach (var associado in projeto.Associados)
                                                            {
                                                                <tr>
                                                                    <td>
                                                                        <img src="@(associado.FotoAssociado?.Imagem ?? "assets/images/users/usernophoto.jpg")" width="120" height="120" />
                                                                    </td>
                                                                    <td>@associado.Associado?.Nome</td>
                                                                    <td>@associado.Associado?.Cargo?.Nome</td>
                                                                    <td>@associado.Periodo?.Nome</td>
                                                                    <td>@associado.DataInicio</td>
                                                                    <td>@associado.DataTermino</td>
                                                                    <td>@associado.Gestor?.Nome</td>
                                                                    <td>@associado.Avaliador?.Nome</td>
                                                                    <td>@associado.Associado?.Mentor?.Nome</td>
                                                                    <td>@associado.Etapa</td>
                                                                    <td style="text-align:right;">
                                                                        <br />
                                                                        <a href="/autoavalizacao_competencia?IdProjeto=@associado.Projeto?.Id&IdAssociado=@associado.Associado?.Id&IdPeriodo=@associado.Periodo?.Id&TipoAvaliacao=@associado.TipoAvaliacao&Escopo=@associado.Escopo&idGestor=@associado.Gestor?.Id">
                                                                            <button type="button" class="btn btn-info" style="@(associado.IsHidden ? "display:none" : "")">@associado.RotuloBotao</button>
                                                                        </a>
                                                                        @if (associado.ExibirBotaoFinalizar)
                                                                        {
                                                                            <button type="button" @onclick="() => FinalizarAvaliacao(associado.IdEmail)" class="btn btn-dark">
                                                                                Finalizar Avaliação
                                                                            </button>
                                                                        }
                                                                    </td>
                                                                </tr>
                                                            }
                                                        </tbody>
                                                    </table>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }
                        else if (IsLoading)
                        {
                            <div class="text-center p-4">
                                <div class="spinner-border" role="status">
                                    <span class="sr-only">Carregando...</span>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="text-center p-4">
                                <p>Nenhuma avaliação encontrada com os filtros selecionados.</p>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>