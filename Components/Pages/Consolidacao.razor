@page "/consolidacao"
@rendermode InteractiveAuto
@using Peers.Moderno.Models
@using Peers.Moderno.Services.Consolidacao
@using Peers.Moderno.Services.Consolidacao.Common
@using Peers.Moderno.Services.Common
@inject IConsolidacaoService ConsolidacaoService
@inject IExportFileService ExportFileService
@inject IImportFileService ImportFileService
@inject IMessageBoxService MessageBoxService
@inject IJSRuntime JSRuntime

<PageTitle>Consolidação - Sistema de Avaliação</PageTitle>

<div class="page-breadcrumb border-bottom">
    <div class="row">
        <div class="col-lg-3 col-md-4 col-xs-12 align-self-center">
            <h5 class="font-medium text-uppercase mb-0">Comitê</h5>
        </div>
        <div class="col-lg-9 col-md-8 col-xs-12 align-self-center">
            <nav aria-label="breadcrumb" class="mt-2 float-md-right float-left">
                <ol class="breadcrumb mb-0 justify-content-end p-0">
                    <li class="breadcrumb-item"><a href="/">Peers</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Resultado Avaliações</li>
                </ol>
            </nav>
        </div>
    </div>
</div>

<div class="page-content container-fluid">
    <!-- Filtros -->
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-body">
                    <h4 class="card-title">Filtro avaliações</h4>
                    <div class="form-body">
                        <div class="row">
                            <div class="col-md-2">
                                <div class="form-group">
                                    <label>Período</label>
                                    <select @bind="selectedPeriodo" class="form-control">
                                        <option value="0">[Selecionar]</option>
                                        @foreach (var periodo in periodos)
                                        {
                                            <option value="@periodo.Id">@periodo.Nome</option>
                                        }
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-2">
                                <div class="form-group">
                                    <label>Projeto</label>
                                    <select @bind="selectedProjeto" class="form-control">
                                        <option value="0">[Selecionar]</option>
                                        @foreach (var projeto in projetos)
                                        {
                                            <option value="@projeto.Id">@projeto.Nome</option>
                                        }
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-2">
                                <div class="form-group">
                                    <label>Associado</label>
                                    <select @bind="selectedAssociado" class="form-control">
                                        <option value="0">[Selecionar]</option>
                                        @foreach (var associado in associados)
                                        {
                                            <option value="@associado.Id">@associado.Nome</option>
                                        }
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-2">&nbsp;</div>
                            <div class="col-md-2 text-right">
                                <button @onclick="BuscarAvaliacoes" class="btn btn-danger" style="margin-top: 30px" disabled="@isLoading">
                                    @if (isLoading)
                                    {
                                        <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                                        <span>Carregando...</span>
                                    }
                                    else
                                    {
                                        <span>Listar Avaliações</span>
                                    }
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Resultados -->
    <div class="card">
        <div class="card-body">
            <h4 class="card-title">Avaliações Finalizadas</h4>
            <div class="table-responsive">
                <table class="table table-striped border">
                    <thead>
                        <tr>
                            <th>Período</th>
                            <th>Avaliado</th>
                            <th>Cargo</th>
                            <th>Projeto</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (consolidacaoItems.Any())
                        {
                            @foreach (var item in consolidacaoItems)
                            {
                                <tr>
                                    <td>@item.Periodo</td>
                                    <td>@item.Nome</td>
                                    <td>@item.Cargo</td>
                                    <td>@item.Projeto</td>
                                    <td class="text-center">
                                        <a href="/avaliacao-consolidacao?IdAssociado=@item.IdAssociado&IdPeriodo=@item.IdPeriodo&IdProjeto=@item.IdProjeto&TipoAvaliacao=@item.TipoAvaliacao&Escopo=@item.Escopo" class="btn btn-info">Consolidar</a>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="text-center">Nenhuma avaliação encontrada</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Export/Import Considerações -->
    <div class="card">
        <div class="card-body">
            <h4 class="card-title">Exportar Considerações dos Mentores e Dados do RH</h4>
            <h6 class="card-subtitle">NÃO altere a ordem e quantidade das colunas, a quantidade de abas do arquivo ou coloque linhas acima da linha de títulos.</h6>
            <div class="form-body">
                <div class="row">
                    <div class="col-md-2">
                        <div class="form-group">
                            <label>Período</label>
                            <select @bind="selectedExportPeriodo" class="form-control">
                                <option value="0">[Selecionar]</option>
                                @foreach (var periodo in periodos)
                                {
                                    <option value="@periodo.Id">@periodo.Nome</option>
                                }
                            </select>
                        </div>
                    </div>
                    <div class="col-md-2">
                        <div class="form-group">
                            <label>Associado</label>
                            <select @bind="selectedExportAssociado" class="form-control">
                                <option value="0">[Selecionar]</option>
                                @foreach (var associado in associados)
                                {
                                    <option value="@associado.Id">@associado.Nome</option>
                                }
                            </select>
                        </div>
                    </div>
                </div>
                <button @onclick="ExportarConsideracoes" class="btn btn-info" disabled="@isExporting">
                    @if (isExporting)
                    {
                        <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                        <span>Exportando...</span>
                    }
                    else
                    {
                        <span>Exportar</span>
                    }
                </button>
                <button @onclick="() => importConsideracoesFileInput?.Click()" class="btn btn-info" disabled="@isImporting">
                    @if (isImporting)
                    {
                        <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                        <span>Importando...</span>
                    }
                    else
                    {
                        <span>Importar</span>
                    }
                </button>
                <InputFile @ref="importConsideracoesFileInput" OnChange="ImportarConsideracoes" accept=".xlsx" style="display: none;" />
            </div>
        </div>
    </div>

    <!-- Export/Import Notas Performance -->
    <div class="card">
        <div class="card-body">
            <h4 class="card-title">Exportar notas de performances</h4>
            <h6 class="card-subtitle">NÃO altere a ordem e quantidade das colunas, a quantidade de abas do arquivo ou coloque linhas acima da linha de títulos.</h6>
            <div class="form-body">
                <button @onclick="ExportarNotasPerformance" class="btn btn-info" disabled="@isExportingNotas">
                    @if (isExportingNotas)
                    {
                        <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                        <span>Exportando...</span>
                    }
                    else
                    {
                        <span>Exportar notas - performances</span>
                    }
                </button>
                <button @onclick="() => importNotasFileInput?.Click()" class="btn btn-info" disabled="@isImportingNotas">
                    @if (isImportingNotas)
                    {
                        <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                        <span>Importando...</span>
                    }
                    else
                    {
                        <span>Importar</span>
                    }
                </button>
                <InputFile @ref="importNotasFileInput" OnChange="ImportarNotasPerformance" accept=".xlsx" style="display: none;" />
            </div>
        </div>
    </div>
</div>