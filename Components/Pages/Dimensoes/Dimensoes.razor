@page "/dimensoes"
@using Peers.Moderno.Models
@using Peers.Moderno.Services.Dimensoes.Common
@using Peers.Moderno.Services.Common
@rendermode InteractiveAuto
@inject IDimensoesService DimensoesService
@inject IDimensoesExportService ExportService
@inject IMessageBoxService MessageBoxService
@inject ITelemetryService TelemetryService
@inject IJSRuntime JSRuntime

<PageTitle>Dimensões</PageTitle>

<div class="page-breadcrumb border-bottom">
    <div class="row">
        <div class="col-lg-3 col-md-4 col-xs-12 align-self-center">
            <h5 class="font-medium text-uppercase mb-0">Dimensões</h5>
        </div>
        <div class="col-lg-9 col-md-8 col-xs-12 align-self-center">
            <nav aria-label="breadcrumb" class="mt-2 float-md-right float-left">
                <ol class="breadcrumb mb-0 justify-content-end p-0">
                    <li class="breadcrumb-item"><a href="/">Peers</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Cadastro Básico de Projetos / Dimensões</li>
                </ol>
            </nav>
        </div>
    </div>
</div>

<div class="page-content container-fluid">
    <!-- Editor de Campos -->
    <div class="card">
        <div class="card-body">
            <h4 class="card-title">Dados da dimensão</h4>
            <EditForm Model="@dimensaoModel" OnValidSubmit="@HandleCadastrar">
                <DataAnnotationsValidator />
                <ValidationSummary />
                
                <div class="form-body">
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label>Dimensão</label>
                                <InputText @bind-Value="dimensaoModel.Nome" class="form-control" />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label>Status</label>
                                <InputSelect @bind-Value="dimensaoModel.Ativo" class="form-control">
                                    <option value="true">Ativo</option>
                                    <option value="false">Inativo</option>
                                </InputSelect>
                            </div>
                        </div>
                    </div>
                </div>
                
                <div class="form-actions">
                    <div class="text-right">
                        <button type="submit" class="btn btn-info" disabled="@isProcessing">
                            @if (isProcessing)
                            {
                                <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                                <text> Processando...</text>
                            }
                            else
                            {
                                <text>@(dimensaoModel.IdDimensao > 0 ? "Salvar" : "Cadastrar")</text>
                            }
                        </button>
                        @if (dimensaoModel.IdDimensao > 0)
                        {
                            <button type="button" class="btn btn-secondary" @onclick="LimparFormulario">
                                Cancelar
                            </button>
                        }
                    </div>
                </div>
            </EditForm>
        </div>
    </div>

    <!-- Export -->
    <div class="card">
        <div class="card-body">
            <h4 class="card-title">Exportar Dimensões</h4>
            <button type="button" class="btn btn-info" @onclick="HandleExportar" disabled="@isExporting">
                @if (isExporting)
                {
                    <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                    <text> Exportando...</text>
                }
                else
                {
                    <text>Exportar</text>
                }
            </button>
        </div>
    </div>

    <!-- Lista de Dimensões -->
    <div class="card">
        <div class="card-body">
            <h4 class="card-title">Lista de dimensões</h4>
            <h6 class="card-subtitle">Filtre as informações separadas por espaço para busca em qualquer coluna em qualquer ordem, completo ou parcial: <code>dimensão código</code>.</h6>
            
            <div class="row mb-3">
                <div class="col-md-6">
                    <input type="text" class="form-control" placeholder="Filtrar dimensões..." @bind="filtroTexto" @oninput="FiltrarDimensoes" />
                </div>
            </div>
            
            <div class="table-responsive">
                @if (dimensoesFiltradas != null && dimensoesFiltradas.Any())
                {
                    <table class="table table-striped border">
                        <thead>
                            <tr>
                                <th>Código</th>
                                <th>Dimensão</th>
                                <th>Status (Ativo/Inativo)</th>
                                <th>Ação</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var dimensao in dimensoesFiltradas)
                            {
                                <tr>
                                    <td>@dimensao.IdDimensao</td>
                                    <td>@dimensao.Nome</td>
                                    <td>@(dimensao.Ativo ? "Ativo" : "Inativo")</td>
                                    <td>
                                        <button class="btn btn-info btn-sm" @onclick="() => HandleAlterar(dimensao)">
                                            Alterar
                                        </button>
                                        @if (dimensao.Ativo)
                                        {
                                            <button class="btn btn-dark btn-sm" @onclick="() => HandleInativar(dimensao)">
                                                Inativar
                                            </button>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr>
                                <th>Código</th>
                                <th>Dimensão</th>
                                <th>Status (Ativo/Inativo)</th>
                                <th>Ação</th>
                            </tr>
                        </tfoot>
                    </table>
                }
                else if (isLoading)
                {
                    <div class="text-center p-4">
                        <div class="spinner-border" role="status">
                            <span class="sr-only">Carregando...</span>
                        </div>
                    </div>
                }
                else
                {
                    <div class="alert alert-info" role="alert">
                        Nenhuma dimensão encontrada.
                    </div>
                }
            </div>
        </div>
    </div>
</div>