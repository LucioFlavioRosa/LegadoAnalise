@page "/prazos"
@rendermode InteractiveAuto
@using Peers.Moderno.Models
@using Peers.Moderno.Services.Prazos
@using Peers.Moderno.Services.Prazos.Common
@using Peers.Moderno.Services.Common
@inject IPrazosService PrazosService
@inject IPrazosValidationHelper ValidationHelper
@inject IMessageBoxService MessageBoxService
@inject IUserContextService UserContextService

<PageTitle>Prazos</PageTitle>

<div class="page-breadcrumb border-bottom">
    <div class="row">
        <div class="col-lg-3 col-md-4 col-xs-12 align-self-center">
            <h5 class="font-medium text-uppercase mb-0">Prazos</h5>
        </div>
        <div class="col-lg-9 col-md-8 col-xs-12 align-self-center">
            <nav aria-label="breadcrumb" class="mt-2 float-md-right float-left">
                <ol class="breadcrumb mb-0 justify-content-end p-0">
                    <li class="breadcrumb-item"><a href="/">Peers / Cadastro Básico de Projetos</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Prazos</li>
                </ol>
            </nav>
        </div>
    </div>
</div>

<div class="page-content container-fluid">
    <!-- Editor de Campos -->
    <div class="card">
        <div class="card-body">
            <h4 class="card-title">Dados do Prazo</h4>
            <div class="form-body">
                <!-- Título -->
                <div class="row">
                    <div class="col-sm">
                        <label>Nome do Disparo</label>
                        <input type="text" class="form-control" @bind="FormModel.NomeDisparo" />
                    </div>
                    <div class="col-sm">
                        <label>Status</label>
                        <select class="form-control" @bind="FormModel.Status">
                            <option value="1">Ativo</option>
                            <option value="0">Inativo</option>
                        </select>
                    </div>
                </div>
                
                <!-- Auto Avaliação -->
                <br />
                <div class="row">
                    <div class="col-sm">
                        <label>Duração Auto Avaliação (em dias)</label>
                        <input type="text" class="form-control" @bind="FormModel.DuracaoAutoAvaliacao" />
                    </div>
                    <div class="col-sm">
                        <label>Gatilho Auto Avaliação</label>
                        <select class="form-control" @bind="FormModel.GatilhoAutoAvaliacao" disabled>
                            @foreach (var option in GatilhosAutoAvaliacao)
                            {
                                <option value="@option.Value">@option.Text</option>
                            }
                        </select>
                    </div>
                    <div class="col-sm">
                        <label>Compensação de Atraso Auto Avaliação (em dias)</label>
                        <input type="text" class="form-control" @bind="FormModel.CompensacaoAutoAvaliacao" />
                    </div>
                </div>
                
                <!-- Avaliação às Cegas -->
                <br />
                <div class="row">
                    <div class="col-sm">
                        <label>Duração Avaliação às Cegas (em dias)</label>
                        <input type="text" class="form-control" @bind="FormModel.DuracaoAvaliacaoAsCegas" />
                    </div>
                    <div class="col-sm">
                        <label>Gatilho Avaliação às Cegas</label>
                        <select class="form-control" @bind="FormModel.GatilhoAvaliacaoAsCegas">
                            @foreach (var option in GatilhosAvaliacaoAsCegas)
                            {
                                <option value="@option.Value">@option.Text</option>
                            }
                        </select>
                    </div>
                    <div class="col-sm">
                        <label>Compensação de Atraso Avaliação às Cegas (em dias)</label>
                        <input type="text" class="form-control" @bind="FormModel.CompensacaoAvaliacaoAsCegas" />
                    </div>
                </div>
                
                <!-- Avaliação do Gestor -->
                <br />
                <div class="row">
                    <div class="col-sm">
                        <label>Duração Avaliação do Gestor (em dias)</label>
                        <input type="text" class="form-control" @bind="FormModel.DuracaoAvaliacaoGestor" />
                    </div>
                    <div class="col-sm">
                        <label>Gatilho Avaliação do Gestor</label>
                        <select class="form-control" @bind="FormModel.GatilhoAvaliacaoGestor">
                            @foreach (var option in GatilhosAvaliacaoGestor)
                            {
                                <option value="@option.Value">@option.Text</option>
                            }
                        </select>
                    </div>
                    <div class="col-sm">
                        <label>Compensação de Atraso Avaliação do Gestor (em dias)</label>
                        <input type="text" class="form-control" @bind="FormModel.CompensacaoAvaliacaoGestor" />
                    </div>
                </div>
                
                <!-- Feedback -->
                <br />
                <div class="row">
                    <div class="col-sm">
                        <label>Duração Feedback (em dias)</label>
                        <input type="text" class="form-control" @bind="FormModel.DuracaoFeedback" />
                    </div>
                    <div class="col-sm">
                        <label>Gatilho Feedback</label>
                        <select class="form-control" @bind="FormModel.GatilhoFeedback">
                            @foreach (var option in GatilhosFeedback)
                            {
                                <option value="@option.Value">@option.Text</option>
                            }
                        </select>
                    </div>
                    <div class="col-sm">
                        <label>Compensação de Atraso Feedback (em dias)</label>
                        <input type="text" class="form-control" @bind="FormModel.CompensacaoFeedback" />
                    </div>
                </div>
                
                <!-- Mentor -->
                <br />
                <div class="row">
                    <div class="col-sm">
                        <label>Duração Consolidação do Mentor (em dias)</label>
                        <input type="text" class="form-control" @bind="FormModel.DuracaoMentor" />
                    </div>
                    <div class="col-sm">
                        <label>Gatilho Consolidação do Mentor</label>
                        <select class="form-control" @bind="FormModel.GatilhoMentor">
                            @foreach (var option in GatilhosMentor)
                            {
                                <option value="@option.Value">@option.Text</option>
                            }
                        </select>
                    </div>
                    <div class="col-sm">
                        <label>Compensação de Atraso Consolidação do Mentor (em dias)</label>
                        <input type="text" class="form-control" @bind="FormModel.CompensacaoMentor" />
                    </div>
                </div>
            </div>
            <br />
            <div class="form-actions">
                <div class="text-right">
                    <button class="btn btn-info" @onclick="SalvarPrazo" disabled="@IsLoading">
                        @if (IsLoading)
                        {
                            <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                        }
                        Cadastrar/Salvar
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Lista de Prazos -->
    <div class="card">
        <div class="card-body">
            <h4 class="card-title">Lista de Prazos</h4>
            <div class="table-responsive">
                @if (Prazos.Any())
                {
                    <table class="table table-striped border">
                        <thead>
                            <tr>
                                <th>IdPrazo</th>
                                <th>Nome Disparo</th>
                                <th>Status (Ativo/Inativo)</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var prazo in Prazos)
                            {
                                <tr>
                                    <td>@prazo.IdPrazo</td>
                                    <td>@prazo.NomeDisparo</td>
                                    <td>@prazo.StatusTexto</td>
                                    <td>
                                        <button class="btn btn-info" @onclick="() => EditarPrazo(prazo.IdPrazo)" disabled="@IsLoading">
                                            Alterar
                                        </button>
                                        @if (prazo.Ativo)
                                        {
                                            <button class="btn btn-dark" @onclick="() => InativarPrazo(prazo.IdPrazo)" disabled="@IsLoading">
                                                Inativar
                                            </button>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <p class="text-muted">Nenhum prazo cadastrado.</p>
                }
            </div>
        </div>
    </div>
</div>