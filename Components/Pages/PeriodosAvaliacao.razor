@page "/periodos-avaliacao"
@inject Services.Periodos.PeriodoService PeriodoService
@inject Services.Periodos.Common.IAvaliacoesSinalizadasService AvaliacoesSinalizadasService
@inject Services.Common.ComboHelper ComboHelper
@inject Services.Common.FormatHelper FormatHelper
@inject Services.Periodos.Common.PeriodoValidator PeriodoValidator
@inject Services.Periodos.Common.PeriodoFormatHelper PeriodoFormatHelper
@inject Services.Common.IMessageBoxService MessageBoxService
@inject Peers.Moderno.Data.ApplicationDbContext DbContext

<PageTitle>Cadastro de Períodos de Avaliação</PageTitle>

<div class="page-breadcrumb border-bottom">
    <div class="row">
        <div class="col-lg-3 col-md-4 col-xs-12 align-self-center">
            <h5 class="font-medium text-uppercase mb-0">Períodos</h5>
        </div>
        <div class="col-lg-9 col-md-8 col-xs-12 align-self-center">
            <nav aria-label="breadcrumb" class="mt-2 float-md-right float-left">
                <ol class="breadcrumb mb-0 justify-content-end p-0">
                    <li class="breadcrumb-item"><a href="/">Peers / Cadastro de Períodos</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Período</li>
                </ol>
            </nav>
        </div>
    </div>
</div>

<div class="page-content container-fluid">
    <div class="card">
        <div class="card-body">
            <h4 class="card-title">Período da Avaliação</h4>
            <EditForm Model="periodoModel" OnValidSubmit="HandleValidSubmit">
                <DataAnnotationsValidator />
                <ValidationSummary />
                <div class="form-body">
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label>Empresa</label>
                                <InputSelect class="form-control" @bind-Value="periodoModel.IdEmpresa">
                                    @foreach (var empresa in empresas)
                                    {
                                        <option value="@empresa.Value">@empresa.Text</option>
                                    }
                                </InputSelect>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label>Status</label>
                                <InputSelect class="form-control" @bind-Value="periodoModel.ATV">
                                    @foreach (var status in statusList)
                                    {
                                        <option value="@status.Value">@status.Text</option>
                                    }
                                </InputSelect>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label>Data Início</label>
                                <InputDate class="form-control" @bind-Value="periodoModel.DataInicio" />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label>Data Término</label>
                                <InputDate class="form-control" @bind-Value="periodoModel.DataFim" />
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label>Código (<b>N</b>SEM-<b>YYYY</b>)</label>
                                <InputText class="form-control" @bind-Value="periodoModel.Codigo" />
                            </div>
                        </div>
                        <div class="col-md-6"></div>
                    </div>
                </div>
                <div class="form-actions">
                    <div class="text-right">
                        <label style="color:darkred">Ao cadastrar um NOVO período, todas as avaliações que os gestores sinalizaram que devem ocorrer no "próximo período" serão atribuídas a este novo período cadastrado.</label>
                        <button type="submit" class="btn btn-info">Cadastrar/Salvar</button>
                    </div>
                </div>
            </EditForm>
        </div>
    </div>

    <div class="card">
        <div class="card-body">
            <h4 class="card-title">Lista de Períodos</h4>
            <div class="table-responsive">
                <table class="table table-striped border dtInit">
                    <thead>
                        <tr>
                            <th>Código</th>
                            <th>Data Início</th>
                            <th>Data Término</th>
                            <th>Status(Ativo/Inativo)</th>
                            <th class="text-center">Ação</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var periodo in periodos)
                        {
                            <tr>
                                <td>@periodo.Codigo</td>
                                <td>@PeriodoFormatHelper.FormatDate(periodo.DataInicio)</td>
                                <td>@PeriodoFormatHelper.FormatDate(periodo.DataFim)</td>
                                <td>@PeriodoFormatHelper.FormatStatus(periodo.ATV)</td>
                                <td class="text-center">
                                    <button class="btn btn-info" @onclick="() => EditarPeriodo(periodo)">Alterar</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr>
                            <th>Código</th>
                            <th>Data Início</th>
                            <th>Data Término</th>
                            <th>Status(Ativo/Inativo)</th>
                            <th>Ação</th>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-body">
            <h4 class="card-title">Avaliações as quais o GESTOR sinalizou que devem ocorrer no próximo período cadastrado:</h4>
            <div class="table-responsive">
                <table class="table table-striped border">
                    <thead>
                        <tr>
                            <th>Projeto</th>
                            <th>Associado</th>
                            <th>Avaliador</th>
                            <th>Início alocação</th>
                            <th>Término alocação</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var av in avaliacoesSinalizadas)
                        {
                            <tr>
                                <td>@av.Projeto</td>
                                <td>@av.Respondente</td>
                                <td>@av.Avaliador</td>
                                <td>@av.DataInicio</td>
                                <td>@av.DataTermino</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
