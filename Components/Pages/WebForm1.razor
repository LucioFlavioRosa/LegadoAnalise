@page "/webform1"
@rendermode InteractiveAuto
@using Peers.Moderno.Services.Common
@inject ITelemetryService TelemetryService
@inject IMessageBoxService MessageBoxService

<PageTitle>WebForm1 - Sistema de Avaliação</PageTitle>

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h3 class="card-title mb-0">
                        <i class="fas fa-file-alt me-2"></i>
                        WebForm1 - Página Migrada
                    </h3>
                </div>
                <div class="card-body">
                    <div class="alert alert-success" role="alert">
                        <i class="fas fa-check-circle me-2"></i>
                        <strong>Migração Concluída!</strong> Esta página foi migrada com sucesso do Web Forms para Blazor Híbrido (.NET 9).
                    </div>
                    
                    <div class="row">
                        <div class="col-md-6">
                            <div class="info-box">
                                <div class="info-box-icon bg-info">
                                    <i class="fas fa-code"></i>
                                </div>
                                <div class="info-box-content">
                                    <span class="info-box-text">Tecnologia</span>
                                    <span class="info-box-number">Blazor Híbrido</span>
                                    <span class="progress-description">
                                        Renderização Automática (Server/Client)
                                    </span>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="info-box">
                                <div class="info-box-icon bg-success">
                                    <i class="fas fa-rocket"></i>
                                </div>
                                <div class="info-box-content">
                                    <span class="info-box-text">Framework</span>
                                    <span class="info-box-number">.NET 9</span>
                                    <span class="progress-description">
                                        Cloud-Native Ready
                                    </span>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <div class="mt-4">
                        <h5>Características da Migração:</h5>
                        <ul class="list-group list-group-flush">
                            <li class="list-group-item d-flex align-items-center">
                                <i class="fas fa-check text-success me-2"></i>
                                Roteamento moderno com Blazor Router
                            </li>
                            <li class="list-group-item d-flex align-items-center">
                                <i class="fas fa-check text-success me-2"></i>
                                Integração com serviços comuns reutilizáveis
                            </li>
                            <li class="list-group-item d-flex align-items-center">
                                <i class="fas fa-check text-success me-2"></i>
                                Telemetria e monitoramento integrados
                            </li>
                            <li class="list-group-item d-flex align-items-center">
                                <i class="fas fa-check text-success me-2"></i>
                                Preparado para escalabilidade em nuvem
                            </li>
                        </ul>
                    </div>
                    
                    <div class="mt-4">
                        <div class="d-flex gap-2">
                            <button class="btn btn-primary" @onclick="ShowSuccessMessage">
                                <i class="fas fa-thumbs-up me-1"></i>
                                Testar Integração
                            </button>
                            <button class="btn btn-info" @onclick="LogPageAccess">
                                <i class="fas fa-chart-line me-1"></i>
                                Registrar Acesso
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    protected override async Task OnInitializedAsync()
    {
        TelemetryService.TrackPageView("WebForm1", new Dictionary<string, string>
        {
            { "MigrationType", "WebForms to Blazor" },
            { "Framework", ".NET 9" },
            { "RenderMode", "InteractiveAuto" }
        });
        
        await base.OnInitializedAsync();
    }
    
    private void ShowSuccessMessage()
    {
        MessageBoxService.ShowSuccess("Integração com serviços comuns funcionando perfeitamente!");
        
        TelemetryService.TrackEvent("WebForm1_IntegrationTest", new Dictionary<string, string>
        {
            { "TestType", "MessageBoxService" },
            { "Result", "Success" }
        });
    }
    
    private void LogPageAccess()
    {
        TelemetryService.TrackEvent("WebForm1_ManualAccessLog", new Dictionary<string, string>
        {
            { "Timestamp", DateTime.UtcNow.ToString("yyyy-MM-dd HH:mm:ss") },
            { "UserAction", "Manual Log" }
        });
        
        MessageBoxService.ShowInfo("Acesso registrado com sucesso na telemetria!");
    }
}