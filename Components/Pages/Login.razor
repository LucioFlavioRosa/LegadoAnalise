@page "/login"
@using Peers.Moderno.Services.Common
@using Peers.Moderno.Services.Common.Auth
@using Peers.Moderno.Components.Shared
@inject IAuthService AuthService
@inject IMessageBoxService MessageBoxService
@inject IConfiguration Configuration
@inject NavigationManager Navigation
@inject IUserContextService UserContextService
@rendermode InteractiveAuto

<!DOCTYPE html>
<html dir="ltr">
<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="description" content="">
    <meta name="author" content="">
    <link rel="icon" type="image/png" sizes="16x16" href="assets/images/favicon.png">
    <title>Peers - Login</title>
    <link href="dist/css/style.min.css" rel="stylesheet">
</head>

<body>
    <div class="main-wrapper">
        <!-- Preloader -->
        <div class="preloader" style="@(isLoading ? "" : "display: none;")">
            <div class="lds-ripple">
                <div class="lds-pos"></div>
                <div class="lds-pos"></div>
            </div>
        </div>

        <!-- Login box -->
        <div class="auth-wrapper d-flex no-block justify-content-center align-items-center flex-column" style="background:url(assets/images/big/auth-bg.jpg) no-repeat center center;">
            <div class="auth-box">
                <div id="loginform">
                    <div class="logo">
                        <span class="db"><img src="assets/images/logos/logo-icon.png" alt="logo" /></span>
                        <h2 class="font-medium my-3">Bem vindo ao Sistema de Avaliação!</h2>
                    </div>
                    
                    <!-- Form -->
                    <div class="row">
                        <div class="col-12">
                            <form class="form-horizontal mt-3" @onsubmit:preventDefault="true">
                                <!-- Message Box -->
                                @if (!string.IsNullOrEmpty(errorMessage))
                                {
                                    <div class="alert alert-danger" role="alert">
                                        @errorMessage
                                    </div>
                                }
                                @if (!string.IsNullOrEmpty(successMessage))
                                {
                                    <div class="alert alert-success" role="alert">
                                        @successMessage
                                    </div>
                                }
                                @if (!string.IsNullOrEmpty(infoMessage))
                                {
                                    <div class="alert alert-info" role="alert">
                                        @infoMessage
                                    </div>
                                }

                                <div class="form-group row">
                                    <div class="col-md-12">
                                        <div class="custom-control custom-checkbox">
                                            <input type="checkbox" class="custom-control-input" id="customCheck1">
                                        </div>
                                    </div>
                                </div>
                                
                                <div class="form-group text-center">
                                    <div class="col-xs-12 pb-3">
                                        <button type="button" 
                                                class="btn btn-block btn-lg btn-info" 
                                                @onclick="HandleLoginSSO" 
                                                disabled="@isProcessing">
                                            @if (isProcessing)
                                            {
                                                <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                                                <span> Processando...</span>
                                            }
                                            else
                                            {
                                                <span>Entrar com minha conta corporativa</span>
                                            }
                                        </button>
                                    </div>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
            
            <div class="row">
                <div class="col-12">
                    <div>
                        <h5 class="font-medium mt-5 text-center">
                            Versão: @appVersion
                        </h5>
                    </div>
                </div>
            </div>
        </div>

        <!-- Footer Links -->
        <FooterLinks />
    </div>

    <!-- Scripts -->
    <script src="assets/libs/jquery/dist/jquery.min.js"></script>
    <script src="assets/libs/popper.js/dist/umd/popper.min.js"></script>
    <script src="assets/libs/bootstrap/dist/js/bootstrap.min.js"></script>
    <script>
        $('[data-toggle="tooltip"]').tooltip();
        $(".preloader").fadeOut();
    </script>
</body>
</html>

@code {
    private bool isLoading = false;
    private bool isProcessing = false;
    private string? errorMessage;
    private string? successMessage;
    private string? infoMessage;
    private string appVersion = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            // Verificar se já está logado
            var usuarioLogado = await UserContextService.GetUsuarioLogadoAsync();
            if (usuarioLogado != null)
            {
                Navigation.NavigateTo("/", true);
                return;
            }

            // Verificar se veio de logout
            var uri = new Uri(Navigation.Uri);
            var query = System.Web.HttpUtility.ParseQueryString(uri.Query);
            
            if (query["logout"] == "true")
            {
                infoMessage = "Você foi desconectado com sucesso.";
            }
            
            if (!string.IsNullOrEmpty(query["error"]))
            {
                errorMessage = System.Web.HttpUtility.UrlDecode(query["error"]);
            }

            // Obter versão da aplicação
            appVersion = Configuration["AppVersion"] ?? "1.0.0";

            // Processar callback se houver código
            var code = query["code"];
            var state = query["state"];
            var error = query["error"];
            var errorDescription = query["error_description"];

            if (!string.IsNullOrEmpty(code) || !string.IsNullOrEmpty(error))
            {
                await ProcessAuthCallback(code, state, error, errorDescription);
            }
        }
        catch (Exception ex)
        {
            errorMessage = "Erro ao inicializar página de login";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task HandleLoginSSO()
    {
        try
        {
            isProcessing = true;
            errorMessage = null;
            successMessage = null;
            infoMessage = null;

            var result = await AuthService.GerarUrlAutorizacaoAsync();
            
            if (result.IsSuccess && !string.IsNullOrEmpty(result.Url))
            {
                Navigation.NavigateTo(result.Url, true);
            }
            else
            {
                errorMessage = result.ErrorMessage ?? "Erro ao iniciar login com Microsoft";
            }
        }
        catch (Exception ex)
        {
            errorMessage = "Erro ao iniciar login com Microsoft. Tente novamente.";
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task ProcessAuthCallback(string? code, string? state, string? error, string? errorDescription)
    {
        try
        {
            isProcessing = true;
            
            var result = await AuthService.ProcessarCallbackAsync(code, state, error, errorDescription);
            
            if (result.IsSuccess && result.Usuario != null)
            {
                await UserContextService.SetUsuarioLogadoAsync(result.Usuario);
                successMessage = "Login realizado com sucesso! Redirecionando...";
                
                // Aguardar um pouco para mostrar a mensagem antes de redirecionar
                await Task.Delay(1500);
                Navigation.NavigateTo("/", true);
            }
            else
            {
                errorMessage = result.ErrorMessage ?? "Erro desconhecido durante autenticação";
            }
        }
        catch (Exception ex)
        {
            errorMessage = "Erro ao processar autenticação";
        }
        finally
        {
            isProcessing = false;
        }
    }
}