@page "/logout"
@rendermode InteractiveAuto
@inject Peers.Moderno.Services.Common.Auth.ILogoutService LogoutService
@inject NavigationManager Navigation
@inject Peers.Moderno.Services.Common.ITelemetryService TelemetryService

<PageTitle>Saindo...</PageTitle>

<div class="d-flex justify-content-center align-items-center" style="min-height: 50vh;">
    <div class="text-center">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Carregando...</span>
        </div>
        <h4 class="mt-3">Saindo...</h4>
        <p class="text-muted">Aguarde enquanto você é desconectado do sistema.</p>
    </div>
</div>

@code {
    protected override async Task OnInitializedAsync()
    {
        try
        {
            TelemetryService.TrackEvent("LogoutPageAccessed");
            var redirectUrl = await LogoutService.LogoutAsync();
            Navigation.NavigateTo(redirectUrl, forceLoad: true);
        }
        catch (Exception ex)
        {
            TelemetryService.TrackException(ex, new Dictionary<string, string>
            {
                { "Component", "LogoutPage" },
                { "Method", "OnInitializedAsync" }
            });
            Navigation.NavigateTo("/login", forceLoad: true);
        }
    }
}