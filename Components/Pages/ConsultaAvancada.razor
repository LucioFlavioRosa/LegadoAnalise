@page "/consulta-avancada"
@rendermode InteractiveAuto

@inject Services.Common.IConsultaAvancadaService ConsultaAvancadaService
@inject Services.Common.ComboHelper ComboHelper
@inject Peers.Moderno.Services.Common.IMessageBoxService MessageBoxService

@inherits ConsultaAvancadaBase

<PageTitle>Consulta Avançada</PageTitle>

<div class="page-breadcrumb border-bottom">
    <div class="row">
        <div class="col-lg-3 col-md-4 col-xs-12 align-self-center">
            <h5 class="font-medium text-uppercase mb-0">Consulta Avançada</h5>
        </div>
        <div class="col-lg-9 col-md-8 col-xs-12 align-self-center">
            <nav aria-label="breadcrumb" class="mt-2 float-md-right float-left">
                <ol class="breadcrumb mb-0 justify-content-end p-0">
                    <li class="breadcrumb-item"><a href="/">Peers</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Consulta Avançada</li>
                </ol>
            </nav>
        </div>
    </div>
</div>

<div class="page-content container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-body">
                    <h4 class="card-title">Filtro avaliações</h4>
                    <div class="form-body">
                        <EditForm Model="this" OnValidSubmit="OnSearchAsync">
                            <div class="row">
                                <div class="col-md-4">
                                    <div class="form-group">
                                        <label>Projeto</label>
                                        <InputSelect @bind-Value="ProjetoId" class="form-control p-0 select2" style="width: 100%">
                                            @foreach (var item in ProjetosCombo)
                                            {
                                                <option value="@item.Value">@item.Text</option>
                                            }
                                        </InputSelect>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="form-group">
                                        <label>Cliente</label>
                                        <InputSelect @bind-Value="ClienteId" class="form-control p-0 select2" style="width: 100%">
                                            @foreach (var item in ClientesCombo)
                                            {
                                                <option value="@item.Value">@item.Text</option>
                                            }
                                        </InputSelect>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="form-group">
                                        <label>Associado</label>
                                        <InputSelect @bind-Value="AssociadoId" class="form-control p-0 select2" style="width: 100%">
                                            @foreach (var item in ProfissionaisCombo)
                                            {
                                                <option value="@item.Value">@item.Text</option>
                                            }
                                        </InputSelect>
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-3">
                                    <div class="form-group">
                                        <label>Período</label>
                                        <InputSelect @bind-Value="PeriodoId" class="form-control p-0 select2" style="width: 100%">
                                            @foreach (var item in PeriodosCombo)
                                            {
                                                <option value="@item.Value">@item.Text</option>
                                            }
                                        </InputSelect>
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="form-group">
                                        <label>Fase</label>
                                        <InputSelect @bind-Value="Fase" class="form-control p-0 select2" style="width: 100%">
                                            @foreach (var item in FasesCombo)
                                            {
                                                <option value="@item.Value">@item.Text</option>
                                            }
                                        </InputSelect>
                                    </div>
                                </div>
                                <div class="col-md-1"></div>
                                <div class="col-md-2 text-right">
                                    <button type="submit" class="btn btn-danger" style="margin-top: 30px">Listar Avaliações</button>
                                </div>
                            </div>
                        </EditForm>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-body">
                    <div class="table-responsive">
                        @if (IsLoading)
                        {
                            <div class="text-center my-3">
                                <span class="spinner-border text-primary"></span> Carregando avaliações...
                            </div>
                        }
                        else if (Avaliacoes?.Any() == true)
                        {
                            <table class="table table-striped border gridResultado">
                                <thead>
                                    <tr>
                                        <th>Projeto</th>
                                        <th>Cliente</th>
                                        <th>Associado</th>
                                        <th>Cargo</th>
                                        <th>Gestor</th>
                                        <th>Período</th>
                                        <th>Tipo de Avaliação</th>
                                        <th>Escopo</th>
                                        <th>Início</th>
                                        <th>Término</th>
                                        <th style="width: 120px">Fase</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var av in Avaliacoes)
                                    {
                                        <tr>
                                            <td>@av.Projeto?.Projeto</td>
                                            <td>@av.Cliente?.Cliente</td>
                                            <td>@av.Associado?.Nome</td>
                                            <td>@av.Associado?.CARGOS?.Cargo</td>
                                            <td>@av.Gestor?.Nome</td>
                                            <td>@av.Periodo?.Periodo</td>
                                            <td>@av.TipoAvaliacao</td>
                                            <td>@av.Escopo</td>
                                            <td>@av.DataInicio</td>
                                            <td>@av.DataTermino</td>
                                            <td>@av.Fase</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }
                        else if (Avaliacoes != null)
                        {
                            <div class="alert alert-info">Nenhuma avaliação encontrada para os filtros selecionados.</div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
