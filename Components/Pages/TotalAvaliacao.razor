@page "/total-avaliacao"
@rendermode InteractiveAuto
@inject Peers.Moderno.Services.Common.Avaliacoes.ITotalAvaliacaoService TotalAvaliacaoService
@inject Peers.Moderno.Services.Common.IMessageBoxService MessageBoxService

<PageTitle>Total de Avaliações</PageTitle>

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h3 class="card-title mb-0">
                        <i class="fas fa-chart-bar me-2"></i>
                        Total de Avaliações
                    </h3>
                </div>
                <div class="card-body">
                    @if (isLoading)
                    {
                        <div class="d-flex justify-content-center align-items-center" style="min-height: 200px;">
                            <div class="spinner-border text-primary" role="status">
                                <span class="visually-hidden">Carregando...</span>
                            </div>
                            <span class="ms-3">Carregando dados...</span>
                        </div>
                    }
                    else if (hasError)
                    {
                        <div class="alert alert-danger" role="alert">
                            <i class="fas fa-exclamation-triangle me-2"></i>
                            Erro ao carregar os dados. Tente novamente.
                            <button class="btn btn-outline-danger btn-sm ms-3" @onclick="CarregarDados">
                                <i class="fas fa-redo me-1"></i>
                                Tentar Novamente
                            </button>
                        </div>
                    }
                    else
                    {
                        <div class="row">
                            <div class="col-md-3 col-sm-6 mb-3">
                                <div class="card bg-primary text-white">
                                    <div class="card-body text-center">
                                        <i class="fas fa-clipboard-list fa-2x mb-2"></i>
                                        <h4 class="card-title">@estatisticas.GetValueOrDefault("Total", 0)</h4>
                                        <p class="card-text">Total Geral</p>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-3 col-sm-6 mb-3">
                                <div class="card bg-success text-white">
                                    <div class="card-body text-center">
                                        <i class="fas fa-user-check fa-2x mb-2"></i>
                                        <h4 class="card-title">@estatisticas.GetValueOrDefault("AutoAvaliacao", 0)</h4>
                                        <p class="card-text">Auto Avaliações</p>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-3 col-sm-6 mb-3">
                                <div class="card bg-info text-white">
                                    <div class="card-body text-center">
                                        <i class="fas fa-user-tie fa-2x mb-2"></i>
                                        <h4 class="card-title">@estatisticas.GetValueOrDefault("AvaliacaoGestor", 0)</h4>
                                        <p class="card-text">Avaliações Gestor</p>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-3 col-sm-6 mb-3">
                                <div class="card bg-warning text-white">
                                    <div class="card-body text-center">
                                        <i class="fas fa-eye-slash fa-2x mb-2"></i>
                                        <h4 class="card-title">@estatisticas.GetValueOrDefault("AvaliacaoAsCegas", 0)</h4>
                                        <p class="card-text">Avaliações às Cegas</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                        
                        @if (estatisticas.GetValueOrDefault("Total", 0) == 0)
                        {
                            <div class="alert alert-info text-center mt-4" role="alert">
                                <i class="fas fa-info-circle me-2"></i>
                                Nenhuma avaliação foi registrada no sistema ainda.
                            </div>
                        }
                        else
                        {
                            <div class="mt-4">
                                <div class="d-flex justify-content-between align-items-center">
                                    <h5>Resumo</h5>
                                    <button class="btn btn-outline-primary btn-sm" @onclick="CarregarDados">
                                        <i class="fas fa-sync-alt me-1"></i>
                                        Atualizar
                                    </button>
                                </div>
                                <hr>
                                <p class="text-muted">
                                    <i class="fas fa-calendar me-2"></i>
                                    Última atualização: @DateTime.Now.ToString("dd/MM/yyyy HH:mm:ss")
                                </p>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private Dictionary<string, int> estatisticas = new();
    private bool isLoading = true;
    private bool hasError = false;

    protected override async Task OnInitializedAsync()
    {
        await CarregarDados();
    }

    private async Task CarregarDados()
    {
        try
        {
            isLoading = true;
            hasError = false;
            StateHasChanged();

            estatisticas = await TotalAvaliacaoService.ObterEstatisticasAvaliacoesAsync();
        }
        catch (Exception ex)
        {
            hasError = true;
            MessageBoxService.ShowError("Erro ao carregar os dados das avaliações.");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }
}