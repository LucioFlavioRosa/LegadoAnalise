@page "/complexidades"
@rendermode InteractiveAuto
@inject IComplexidadeService ComplexidadeService
@inject IMessageBoxService MessageBoxService
@using Peers.Moderno.Services.Complexidades.Common
@using Peers.Moderno.Services.Common

<PageTitle>Complexidade</PageTitle>

<div class="page-breadcrumb border-bottom">
    <div class="row">
        <div class="col-lg-3 col-md-4 col-xs-12 align-self-center">
            <h5 class="font-medium text-uppercase mb-0">Complexidade</h5>
        </div>
        <div class="col-lg-9 col-md-8 col-xs-12 align-self-center">
            <nav aria-label="breadcrumb" class="mt-2 float-md-right float-left">
                <ol class="breadcrumb mb-0 justify-content-end p-0">
                    <li class="breadcrumb-item"><a href="/">Peers / Cadastros Básicos de Projetos</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Complexidade</li>
                </ol>
            </nav>
        </div>
    </div>
</div>

<div class="page-content container-fluid">
    <!-- Formulário de Cadastro/Edição -->
    <div class="card">
        <div class="card-body">
            <h4 class="card-title">Dados da Complexidade</h4>
            <div class="form-body">
                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label>Complexidade</label>
                            <input @bind="complexidadeAtual.Complexidade" class="form-control" type="text" />
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label>Status</label>
                            <select @bind="complexidadeAtual.ATV" class="form-control">
                                <option value="1">Ativo</option>
                                <option value="0">Inativo</option>
                            </select>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-2">
                        <div class="form-group">
                            <label>Peso</label>
                            <input @bind="complexidadeAtual.Peso" class="form-control" type="number" step="0.01" />
                        </div>
                    </div>
                    <div class="col-md-2">
                        <div class="form-group">
                            <label>Peso Ponderado</label>
                            <input @bind="complexidadeAtual.PesoPonderado" class="form-control" type="number" step="0.01" />
                        </div>
                    </div>
                    <div class="col-md-2">
                        <div class="form-group">
                            <label>% Ponderação</label>
                            <input @bind="complexidadeAtual.Ponderacao" class="form-control" type="number" step="0.01" />
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-group">
                            <label>% Faixa Inicial de Ponderação</label>
                            <input @bind="complexidadeAtual.FaixaInicial" class="form-control" type="number" step="0.01" />
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-group">
                            <label>% Faixa Final de Ponderação</label>
                            <input @bind="complexidadeAtual.FaixaFinal" class="form-control" type="number" step="0.01" />
                        </div>
                    </div>
                </div>
                <div class="form-actions">
                    <div class="text-right">
                        <button @onclick="SalvarComplexidade" class="btn btn-info" disabled="@isProcessing">
                            @if (isProcessing)
                            {
                                <span class="spinner-border spinner-border-sm" role="status"></span>
                                <span>Processando...</span>
                            }
                            else
                            {
                                <span>@(isEdicao ? "Alterar" : "Cadastrar")</span>
                            }
                        </button>
                        @if (isEdicao)
                        {
                            <button @onclick="LimparFormulario" class="btn btn-secondary" disabled="@isProcessing">
                                Cancelar
                            </button>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Lista de Complexidades -->
    <div class="card">
        <div class="card-body">
            <h4 class="card-title">Lista de Complexidades</h4>
            <h6 class="card-subtitle">Filtre as informações separadas por espaço para busca em qualquer coluna em qualquer ordem, completo ou parcial: <code>complexidade código</code>.</h6>
            
            @if (isCarregando)
            {
                <div class="text-center p-4">
                    <div class="spinner-border" role="status">
                        <span class="sr-only">Carregando...</span>
                    </div>
                </div>
            }
            else if (complexidades?.Any() == true)
            {
                <div class="table-responsive">
                    <table class="table table-striped border">
                        <thead>
                            <tr>
                                <th>Código</th>
                                <th>Complexidade</th>
                                <th>Mínimo Fatores</th>
                                <th>Status(Ativo/Inativo)</th>
                                <th>Ação</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in complexidades)
                            {
                                <tr>
                                    <td>@item.IdComplexidade</td>
                                    <td>@item.Complexidade</td>
                                    <td>@item.SomaMinimaFator</td>
                                    <td>@item.StatusTexto</td>
                                    <td>
                                        <button @onclick="() => EditarComplexidade(item.IdComplexidade)" class="btn btn-info btn-sm" disabled="@isProcessing">
                                            Alterar
                                        </button>
                                        @if (item.IsAtivo)
                                        {
                                            <button @onclick="() => InativarComplexidade(item.IdComplexidade)" class="btn btn-dark btn-sm" disabled="@isProcessing">
                                                Inativar
                                            </button>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="alert alert-info">
                    Nenhuma complexidade encontrada.
                </div>
            }
        </div>
    </div>

    <!-- Seção de Fatores (Placeholder) -->
    <div class="card card-body">
        <h4>Editar fatores de complexidades</h4>
        <h5>Os fatores abaixo são exibidos para mensuração de cada projeto pelo gestor na página Gerenciar Projetos.</h5>
        <div class="table-responsive">
            <!-- Implementação futura dos fatores -->
        </div>
    </div>
</div>