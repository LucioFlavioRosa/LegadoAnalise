@page "/contact"
@rendermode InteractiveAuto
@inject Peers.Moderno.Services.Cargos.Common.ICargoLookupService CargoLookupService
@inject Peers.Moderno.Services.Common.IMessageBoxService MessageBoxService

<PageTitle>Contact</PageTitle>

<div class="page-content">
    <div class="container">
        <h2>Contact</h2>
        
        <div class="card">
            <div class="card-body">
                <div class="form-group">
                    <label for="txtIdCargo" class="form-label">Digite o Código do Cargo:</label>
                    <div class="input-group">
                        <InputText id="txtIdCargo" @bind-Value="CodigoCargo" class="form-control" placeholder="Digite o código" />
                        <button class="btn btn-primary" type="button" @onclick="BuscarCargo" disabled="@IsLoading">
                            @if (IsLoading)
                            {
                                <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                            }
                            Buscar Cargo
                        </button>
                    </div>
                </div>
                
                @if (CargoEncontrado != null)
                {
                    <div class="alert alert-success mt-3">
                        <strong>Cargo encontrado:</strong> @CargoEncontrado.Nome
                    </div>
                }
            </div>
        </div>

        <div class="mt-4">
            <h3>Your contact page.</h3>
            <address>
                One Microsoft Way<br />
                Redmond, WA 98052-6399<br />
                <abbr title="Phone">P:</abbr>
                425.555.0100
            </address>

            <address>
                <strong>Support:</strong> <a href="mailto:Support@example.com">Support@example.com</a><br />
                <strong>Marketing:</strong> <a href="mailto:Marketing@example.com">Marketing@example.com</a>
            </address>
        </div>
    </div>
</div>