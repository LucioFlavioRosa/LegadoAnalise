@rendermode InteractiveAuto
@page "/avaliacoes/retroceder"

@inject Services.Avaliacoes.IRetrocederAvaliacaoService RetrocederAvaliacaoService
@inject Services.Avaliacoes.Common.IRetrocederAvaliacaoValidator RetrocederAvaliacaoValidator
@inject Services.Common.IMessageBoxService MessageBoxService
@inject Services.Common.ComboHelper ComboHelper
@inject Services.Common.FormatHelper FormatHelper

<PageTitle>Retroceder Avaliações</PageTitle>

<div class="page-breadcrumb border-bottom mb-3">
    <div class="row">
        <div class="col-lg-3 col-md-4 col-xs-12 align-self-center">
            <h5 class="font-medium text-uppercase mb-0">Retroceder Avaliações</h5>
        </div>
        <div class="col-lg-9 col-md-8 col-xs-12 align-self-center">
            <nav aria-label="breadcrumb" class="mt-2 float-md-right float-left">
                <ol class="breadcrumb mb-0 justify-content-end p-0">
                    <li class="breadcrumb-item"><a href="/">Peers</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Retroceder Avaliações</li>
                </ol>
            </nav>
        </div>
    </div>
</div>

<Components.Avaliacoes.RetrocederAvaliacaoFiltro
    @bind-Filtro="Filtro"
    OnBuscar="BuscarAvaliacoesAsync"
    Fases="Fases"
    Projetos="Projetos"
    Clientes="Clientes"
    Profissionais="Profissionais"
    Periodos="Periodos"
    Loading="LoadingFiltro"
/>

<Components.Avaliacoes.RetrocederAvaliacaoGrid
    Avaliacoes="Avaliacoes"
    OnRetroceder="AbrirPainelRetroceder"
    Loading="LoadingGrid"
/>

@if (MostrarPainelRetroceder)
{
    <Components.Avaliacoes.RetrocederAvaliacaoPanel
        AvaliacaoSelecionada="AvaliacaoSelecionada"
        OpcoesRetrocesso="OpcoesRetrocesso"
        OnEfetuarRetrocesso="EfetuarRetrocessoAsync"
        Loading="LoadingPanel"
        OnCancelar="FecharPainelRetroceder"
    />
}

@code {
    private RetrocederAvaliacaoFiltroModel Filtro = new();
    private List<ComboItem> Fases = new();
    private List<ComboItem> Projetos = new();
    private List<ComboItem> Clientes = new();
    private List<ComboItem> Profissionais = new();
    private List<ComboItem> Periodos = new();
    private List<AvaliacaoEmailModel> Avaliacoes = new();
    private bool LoadingFiltro = false;
    private bool LoadingGrid = false;
    private bool LoadingPanel = false;
    private bool MostrarPainelRetroceder = false;
    private AvaliacaoEmailModel? AvaliacaoSelecionada;
    private RetrocederAvaliacaoOpcoesModel OpcoesRetrocesso = new();

    protected override async Task OnInitializedAsync()
    {
        LoadingFiltro = true;
        Projetos = await ComboHelper.GetProjetosComboAsync();
        Clientes = await ComboHelper.GetClientesComboAsync();
        Profissionais = await ComboHelper.GetProfissionaisComboAsync();
        Periodos = await ComboHelper.GetPeriodosComboAsync();
        Fases = await RetrocederAvaliacaoService.ObterFasesComboAsync();
        LoadingFiltro = false;
    }

    private async Task BuscarAvaliacoesAsync()
    {
        LoadingGrid = true;
        Avaliacoes = await RetrocederAvaliacaoService.BuscarAvaliacoesAsync(Filtro);
        LoadingGrid = false;
        MostrarPainelRetroceder = false;
    }

    private async Task AbrirPainelRetroceder(AvaliacaoEmailModel avaliacao)
    {
        LoadingPanel = true;
        AvaliacaoSelecionada = avaliacao;
        OpcoesRetrocesso = await RetrocederAvaliacaoService.ObterOpcoesRetrocessoAsync(avaliacao);
        MostrarPainelRetroceder = true;
        LoadingPanel = false;
    }

    private async Task EfetuarRetrocessoAsync(RetrocederAvaliacaoOpcoesModel opcoes)
    {
        LoadingPanel = true;
        var resultado = await RetrocederAvaliacaoService.EfetuarRetrocessoAsync(AvaliacaoSelecionada, opcoes);
        if (resultado.Sucesso)
        {
            MessageBoxService.ShowSuccess("Fase da avaliação atualizada com sucesso!");
            await BuscarAvaliacoesAsync();
            MostrarPainelRetroceder = false;
        }
        else
        {
            MessageBoxService.ShowError(resultado.MensagemErro ?? "Erro ao retroceder avaliação.");
        }
        LoadingPanel = false;
    }

    private void FecharPainelRetroceder()
    {
        MostrarPainelRetroceder = false;
        AvaliacaoSelecionada = null;
        OpcoesRetrocesso = new();
    }
}
