@rendermode InteractiveAuto
@page "/avaliacao-competencia"
@inject Services.Avaliacoes.IAvaliacaoCompetenciaService AvaliacaoCompetenciaService
@inject Services.Common.IMessageBoxService MessageBoxService
@inject Services.Common.ComboHelper ComboHelper
@inject IConfiguration Configuration
@inject NavigationManager NavigationManager

<PageTitle>Avaliação às Cegas - Competências</PageTitle>

<div class="page-breadcrumb border-bottom" style="position:fixed;z-index:1;width:100%">
    <div class="row">
        <div class="col-lg-3 col-md-4 col-xs-12 align-self-center">
            <h5 class="font-medium text-uppercase mb-0">Avaliação às Cegas</h5>
        </div>
        <div class="col-lg-9 col-md-8 col-xs-12 align-self-center">
            <nav aria-label="breadcrumb" class="mt-2 float-md-right float-left">
                <ol class="breadcrumb mb-0 justify-content-end p-0">
                    <li class="breadcrumb-item"><a href="/">Peers</a></li>
                    <li class="breadcrumb-item"><a href="/avaliacoes">Avaliação / Avaliação às Cegas</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Competência</li>
                </ol>
            </nav>
        </div>
    </div>
</div>

<div class="page-content container-fluid" style="overflow:initial !important">
    <div class="card col-md-10" style="position:fixed;z-index:1; margin-top:21px;border-color:rgba(0, 0, 0, .25);border-width:1px">
        <div class="card-body">
            <div class="accordion" id="accordionDetalhes">
                <div class="card">
                    <div class="card-header" id="headingDetalhes">
                        <h5 class="mb-0">
                            <button class="btn btn-link" type="button" data-bs-toggle="collapse" data-bs-target="#Detalhes" aria-expanded="true" aria-controls="Detalhes">
                                Detalhes da avaliação
                            </button>
                        </h5>
                    </div>
                    <div id="Detalhes" class="collapse show" aria-labelledby="headingDetalhes" data-bs-parent="#accordionDetalhes">
                        <div class="row">
                            <div class="col-md-5">
                                <div class="text-left">
                                    <button type="button" class="btn btn-facebook" disabled>Competência</button>
                                    <button class="btn btn-danger" @onclick="IrParaPerformance">Performance</button>
                                    <button class="btn btn-info" @onclick="IrParaFinalizacao">Ir para Finalização</button>
                                    <p></p>
                                </div>
                            </div>
                            <div class="col-sm">
                                <div class="row">
                                    <div class="col-md-2"><label><b>Avaliado</b></label></div>
                                    <div class="col-md-4"><label>@Model?.Associado?.Nome</label></div>
                                    <div class="col-md-1"><label><b>Gestor</b></label></div>
                                    <div class="col-md-3"><label>@Model?.Gestor?.Nome</label></div>
                                    <div class="col-md-2"><label><b>Período</b></label></div>
                                    <div class="col-md-4"><label>@Model?.Periodo?.Nome</label></div>
                                </div>
                                <div class="row">
                                    <div class="col-md-2"><label><b>Tempo de Cargo:</b></label></div>
                                    <div class="col-md-4"><label>@Model?.TempoCargo</label></div>
                                    <div class="col-md-2"><label><b>Tempo de Peers</b></label></div>
                                    <div class="col-md-4"><label>@Model?.TempoPeers</label></div>
                                </div>
                                <div class="row">
                                    <div class="col-md-1"><label><b>Projeto</b></label></div>
                                    <div class="col-md-3"><label>@Model?.Projeto?.Nome</label></div>
                                    <div class="col-md-1"><label><b>Cliente</b></label></div>
                                    <div class="col-md-3"><label>@Model?.Projeto?.Cliente?.Nome</label></div>
                                    <div class="col-md-2"><label><b>Tempo restante</b></label></div>
                                    <div class="col-md-2"><label>@Model?.TempoRestante</label></div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="accordion" id="accordionCabecalho">
                <div class="card">
                    <div class="card-header" id="headingCabecalho">
                        <h5 class="mb-0">
                            <button class="btn btn-link" type="button" data-bs-toggle="collapse" data-bs-target="#Cabecalho" aria-expanded="true" aria-controls="Cabecalho">
                                Descrições nível atual e próximo nível
                            </button>
                        </h5>
                    </div>
                    <div id="Cabecalho" class="collapse show" aria-labelledby="headingCabecalho" data-bs-parent="#accordionCabecalho">
                        <table class="table table-striped border" style="width:100%;table-layout:fixed">
                            <thead>
                                <tr>
                                    <th colspan="1"></th>
                                    <th colspan="2">Cargo</th>
                                    <th colspan="2">Função</th>
                                    <th colspan="2">Autonomia</th>
                                    <th colspan="2">Escopo de Atuação</th>
                                    <th colspan="2">Nível de interlocução principal no cliente</th>
                                    @foreach (var titulo in Model?.CabecalhoTitulos ?? new List<string>())
                                    {
                                        <th colspan="2">@titulo</th>
                                    }
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td colspan="1">Nível atual</td>
                                    <td colspan="2">@Model?.CabecalhoCargoAtual</td>
                                    <td colspan="2">@Model?.CabecalhoFuncaoAtual</td>
                                    <td colspan="2">@Model?.CabecalhoAutonomiaAtual</td>
                                    <td colspan="2">@Model?.CabecalhoEscopoAtual</td>
                                    <td colspan="2">@Model?.CabecalhoInterlocucaoAtual</td>
                                    @foreach (var desc in Model?.CabecalhoDescricoesAtual ?? new List<string>())
                                    {
                                        <th colspan="2" style="font-weight:normal;">@desc</th>
                                    }
                                </tr>
                                <tr>
                                    <td colspan="1">Próximo nível</td>
                                    <td colspan="2">@Model?.CabecalhoCargoProximo</td>
                                    <td colspan="2">@Model?.CabecalhoFuncaoProximo</td>
                                    <td colspan="2">@Model?.CabecalhoAutonomiaProximo</td>
                                    <td colspan="2">@Model?.CabecalhoEscopoProximo</td>
                                    <td colspan="2">@Model?.CabecalhoInterlocucaoProximo</td>
                                    @foreach (var desc in Model?.CabecalhoDescricoesProximo ?? new List<string>())
                                    {
                                        <th colspan="2" style="font-weight:normal;">@desc</th>
                                    }
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

        </div>
    </div>

    <div class="card col-md-12" style="margin-top:220px">
        <div class="card-body">
            <div class="form-body">
                <div class="row">
                    <div class="col-md-12">
                        <div class="text-right">
                            <button class="btn btn-dark" @onclick="SalvarAvaliacao">Salvar Avaliação</button>
                        </div>
                    </div>
                </div>
            </div>

            <div class="table-responsive" style="overflow-y:auto !important; height:600px">
                <table class="table table-striped border" style="width:100%;table-layout:fixed">
                    <thead>
                        <tr>
                            <th colspan="7" style="background-color:#e5e019;color:#021240;position:sticky !important; top:-5px !important">Nível 1</th>
                            <th colspan="9" style="background-color:#e5e019;color:#021240;position:sticky !important; top:-5px !important">Nível 2</th>
                        </tr>
                        <tr>
                            <th colspan="4" style="color:#021240;background-color:#eae678;position:sticky !important; top:45px !important">Detalhamento Atual</th>
                            <th hidden>Nivel Atual</th>
                            <th colspan="3" style="color:#021240;background-color:#eae678;position:sticky !important; top:45px !important">Nota Avaliado</th>
                            <th colspan="4" style="color:#021240;background-color:#eae678;position:sticky !important; top:45px !important">Detalhamento Próximo Nível</th>
                            <th hidden>Próximo Nivel</th>
                            <th colspan="3" style="color:#021240;background-color:#eae678;position:sticky !important; top:45px !important">Nota Avaliado</th>
                            <th colspan="2" style="color:#021240;background-color:#eae678;position:sticky !important; top:45px !important">Considerações Avaliado</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model?.Competencias != null)
                        {
                            @foreach (var comp in Model.Competencias)
                            {
                                <tr style="font-style:italic;font-size:14px;font-weight:normal;background-color:#f2f2f2;vertical-align:bottom">
                                    <th colspan="16" style="font-style:normal;font-size:21px;font-weight:normal;align-content:center;text-align:center;border-top:5px solid;border-color:#003150">
                                        @comp.SubCompetencia
                                    </th>
                                </tr>
                                <tr style="font-weight:bold;background-color:#f5f5f5;border-top:none">
                                    <td colspan="16" style="text-align:center;border-top:none">@comp.PalavrasChave</td>
                                </tr>
                                <tr style="font-weight:normal;background-color:#f9f9f9;border-top:none">
                                    <td colspan="4" style="border-top:none;background-color:#f9f9f9">
                                        <a href="#det_@comp.IdCompetencia" data-bs-toggle="collapse" class="accordion-toggle">
                                            @comp.DetalheNivelAtual
                                            <span style="font-weight:bold">  Ver+</span>
                                        </a>
                                    </td>
                                    <td hidden colspan="1" style="border-top:none;background-color:#f9f9f9">
                                        <button type="button" data-bs-toggle="collapse" data-bs-target="#nivel_@comp.IdCompetencia" class="accordion-toggle"><span class="fas fa-align-justify" aria-hidden="true"></span></button>
                                    </td>
                                    <td colspan="3" style="border-top:none;background-color:#f9f9f9">
                                        <select class="form-control p-0 select2" style="width: 100%" @bind="comp.NotaNivel1" disabled="@comp.DisableNotaNivel1">
                                            @foreach (var nota in ComboHelper.GetNotasCompetenciaItems())
                                            {
                                                <option value="@nota.Value" disabled="@nota.IsDisabled">@nota.Text</option>
                                            }
                                        </select>
                                    </td>
                                    <td colspan="4" style="border-top:none;background-color:#f9f9f9">
                                        <a href="#detPrNivel_@comp.IdCompetencia" data-bs-toggle="collapse" class="accordion-toggle">
                                            @comp.DetalheProximoNivel
                                            <span style="font-weight:bold">  Ver+</span>
                                        </a>
                                    </td>
                                    <td hidden colspan="1" style="border-top:none;background-color:#f9f9f9">
                                        <button type="button" data-bs-toggle="collapse" data-bs-target="#prNivel_@comp.IdCompetencia" class="accordion-toggle">
                                            <span class="fas fa-align-justify" aria-hidden="true"></span>
                                        </button>
                                    </td>
                                    <td colspan="3" style="border-top:none;background-color:#f9f9f9">
                                        <select class="form-control p-0 select2" style="width: 100%" @bind="comp.NotaNivel2" disabled="@comp.DisableNotaNivel2">
                                            @foreach (var nota in ComboHelper.GetNotasCompetenciaItems())
                                            {
                                                <option value="@nota.Value" disabled="@nota.IsDisabled">@nota.Text</option>
                                            }
                                        </select>
                                    </td>
                                    <td colspan="2" style="border-top:none;background-color:#f9f9f9;text-align:center">
                                        <button type="button" data-bs-toggle="collapse" data-bs-target="#cons_@comp.IdCompetencia" class="accordion-toggle" style="background-color:#003150;padding:8px 15px;border:none">
                                            <span aria-hidden="true" style="color:white;font-size:15px">Considerações</span>
                                        </button>
                                    </td>
                                </tr>
                                <tr>
                                    <td colspan="16" class="hiddenRow" style="border-top:none;background-color:#ffffff">
                                        <div class="accordian-body collapse" id="det_@comp.IdCompetencia">
                                            <strong>Detalhamento Cargo Atual:</strong><br />@comp.DetalheNivelAtual
                                        </div>
                                    </td>
                                </tr>
                                <tr hidden>
                                    <td colspan="16" class="hiddenRow" style="border-top:none;background-color:#ffffff">
                                        <div class="accordian-body collapse" id="nivel_@comp.IdCompetencia">
                                            <strong>Nivel Atual:</strong></br>
                                            @comp.CompetenciaAtual
                                        </div>
                                    </td>
                                </tr>
                                <tr>
                                    <td colspan="16" class="hiddenRow" style="border-top:none;background-color:#ffffff">
                                        <div class="accordian-body collapse" id="detPrNivel_@comp.IdCompetencia">
                                            <strong>Detalhamento Próximo Nível:</strong></br>
                                            @comp.DetalheProximoNivel
                                        </div>
                                    </td>
                                </tr>
                                <tr hidden>
                                    <td colspan="16" class="hiddenRow">
                                        <div class="accordian-body collapse" id="prNivel_@comp.IdCompetencia">
                                            <strong>Próximo Nivel:</strong></br>
                                            @comp.CompetenciaProximo
                                        </div>
                                    </td>
                                </tr>
                                <tr>
                                    <td colspan="16" class="hiddenRow" style="border-top:none;background-color:#ffffff">
                                        <div class="accordian-body collapse" id="cons_@comp.IdCompetencia">
                                            <strong>Considerações:</strong></br>
                                            <textarea rows="5" class="form-control" @bind="comp.Consideracoes" disabled="@comp.DisableConsideracoes"></textarea>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>

            <div class="form-body">
                <div class="row">
                    <div class="col-md-12">
                        <div class="text-right">
                            <button class="btn btn-dark" @onclick="SalvarAvaliacao">Salvar Avaliação</button>
                        </div>
                    </div>
                </div>
            </div>

        </div>
        <div class="card">
            <div class="card-body">
                <div class="col-md-5">
                    <div class="text-left">
                        <button type="button" class="btn btn-facebook" disabled>Competência</button>
                        <button class="btn btn-danger" @onclick="IrParaPerformance">Performance</button>
                        <button class="btn btn-info" @onclick="IrParaFinalizacao">Ir para Finalização</button>
                        <p></p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private AvaliacaoCompetenciaViewModel? Model;
    private bool IsLoading = true;

    protected override async Task OnInitializedAsync()
    {
        IsLoading = true;
        Model = await AvaliacaoCompetenciaService.ObterAvaliacaoCompetenciaViewModelAsync();
        IsLoading = false;
    }

    private async Task SalvarAvaliacao()
    {
        if (Model == null)
            return;
        var resultado = await AvaliacaoCompetenciaService.SalvarAvaliacaoCompetenciaAsync(Model);
        if (resultado.Sucesso)
        {
            MessageBoxService.ShowSuccess(resultado.Mensagem ?? "Avaliação Salva com Sucesso.");
        }
        else
        {
            MessageBoxService.ShowError(resultado.Mensagem ?? "Falha ao Salvar Avaliação.");
        }
    }

    private void IrParaPerformance()
    {
        NavigationManager.NavigateTo("/avaliacao-performance");
    }

    private void IrParaFinalizacao()
    {
        NavigationManager.NavigateTo("/avaliacao-finalizacao");
    }
}
