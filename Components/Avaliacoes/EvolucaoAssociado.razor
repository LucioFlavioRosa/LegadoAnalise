@page "/evolucao-associado"
@rendermode InteractiveAuto
@using Peers.Moderno.Services.Avaliacoes.Common
@using Peers.Moderno.Services.Common
@using Peers.Moderno.Components.Shared
@inject IEvolucaoAssociadoService EvolucaoService
@inject IMessageBoxService MessageBoxService
@inject IJSRuntime JSRuntime
@inject IHttpContextAccessor HttpContextAccessor

<PageTitle>Evolução do Associado</PageTitle>

<MessageBox />

<div class="page-breadcrumb border-bottom">
    <div class="row">
        <div class="col-lg-3 col-md-4 col-xs-12 align-self-center">
            <h5 class="font-medium text-uppercase mb-0">Associado</h5>
        </div>
        <div class="col-lg-9 col-md-8 col-xs-12 align-self-center">
            <nav aria-label="breadcrumb" class="mt-2 float-md-right float-left">
                <ol class="breadcrumb mb-0 justify-content-end p-0">
                    <li class="breadcrumb-item"><a href="/">Peers</a></li>
                    <li class="breadcrumb-item"><a href="/">Competência / Performance</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Evolução</li>
                </ol>
            </nav>
        </div>
    </div>
</div>

<div class="page-content container-fluid">
    <!-- Informações do Associado -->
    <div class="card">
        <div class="card-body">
            <div class="form-body">
                <div class="row">
                    <div class="col-md-12">
                        <div class="row">
                            <div class="col-md-1">
                                <label><b>Avaliado</b></label>
                            </div>
                            <div class="col-md-4">
                                <label>@viewModel.AssociadoInfo.Nome</label>
                            </div>
                            <div class="col-md-2">
                                <label><b>Mentor</b></label>
                            </div>
                            <div class="col-md-5">
                                <label>@viewModel.AssociadoInfo.Mentor</label>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-1">
                                <label><b>Cargo</b></label>
                            </div>
                            <div class="col-md-4">
                                <label>@viewModel.AssociadoInfo.Cargo</label>
                            </div>
                            <div class="col-md-2">
                                <label><b>Próximo Cargo</b></label>
                            </div>
                            <div class="col-md-5">
                                <label>@viewModel.AssociadoInfo.ProximoCargo</label>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Filtros -->
    <div class="card">
        <div class="card-body">
            <div class="form-body">
                <div class="row">
                    <div class="col-md-3">
                        <ComboSelect 
                            Label="Tipo de Avaliações"
                            Options="@tiposAvaliacaoOptions"
                            @bind-SelectedValue="selectedTipoAvaliacao"
                            Width="80%" />
                    </div>
                    <div class="col-md-3">
                        <ComboSelect 
                            Label="Escopo"
                            Options="@escoposOptions"
                            @bind-SelectedValue="selectedEscopo"
                            Width="80%" />
                    </div>
                    <div class="col-md-3">
                        <button type="button" class="btn btn-info" @onclick="GerarEvolucao" disabled="@isLoading">
                            @if (isLoading)
                            {
                                <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                                <text> Carregando...</text>
                            }
                            else
                            {
                                <text>Gerar Evolução</text>
                            }
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Resultados -->
    @if (viewModel.HasData)
    {
        <div class="card">
            <div class="card-body">
                <div class="row">
                    @foreach (var projeto in viewModel.Projetos)
                    {
                        <div class="col-md-3">
                            <div class="row">
                                <div class="col-md-12">
                                    <!-- Competências -->
                                    <table class="table table-striped border tbresultado">
                                        <tbody>
                                            <tr>
                                                <td colspan="2" class="text-center">@projeto.Cargo</td>
                                            </tr>
                                            <tr>
                                                <td class="tdresultado">Período</td>
                                                <td class="text-center">@projeto.Periodo</td>
                                            </tr>
                                            <tr>
                                                <td class="tdresultado">Nota Competências</td>
                                                <td class="text-center"><b>@FormatHelper.FormatPercent(projeto.NotaCompetencia)</b></td>
                                            </tr>
                                            @foreach (var competencia in projeto.Competencias)
                                            {
                                                <tr>
                                                    <td>@competencia.Eixo</td>
                                                    <td class="text-center">@FormatHelper.FormatPercent(competencia.NotaNeutra)</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>

                                    <!-- Performance -->
                                    @if (projeto.ExibirPerformance)
                                    {
                                        <table class="table table-striped border tbresultado">
                                            <tbody>
                                                <tr>
                                                    <td class="text-center" colspan="2">@projeto.RatingPerformance</td>
                                                </tr>
                                                <tr>
                                                    <td class="tdresultado">Nota Performance</td>
                                                    <td class="text-center">
                                                        <b>@FormatHelper.FormatDecimalNullable(projeto.NotaPerformance)</b>
                                                    </td>
                                                </tr>
                                                @foreach (var performance in projeto.Performances)
                                                {
                                                    <tr>
                                                        <td>@performance.Performance</td>
                                                        <td class="text-center">@FormatHelper.FormatDecimal(performance.Nota)</td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
                <br />
                <!-- Gráfico Radar -->
                <div class="row" style="display:flex;justify-content:center">
                    <div style="width:70%;height:70%; margin: 15px;">
                        <canvas id="radarassociado" width="120" height="120" style="padding: 25px;"></canvas>
                    </div>
                </div>
            </div>
        </div>
    }
    else if (!string.IsNullOrEmpty(viewModel.ErrorMessage))
    {
        <div class="alert alert-danger" role="alert">
            <strong>Erro:</strong> @viewModel.ErrorMessage
        </div>
    }
</div>

@code {
    private EvolucaoAssociadoViewModel viewModel = new();
    private List<ComboItem> tiposAvaliacaoOptions = new();
    private List<ComboItem> escoposOptions = new();
    private string selectedTipoAvaliacao = string.Empty;
    private string selectedEscopo = string.Empty;
    private bool isLoading = false;
    private int associadoId = 0;

    protected override async Task OnInitializedAsync()
    {
        tiposAvaliacaoOptions = ComboHelper.GetTiposAvaliacaoItems();
        escoposOptions = ComboHelper.GetEscoposItems();
        
        selectedTipoAvaliacao = tiposAvaliacaoOptions.First().Value;
        selectedEscopo = escoposOptions.First().Value;

        // Simular obtenção do ID do usuário logado
        // Em um cenário real, isso viria da sessão ou contexto de autenticação
        associadoId = ObterAssociadoLogado();
    }

    private async Task GerarEvolucao()
    {
        if (string.IsNullOrEmpty(selectedTipoAvaliacao) || selectedTipoAvaliacao == "" ||
            string.IsNullOrEmpty(selectedEscopo) || selectedEscopo == "")
        {
            MessageBoxService.ShowError("Selecione o Tipo de Avaliações e Escopo");
            return;
        }

        isLoading = true;
        StateHasChanged();

        try
        {
            viewModel = await EvolucaoService.ObterEvolucaoAssociadoAsync(associadoId, selectedTipoAvaliacao, selectedEscopo);
            
            if (!string.IsNullOrEmpty(viewModel.ErrorMessage))
            {
                MessageBoxService.ShowError(viewModel.ErrorMessage);
            }
            else if (viewModel.HasData)
            {
                await RenderizarGraficoRadar();
            }
        }
        catch (Exception ex)
        {
            MessageBoxService.ShowError($"Erro ao carregar dados: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task RenderizarGraficoRadar()
    {
        if (!string.IsNullOrEmpty(viewModel.JsonRadar))
        {
            await JSRuntime.InvokeVoidAsync("renderRadarChart", "radarassociado", viewModel.JsonRadar);
        }
    }

    private int ObterAssociadoLogado()
    {
        // Implementar lógica para obter o ID do associado logado
        // Por exemplo, da sessão ou contexto de autenticação
        var httpContext = HttpContextAccessor.HttpContext;
        if (httpContext?.Session != null)
        {
            var userId = httpContext.Session.GetString("UserId");
            if (int.TryParse(userId, out int id))
            {
                return id;
            }
        }
        
        // Valor padrão para desenvolvimento/teste
        return 1;
    }
}