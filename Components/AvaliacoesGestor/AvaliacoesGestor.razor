@rendermode InteractiveAuto
@using Peers.Moderno.Services.AvaliacoesGestor
@using Peers.Moderno.Services.AvaliacoesGestor.Common
@using Peers.Moderno.Services.Common
@inject IAvaliacoesGestorService AvaliacoesGestorService
@inject IAvaliacoesGestorHelper AvaliacoesGestorHelper
@inject IMessageBoxService MessageBoxService

<PageTitle>Avaliação do Gestor</PageTitle>

<div class="page-breadcrumb border-bottom">
    <div class="row">
        <div class="col-lg-3 col-md-4 col-xs-12 align-self-center">
            <h5 class="font-medium text-uppercase mb-0">@TituloPagina</h5>
        </div>
        <div class="col-lg-9 col-md-8 col-xs-12 align-self-center">
            <nav aria-label="breadcrumb" class="mt-2 float-md-right float-left">
                <ol class="breadcrumb mb-0 justify-content-end p-0">
                    <li class="breadcrumb-item"><a href="index">Peers</a></li>
                    <li class="breadcrumb-item active" aria-current="page">@SubTituloPagina</li>
                </ol>
            </nav>
        </div>
    </div>
</div>

<div class="page-content container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-body">
                    <h4 class="card-title">Filtro avaliações</h4>
                    <EditForm Model="@Filtro" OnValidSubmit="BuscarAvaliacoes">
                        <div class="form-body">
                            <div class="row">
                                <div class="col-md-3">
                                    <div class="form-group">
                                        <label>Projeto</label>
                                        <InputSelect class="form-control select2" @bind-Value="Filtro.ProjetoId">
                                            @foreach (var projeto in ProjetosCombo)
                                            {
                                                <option value="@projeto.Value">@projeto.Text</option>
                                            }
                                        </InputSelect>
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="form-group">
                                        <label>Cliente</label>
                                        <InputSelect class="form-control select2" @bind-Value="Filtro.ClienteId">
                                            @foreach (var cliente in ClientesCombo)
                                            {
                                                <option value="@cliente.Value">@cliente.Text</option>
                                            }
                                        </InputSelect>
                                    </div>
                                </div>
                                <div class="col-md-2">
                                    <div class="form-group">
                                        <label>Período</label>
                                        <InputSelect class="form-control select2" @bind-Value="Filtro.PeriodoId">
                                            @foreach (var periodo in PeriodosCombo)
                                            {
                                                <option value="@periodo.Value">@periodo.Text</option>
                                            }
                                        </InputSelect>
                                    </div>
                                </div>
                                <div class="col-md-2">
                                    <div class="form-group">
                                        <label>Status</label>
                                        <InputSelect class="form-control select2" @bind-Value="Filtro.StatusId">
                                            @foreach (var status in StatusCombo)
                                            {
                                                <option value="@status.Value">@status.Text</option>
                                            }
                                        </InputSelect>
                                    </div>
                                </div>
                                <div class="col-md-2">
                                    <div class="form-group">
                                        <label>Etapa da Avaliação</label>
                                        <InputSelect class="form-control select2" @bind-Value="Filtro.Etapa">
                                            @foreach (var etapa in EtapasCombo)
                                            {
                                                <option value="@etapa.Value">@etapa.Text</option>
                                            }
                                        </InputSelect>
                                    </div>
                                </div>
                                <div class="col-md-2 d-flex align-items-end">
                                    <button type="submit" class="btn btn-danger w-100">Filtrar</button>
                                </div>
                            </div>
                        </div>
                    </EditForm>

                    <div class="table-responsive mt-4">
                        @if (ProjetosAvaliacoes?.Any() == true)
                        {
                            <table class="table table-striped border dtInit">
                                <thead>
                                    <tr>
                                        <th>Código</th>
                                        <th>Projeto</th>
                                        <th>Cliente</th>
                                        <th>Status</th>
                                        <th>Dt. Início Projeto</th>
                                        <th>Dt. Término Projeto</th>
                                        <th>Responsável</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var projeto in ProjetosAvaliacoes)
                                    {
                                        <tr>
                                            <td>@projeto.Id</td>
                                            <td>@projeto.Nome</td>
                                            <td>@projeto.Cliente?.Nome</td>
                                            <td>@projeto.Status?.Nome</td>
                                            <td>@projeto.DataInicio</td>
                                            <td>@projeto.DataTermino</td>
                                            <td>@projeto.Responsavel?.Nome</td>
                                        </tr>
                                        <tr>
                                            <td></td>
                                            <td colspan="6">
                                                @if (projeto.Associados?.Any() == true)
                                                {
                                                    <AvaliacoesGestorAssociadosTable Associados="@projeto.Associados" OnFinalizar="FinalizarAvaliacao" />
                                                }
                                                @if (projeto.Lideres?.Any() == true)
                                                {
                                                    <AvaliacoesGestorLideresTable Lideres="@projeto.Lideres" OnFinalizar="FinalizarAvaliacao" OnLiberarLider="LiberarLider" />
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }
                        else
                        {
                            <div class="alert alert-info">Nenhuma avaliação encontrada para os filtros selecionados.</div>
                        }
                    </div>
                </div>
            </div>
            @if (AvaliacoesLiderados?.Any() == true)
            {
                <div class="card mt-4">
                    <div class="card-body">
                        <h4 class="card-title">Avaliações de liderança finalizadas por seus liderados:</h4>
                        <div class="table-responsive">
                            <AvaliacoesGestorLideradosTable Avaliacoes="@AvaliacoesLiderados" />
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<MessageBoxHandler />
