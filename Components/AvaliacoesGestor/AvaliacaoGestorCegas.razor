@rendermode InteractiveAuto
@page "/avalicao-gestor-cegas"
@inject Services.AvaliacoesGestor.Common.IAvaliacoesGestorService AvaliacoesGestorService
@inject Services.Common.IMessageBoxService MessageBoxService
@inject Services.Common.ComboHelper ComboHelper
@inject Microsoft.AspNetCore.Components.NavigationManager NavigationManager

<PageTitle>Avaliação do Gestor às Cegas</PageTitle>

<div class="page-breadcrumb border-bottom">
    <div class="row">
        <div class="col-lg-3 col-md-4 col-xs-12 align-self-center">
            <h5 class="font-medium text-uppercase mb-0">Avaliação do Gestor às Cegas</h5>
        </div>
        <div class="col-lg-9 col-md-8 col-xs-12 align-self-center">
            <nav aria-label="breadcrumb" class="mt-2 float-md-right float-left">
                <ol class="breadcrumb mb-0 justify-content-end p-0">
                    <li class="breadcrumb-item"><a href="/">Peers</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Avaliação / Gestor às Cegas</li>
                </ol>
            </nav>
        </div>
    </div>
</div>

<div class="page-content container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-body">
                    <h4 class="card-title">Filtro avaliações</h4>
                    <EditForm Model="@Filtro" OnValidSubmit="OnFiltrarAvaliacoes">
                        <div class="form-body">
                            <div class="row">
                                <div class="col-md-3">
                                    <div class="form-group">
                                        <label>Projeto</label>
                                        <InputSelect class="form-control p-0 select2" style="width: 100%" @bind-Value="Filtro.ProjetoId">
                                            @foreach (var projeto in ProjetosCombo)
                                            {
                                                <option value="@projeto.Value">@projeto.Text</option>
                                            }
                                        </InputSelect>
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="form-group">
                                        <label>Cliente</label>
                                        <InputSelect class="form-control p-0 select2" style="width: 100%" @bind-Value="Filtro.ClienteId">
                                            @foreach (var cliente in ClientesCombo)
                                            {
                                                <option value="@cliente.Value">@cliente.Text</option>
                                            }
                                        </InputSelect>
                                    </div>
                                </div>
                                <div class="col-md-2">
                                    <div class="form-group">
                                        <label>Período</label>
                                        <InputSelect class="form-control p-0 select2" style="width: 100%" @bind-Value="Filtro.PeriodoId">
                                            @foreach (var periodo in PeriodosCombo)
                                            {
                                                <option value="@periodo.Value">@periodo.Text</option>
                                            }
                                        </InputSelect>
                                    </div>
                                </div>
                                <div class="col-md-2">
                                    <div class="form-group">
                                        <label>Status</label>
                                        <InputSelect class="form-control p-0 select2" style="width: 100%" @bind-Value="Filtro.StatusId">
                                            @foreach (var status in StatusCombo)
                                            {
                                                <option value="@status.Value">@status.Text</option>
                                            }
                                        </InputSelect>
                                    </div>
                                </div>
                                <div class="col-md-2 d-flex align-items-end">
                                    <button type="submit" class="btn btn-danger w-100">Filtrar</button>
                                </div>
                            </div>
                        </div>
                    </EditForm>

                    <div class="table-responsive mt-4">
                        @if (ProjetosAvaliacoes?.Any() == true)
                        {
                            <table class="table table-striped border dtInit" id="dtInit">
                                <thead>
                                    <tr>
                                        <th>Código</th>
                                        <th>Projeto</th>
                                        <th>Cliente</th>
                                        <th>Status(Ativo/Inativo)</th>
                                        <th>Dt. Início Projeto</th>
                                        <th>Dt. Término Projeto</th>
                                        <th>Responsável</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var projeto in ProjetosAvaliacoes)
                                    {
                                        <tr>
                                            <td>@projeto.Id</td>
                                            <td>@projeto.Nome</td>
                                            <td>@projeto.Cliente?.Nome</td>
                                            <td>@projeto.Status?.Status</td>
                                            <td>@projeto.DataInicio</td>
                                            <td>@projeto.DataTermino</td>
                                            <td>@projeto.Responsavel?.Nome</td>
                                        </tr>
                                        <tr>
                                            <td></td>
                                            <td colspan="6">
                                                @if (projeto.Associados?.Any() == true)
                                                {
                                                    <div class="table-responsive">
                                                        <table class="table table-striped border">
                                                            <thead>
                                                                <tr>
                                                                    <th>Foto</th>
                                                                    <th>Profissional</th>
                                                                    <th>Cargo</th>
                                                                    <th>Período</th>
                                                                    <th>Início</th>
                                                                    <th>Término</th>
                                                                    <th>Gestor</th>
                                                                    <th>Avaliador</th>
                                                                    <th>Mentor</th>
                                                                    <th>Etapa</th>
                                                                    <th></th>
                                                                </tr>
                                                            </thead>
                                                            <tbody>
                                                                @foreach (var associado in projeto.Associados)
                                                                {
                                                                    <tr>
                                                                        <td>
                                                                            <img src="@associado.Associado.FotoNome" width="120" height="120" />
                                                                        </td>
                                                                        <td>@associado.Associado.Nome</td>
                                                                        <td>@associado.Associado.CARGOS?.Cargo</td>
                                                                        <td>@associado.Periodo?.Periodo</td>
                                                                        <td>@associado.DataInicio</td>
                                                                        <td>@associado.DataTermino</td>
                                                                        <td>@associado.Gestor?.Nome</td>
                                                                        <td>@associado.Avaliador?.Nome</td>
                                                                        <td>@associado.Associado.ASSOCIADOS3?.Nome</td>
                                                                        <td>@associado.Etapa</td>
                                                                        <td style="text-align: right;">
                                                                            <a href="@($"/avalicao-gestor-cegas-competencia?IdProjeto={associado.Projeto.IdProjeto}&IdAssociado={associado.Associado.IdAssociado}&IdPeriodo={associado.Periodo.IdPeriodo}&TipoAvaliacao={associado.TipoAvaliacao}&Escopo={associado.Escopo}&idGestor={associado.Gestor.IdAssociado}")">
                                                                                <button type="button" class="btn btn-info" disabled="@(associado.IsHidden)">@associado.RotuloBotao</button>
                                                                            </a>
                                                                            @if (associado.ExibirBotaoFinalizar)
                                                                            {
                                                                                <button type="button" class="btn btn-dark" @onclick="() => FinalizarAvaliacao(associado.IdEmail)">Finalizar Avaliação</button>
                                                                            }
                                                                        </td>
                                                                    </tr>
                                                                }
                                                            </tbody>
                                                        </table>
                                                    </div>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }
                        else
                        {
                            <div class="alert alert-info mt-3">Nenhuma avaliação encontrada para os filtros selecionados.</div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
