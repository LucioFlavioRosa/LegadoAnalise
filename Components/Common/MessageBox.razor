@inject Services.Common.IMessageBoxService MessageBoxService

<div class="alert @AlertClass" role="alert" style="@DisplayStyle" @onclick="OnClose">
    <span>@Message</span>
    @if (ShowCloseButton)
    {
        <button type="button" class="close" aria-label="Close" @onclick="OnClose">
            <span aria-hidden="true">&times;</span>
        </button>
    }
</div>

@code {
    private string Message { get; set; }
    private string AlertClass { get; set; } = "alert-info";
    private string DisplayStyle { get; set; } = "display:none;";
    private bool ShowCloseButton { get; set; } = true;
    private System.Timers.Timer AutoHideTimer;

    protected override void OnInitialized()
    {
        MessageBoxService.OnMessageReceived += HandleMessageReceived;
    }

    public void ShowSuccess(string message)
    {
        Show(message, "alert-success");
    }
    public void ShowError(string message)
    {
        Show(message, "alert-danger");
    }
    public void ShowInfo(string message)
    {
        Show(message, "alert-info");
    }
    public void ShowWarning(string message)
    {
        Show(message, "alert-warning");
    }
    private void Show(string message, string alertClass)
    {
        Message = message;
        AlertClass = alertClass;
        DisplayStyle = "";
        ShowCloseButton = true;
        StateHasChanged();
        StartAutoHideTimer();
    }
    private void HandleMessageReceived(Services.Common.MessageBoxEventArgs args)
    {
        switch (args.Type)
        {
            case Services.Common.MessageBoxType.Success:
                ShowSuccess(args.Message);
                break;
            case Services.Common.MessageBoxType.Error:
                ShowError(args.Message);
                break;
            case Services.Common.MessageBoxType.Info:
                ShowInfo(args.Message);
                break;
            case Services.Common.MessageBoxType.Warning:
                ShowWarning(args.Message);
                break;
        }
    }
    private void OnClose()
    {
        DisplayStyle = "display:none;";
        StateHasChanged();
    }
    private void StartAutoHideTimer()
    {
        AutoHideTimer?.Dispose();
        AutoHideTimer = new System.Timers.Timer(5000);
        AutoHideTimer.Elapsed += (s, e) =>
        {
            AutoHideTimer.Stop();
            DisplayStyle = "display:none;";
            InvokeAsync(StateHasChanged);
        };
        AutoHideTimer.AutoReset = false;
        AutoHideTimer.Start();
    }
    public void Dispose()
    {
        MessageBoxService.OnMessageReceived -= HandleMessageReceived;
        AutoHideTimer?.Dispose();
    }
}
