@using Peers.Moderno.Models
@using Microsoft.AspNetCore.Components
@inject IConfiguration Configuration

@typeparam TPerformance

<div class="@PerformanceTableClass">
    <table class="@PerformanceTableStyle">
        <thead>
            <tr>
                <th>Performance</th>
                <th>Abaixo</th>
                <th>Esperado</th>
                <th>Acima</th>
                <th>Nota Avaliado</th>
                <th>Considerações Avaliado</th>
            </tr>
        </thead>
        <tbody>
            @if (Performances != null)
            {
                string? lastAbrangencia = null;
                foreach (var perf in Performances)
                {
                    var abrangencia = GetAbrangencia(perf);
                    if (abrangencia != lastAbrangencia)
                    {
                        <tr>
                            <td colspan="6" style="@SeparatorStyle">@abrangencia</td>
                        </tr>
                        lastAbrangencia = abrangencia;
                    }
                    <tr>
                        <td>
                            <input type="hidden" value="@GetIdPerformance(perf)" />
                            @GetDescricao(perf)
                            <br />
                            <label style="@DisclaimerStyle">@GetDisclaimer(perf)</label>
                        </td>
                        <td>
                            <a href="#abaixo_@GetIdPerformance(perf)" data-target="#abaixo_@GetIdPerformance(perf)" data-toggle="collapse" class="accordion-toggle">
                                @TruncateText(GetAbaixo(perf), TruncateLength)
                                <span style="font-weight:bold">  @ExpandButtonText</span>
                            </a>
                        </td>
                        <td>
                            <a href="#esperado_@GetIdPerformance(perf)" data-target="#esperado_@GetIdPerformance(perf)" data-toggle="collapse" class="accordion-toggle">
                                @TruncateText(GetEsperado(perf), TruncateLength)
                                <span style="font-weight:bold">  @ExpandButtonText</span>
                            </a>
                        </td>
                        <td>
                            <a href="#acima_@GetIdPerformance(perf)" data-target="#acima_@GetIdPerformance(perf)" data-toggle="collapse" class="accordion-toggle">
                                @TruncateText(GetAcima(perf), TruncateLength)
                                <span style="font-weight:bold">  @ExpandButtonText</span>
                            </a>
                        </td>
                        <td>
                            <select class="@SelectClass" style="@SelectStyle" @onchange="e => OnNotaChanged(perf, e)">
                                @foreach (var nota in Notas)
                                {
                                    <option value="@nota.Value" selected="@(GetNota(perf) == nota.Value)">@nota.Text</option>
                                }
                            </select>
                        </td>
                        <td class="text-center">
                            <button type="button" data-toggle="collapse" data-target="#obs_@GetIdPerformance(perf)" class="accordion-toggle" style="@ConsideracoesButtonStyle">
                                <span aria-hidden="true" style="@ConsideracoesTextStyle">@ConsideracoesButtonText</span>
                            </button>
                        </td>
                    </tr>
                    <tr>
                        <td colspan="10" class="@HiddenRowClass">
                            <div class="@AccordionBodyClass" id="abaixo_@GetIdPerformance(perf)">[Abaixo] @GetAbaixo(perf)</div>
                        </td>
                    </tr>
                    <tr>
                        <td colspan="10" class="@HiddenRowClass">
                            <div class="@AccordionBodyClass" id="esperado_@GetIdPerformance(perf)">[Esperado] @GetEsperado(perf)</div>
                        </td>
                    </tr>
                    <tr>
                        <td colspan="10" class="@HiddenRowClass">
                            <div class="@AccordionBodyClass" id="acima_@GetIdPerformance(perf)">[Acima] @GetAcima(perf)</div>
                        </td>
                    </tr>
                    <tr>
                        <td colspan="10" class="@HiddenRowClass">
                            <div class="@AccordionBodyClass" id="obs_@GetIdPerformance(perf)">
                                <strong>Considerações:</strong><br />
                                <textarea rows="@TextAreaRows" class="@TextAreaClass" @onchange="e => OnObservacaoChanged(perf, e)">@GetObservacao(perf)</textarea>
                            </div>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

@code {
    [Parameter] public List<TPerformance>? Performances { get; set; }
    [Parameter] public List<ComboItem> Notas { get; set; } = new();
    [Parameter] public EventCallback<(TPerformance, string)> NotaChanged { get; set; }
    [Parameter] public EventCallback<(TPerformance, string)> ObservacaoChanged { get; set; }

    private int TruncateLength => Configuration.GetValue<int>("AutoAvaliacao:Performance:TruncateTextLength", 45);
    private string ExpandButtonText => Configuration["AutoAvaliacao:Performance:ExpandButtonText"] ?? "Ver+";
    private string PerformanceTableClass => Configuration["AutoAvaliacao:Performance:TableResponsiveClass"] ?? "table-responsive";
    private string PerformanceTableStyle => Configuration["AutoAvaliacao:Performance:TableClass"] ?? "table table-striped border";
    private string DisclaimerStyle => Configuration["AutoAvaliacao:Performance:DisclaimerStyle"] ?? "font-size:13px;font-weight:normal;font-style:italic;color:darkred";
    private string SeparatorStyle => Configuration["AutoAvaliacao:Performance:SeparadorAbrangencia:SeparatorStyle"] ?? "text-align:center;font-size:16px";
    private string ConsideracoesButtonStyle => Configuration["AutoAvaliacao:Performance:ConsideracoesButtonStyle"] ?? "background-color:#003150;padding:8px 15px;border:none";
    private string ConsideracoesTextStyle => Configuration["AutoAvaliacao:Performance:ConsideracoesTextStyle"] ?? "color:white;font-size:15px";
    private string HiddenRowClass => Configuration["AutoAvaliacao:Performance:HiddenRowClass"] ?? "hiddenRow";
    private string AccordionBodyClass => Configuration["AutoAvaliacao:Performance:AccordionBodyClass"] ?? "accordian-body collapse";
    private int TextAreaRows => Configuration.GetValue<int>("AutoAvaliacao:Performance:TextAreaRows", 5);
    private string TextAreaClass => Configuration["AutoAvaliacao:Performance:TextAreaClass"] ?? "form-control";
    private string SelectClass => Configuration["AutoAvaliacao:Performance:SelectClass"] ?? "form-control p-0 select2";
    private string SelectStyle => Configuration["AutoAvaliacao:Performance:SelectStyle"] ?? "width: 100%";
    private string ConsideracoesButtonText => Configuration["AutoAvaliacao:Performance:ConsideracoesButtonText"] ?? "Considerações";

    private string TruncateText(string? texto, int qtdCaracter)
    {
        if (string.IsNullOrEmpty(texto)) return string.Empty;
        return texto.Length > qtdCaracter ? texto.Substring(0, qtdCaracter) + "..." : texto;
    }

    private string GetAbrangencia(TPerformance perf)
    {
        var prop = perf?.GetType().GetProperty("Abrangencia");
        return prop?.GetValue(perf)?.ToString() ?? string.Empty;
    }
    private string GetIdPerformance(TPerformance perf)
    {
        var prop = perf?.GetType().GetProperty("IdPerformance");
        return prop?.GetValue(perf)?.ToString() ?? string.Empty;
    }
    private string GetDescricao(TPerformance perf)
    {
        var prop = perf?.GetType().GetProperty("Descricao");
        return prop?.GetValue(perf)?.ToString() ?? string.Empty;
    }
    private string GetAbaixo(TPerformance perf)
    {
        var prop = perf?.GetType().GetProperty("Abaixo");
        return prop?.GetValue(perf)?.ToString() ?? string.Empty;
    }
    private string GetEsperado(TPerformance perf)
    {
        var prop = perf?.GetType().GetProperty("Esperado");
        return prop?.GetValue(perf)?.ToString() ?? string.Empty;
    }
    private string GetAcima(TPerformance perf)
    {
        var prop = perf?.GetType().GetProperty("Acima");
        return prop?.GetValue(perf)?.ToString() ?? string.Empty;
    }
    private string GetNota(TPerformance perf)
    {
        var prop = perf?.GetType().GetProperty("Nota");
        return prop?.GetValue(perf)?.ToString() ?? "0";
    }
    private string GetObservacao(TPerformance perf)
    {
        var prop = perf?.GetType().GetProperty("Observacao");
        return prop?.GetValue(perf)?.ToString() ?? string.Empty;
    }
    private string GetDisclaimer(TPerformance perf)
    {
        var prop = perf?.GetType().GetProperty("DisclaimerInput");
        return prop?.GetValue(perf)?.ToString() ?? string.Empty;
    }

    private async Task OnNotaChanged(TPerformance perf, ChangeEventArgs e)
    {
        if (NotaChanged.HasDelegate)
            await NotaChanged.InvokeAsync((perf, e.Value?.ToString() ?? ""));
    }
    private async Task OnObservacaoChanged(TPerformance perf, ChangeEventArgs e)
    {
        if (ObservacaoChanged.HasDelegate)
            await ObservacaoChanged.InvokeAsync((perf, e.Value?.ToString() ?? ""));
    }
}
