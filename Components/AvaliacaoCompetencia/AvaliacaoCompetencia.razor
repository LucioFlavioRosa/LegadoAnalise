@page "/avaliacao-competencia"
@inject Services.Competencias.CompetenciasService CompetenciasService
@inject Services.Competencias.Common.CompetenciaHelper CompetenciaHelper
@inject Services.Common.ComboHelper ComboHelper
@inject Services.Common.MessageBoxService MessageBoxService
@inject NavigationManager NavigationManager

<PageTitle>Avaliação de Competências</PageTitle>

@if (IsLoading)
{
    <div class="text-center mt-5">
        <span class="spinner-border" role="status" aria-hidden="true"></span>
        <span class="sr-only">Carregando...</span>
    </div>
}
else if (ErroMensagem != null)
{
    <div class="alert alert-danger">@ErroMensagem</div>
}
else
{
    <div class="page-breadcrumb border-bottom" style="position:sticky;top:0;z-index:1;background:white;width:100%">
        <div class="row">
            <div class="col-lg-3 col-md-4 col-xs-12 align-self-center">
                <h5 class="font-medium text-uppercase mb-0">Auto Avaliação</h5>
            </div>
            <div class="col-lg-9 col-md-8 col-xs-12 align-self-center">
                <nav aria-label="breadcrumb" class="mt-2 float-md-right float-left">
                    <ol class="breadcrumb mb-0 justify-content-end p-0">
                        <li class="breadcrumb-item"><a href="/">Peers</a></li>
                        <li class="breadcrumb-item"><a href="/">Avaliação / Auto Avaliação</a></li>
                        <li class="breadcrumb-item active" aria-current="page">Competência</li>
                    </ol>
                </nav>
            </div>
        </div>
    </div>

    <div class="page-content container-fluid">
        <div class="card col-md-10 mx-auto" style="position:sticky;top:48px;z-index:1;margin-top:21px;border-color:rgba(0, 0, 0, .25);border-width:1px">
            <div class="card-body">
                <div class="accordion" id="accordionDetalhes">
                    <div class="card">
                        <div class="card-header" id="headingDetalhes">
                            <h5 class="mb-0">
                                <button class="btn btn-link" type="button" @onclick="() => ToggleAccordion('detalhes')" aria-expanded="@AccordionOpen["detalhes"]" aria-controls="Detalhes">
                                    Detalhes da avaliação
                                </button>
                            </h5>
                        </div>
                        <div id="Detalhes" class="collapse @(AccordionOpen["detalhes"] ? "show" : "")" aria-labelledby="headingDetalhes" data-parent="#accordionDetalhes">
                            <div class="row">
                                <div class="col-md-5">
                                    <div class="text-left">
                                        <button type="button" class="btn btn-facebook" disabled>Competência</button>
                                        <button class="btn btn-danger ml-2" @onclick="IrPerformance">Performance</button>
                                        <button class="btn btn-info ml-2" @onclick="Finalizar">Ir para Finalização</button>
                                        <p></p>
                                    </div>
                                </div>
                                <div class="col-sm">
                                    <div class="row">
                                        <div class="col-md-2"><label><b>Avaliado</b></label></div>
                                        <div class="col-md-4"><label>@DetalhesAssociado?.Nome</label></div>
                                        <div class="col-md-2"><label><b>Período</b></label></div>
                                        <div class="col-md-4"><label>@DetalhesPeriodo?.Nome</label></div>
                                    </div>
                                    <div class="row">
                                        <div class="col-md-2"><label><b>Tempo de Cargo:</b></label></div>
                                        <div class="col-md-4"><label>@DetalhesAssociado?.TempoCargo</label></div>
                                        <div class="col-md-2"><label><b>Tempo de Peers</b></label></div>
                                        <div class="col-md-4"><label>@DetalhesAssociado?.TempoPeers</label></div>
                                    </div>
                                    <div class="row">
                                        <div class="col-md-1"><label><b>Projeto</b></label></div>
                                        <div class="col-md-3"><label>@DetalhesProjeto?.Nome</label></div>
                                        <div class="col-md-1"><label><b>Cliente</b></label></div>
                                        <div class="col-md-3"><label>@DetalhesProjeto?.Cliente</label></div>
                                        <div class="col-md-2"><label><b>Tempo restante</b></label></div>
                                        <div class="col-md-2"><label>@DetalhesProjeto?.TempoRestante</label></div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="accordion mt-3" id="accordionCabecalho">
                    <div class="card">
                        <div class="card-header" id="headingCabecalho">
                            <h5 class="mb-0">
                                <button class="btn btn-link" type="button" @onclick="() => ToggleAccordion('cabecalho')" aria-expanded="@AccordionOpen["cabecalho"]" aria-controls="Cabecalho">
                                    Descrições nível atual e próximo nível
                                </button>
                            </h5>
                        </div>
                        <div id="Cabecalho" class="collapse @(AccordionOpen["cabecalho"] ? "show" : "")" aria-labelledby="headingCabecalho" data-parent="#accordionCabecalho">
                            <table class="table table-striped border" style="width:100%;table-layout:fixed">
                                <thead>
                                    <tr>
                                        <th colspan="1"></th>
                                        <th colspan="2">Cargo</th>
                                        <th colspan="2">Função</th>
                                        <th colspan="2">Autonomia</th>
                                        <th colspan="2">Escopo de Atuação</th>
                                        <th colspan="2">Nível de interlocução principal no cliente</th>
                                        @foreach (var titulo in CabecalhoTitulos)
                                        {
                                            <th colspan="2">@titulo</th>
                                        }
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td colspan="1">Nível atual</td>
                                        <td colspan="2">@CabecalhoCargoAtual</td>
                                        <td colspan="2">@CabecalhoFuncaoAtual</td>
                                        <td colspan="2">@CabecalhoAutonomiaAtual</td>
                                        <td colspan="2">@CabecalhoEscopoAtual</td>
                                        <td colspan="2">@CabecalhoInterlocucaoAtual</td>
                                        @foreach (var desc in CabecalhoDescricoesAtuais)
                                        {
                                            <th colspan="2" style="font-weight:normal;">@desc</th>
                                        }
                                    </tr>
                                    <tr>
                                        <td colspan="1">Próximo nível</td>
                                        <td colspan="2">@CabecalhoCargoProximo</td>
                                        <td colspan="2">@CabecalhoFuncaoProximo</td>
                                        <td colspan="2">@CabecalhoAutonomiaProximo</td>
                                        <td colspan="2">@CabecalhoEscopoProximo</td>
                                        <td colspan="2">@CabecalhoInterlocucaoProximo</td>
                                        @foreach (var desc in CabecalhoDescricoesProximos)
                                        {
                                            <th colspan="2" style="font-weight:normal;">@desc</th>
                                        }
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="card col-md-12 mx-auto" style="margin-top:220px">
            <div class="card-body">
                <div class="form-body mb-2">
                    <div class="row">
                        <div class="col-md-12">
                            <div class="text-right">
                                <button class="btn btn-dark" @onclick="Salvar">Salvar Avaliação</button>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="table-responsive">
                    <table class="table table-striped border" style="width:100%;table-layout:fixed">
                        <thead>
                            <tr>
                                <th colspan="7" style="background-color:#e5e019;color:#021240;">Nível 1</th>
                                <th colspan="9" style="background-color:#e5e019;color:#021240;">Nível 2</th>
                            </tr>
                            <tr>
                                <th colspan="4" style="color:#021240;background-color:#eae678;border-bottom:6px solid;border-color:#eae678">Detalhamento Atual</th>
                                <th hidden>Nivel Atual</th>
                                <th colspan="3" style="color:#021240;background-color:#eae678;border-bottom:6px solid;border-color:#eae678">Nota Avaliado</th>
                                <th colspan="4" style="color:#021240;background-color:#eae678;border-bottom:6px solid;border-color:#eae678">Detalhamento Próximo Nível</th>
                                <th hidden>Próximo Nivel</th>
                                <th colspan="3" style="color:#021240;background-color:#eae678;border-bottom:6px solid;border-color:#eae678">Nota Avaliado</th>
                                <th colspan="2" style="color:#021240;background-color:#eae678;border-bottom:6px solid;border-color:#eae678">Considerações Avaliado</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var comp in Competencias)
                            {
                                <tr style="font-style:italic;font-size:14px;font-weight:normal;background-color:#f2f2f2;vertical-align:bottom">
                                    <th colspan="16" style="font-style:normal;font-size:21px;font-weight:normal;align-content:center;text-align:center;border-top:5px solid;border-color:#003150">
                                        @comp.SubCompetencia
                                    </th>
                                </tr>
                                <tr style="font-weight:bold;background-color:#f5f5f5;border-top:none">
                                    <td colspan="16" style="text-align:center;border-top:none">@((MarkupString)comp.PalavrasChave)</td>
                                </tr>
                                <tr style="font-weight:normal;background-color:#f9f9f9;border-top:none">
                                    <td colspan="4" style="border-top:none;background-color:#f9f9f9">
                                        <a href="#" @onclick="() => ToggleAccordion($"det_{comp.IdCompetencia}")" class="accordion-toggle">
                                            @CompetenciaHelper.TruncarTexto(comp.DetalheNivelAtual, 70)
                                            <span style="font-weight:bold"> Ver+</span>
                                        </a>
                                    </td>
                                    <td hidden colspan="1" style="border-top:none;background-color:#f9f9f9">
                                        <button type="button" @onclick="() => ToggleAccordion($"nivel_{comp.IdCompetencia}")" class="accordion-toggle">
                                            <span class="fas fa-align-justify" aria-hidden="true"></span>
                                        </button>
                                    </td>
                                    <td colspan="3" style="border-top:none;background-color:#f9f9f9">
                                        <select class="form-control p-0 select2" style="width: 100%" @bind="comp.NotaNivel1">
                                            @foreach (var nota in NotasCompetencia)
                                            {
                                                <option value="@nota.Value" disabled="@nota.IsDisabled" selected="@(comp.NotaNivel1 == nota.Value)">@nota.Text</option>
                                            }
                                        </select>
                                    </td>
                                    <td colspan="4" style="border-top:none;background-color:#f9f9f9">
                                        <a href="#" @onclick="() => ToggleAccordion($"detPrNivel_{comp.IdCompetencia}")" class="accordion-toggle">
                                            @CompetenciaHelper.TruncarTexto(comp.DetalheProximoNivel, 70)
                                            <span style="font-weight:bold"> Ver+</span>
                                        </a>
                                    </td>
                                    <td hidden colspan="1" style="border-top:none;background-color:#f9f9f9">
                                        <button type="button" @onclick="() => ToggleAccordion($"prNivel_{comp.IdCompetencia}")" class="accordion-toggle">
                                            <span class="fas fa-align-justify" aria-hidden="true"></span>
                                        </button>
                                    </td>
                                    <td colspan="3" style="border-top:none;background-color:#f9f9f9">
                                        <select class="form-control p-0 select2" style="width: 100%" @bind="comp.NotaNivel2">
                                            @foreach (var nota in NotasCompetencia)
                                            {
                                                <option value="@nota.Value" disabled="@nota.IsDisabled" selected="@(comp.NotaNivel2 == nota.Value)">@nota.Text</option>
                                            }
                                        </select>
                                    </td>
                                    <td colspan="2" style="border-top:none;background-color:#f9f9f9;text-align:center">
                                        <button type="button" @onclick="() => ToggleAccordion($"cons_{comp.IdCompetencia}")" class="accordion-toggle" style="background-color:#003150;padding:8px 15px;border:none">
                                            <span aria-hidden="true" style="color:white;font-size:15px">Considerações</span>
                                        </button>
                                    </td>
                                </tr>
                                <tr>
                                    <td colspan="16" class="hiddenRow" style="border-top:none;background-color:#ffffff">
                                        <div class="accordian-body collapse @(AccordionOpen[$"det_{comp.IdCompetencia}"] ? "show" : "")">
                                            <strong>Detalhamento Cargo Atual:</strong><br />@comp.DetalheNivelAtual
                                        </div>
                                    </td>
                                </tr>
                                <tr hidden>
                                    <td colspan="16" class="hiddenRow" style="border-top:none;background-color:#ffffff">
                                        <div class="accordian-body collapse @(AccordionOpen[$"nivel_{comp.IdCompetencia}"] ? "show" : "")">
                                            <strong>Nivel Atual:</strong><br />@comp.CompetenciaAtual
                                        </div>
                                    </td>
                                </tr>
                                <tr>
                                    <td colspan="16" class="hiddenRow" style="border-top:none;background-color:#ffffff">
                                        <div class="accordian-body collapse @(AccordionOpen[$"detPrNivel_{comp.IdCompetencia}"] ? "show" : "")">
                                            <strong>Detalhamento Próximo Nível:</strong><br />@comp.DetalheProximoNivel
                                        </div>
                                    </td>
                                </tr>
                                <tr hidden>
                                    <td colspan="16" class="hiddenRow">
                                        <div class="accordian-body collapse @(AccordionOpen[$"prNivel_{comp.IdCompetencia}"] ? "show" : "")">
                                            <strong>Próximo Nivel:</strong><br />@comp.CompetenciaProximo
                                        </div>
                                    </td>
                                </tr>
                                <tr>
                                    <td colspan="16" class="hiddenRow" style="border-top:none;background-color:#ffffff">
                                        <div class="accordian-body collapse @(AccordionOpen[$"cons_{comp.IdCompetencia}"] ? "show" : "")">
                                            <strong>Considerações:</strong><br />
                                            <textarea rows="5" class="form-control" @bind="comp.Consideracoes"></textarea>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="form-body mt-3">
                    <div class="row">
                        <div class="col-md-12">
                            <div class="text-right">
                                <button class="btn btn-dark" @onclick="Salvar">Salvar Avaliação</button>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>
}

<style>
    .hiddenRow {
        padding: 0 !important;
    }
</style>
