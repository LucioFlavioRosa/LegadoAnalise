@using Peers.Moderno.Models
@using Services.Common
@inject FormatHelper FormatHelper

<div class="card" style="position:sticky;top:80px;z-index:4;border-color: rgba(0, 0, 0, .25); border-width: 1px">
    <div class="card-body">
        <div class="form-body">
            <div class="row">
                <div class="col-md-12">
                    <div class="row">
                        <div class="divExpand">
                            <img src="@FotoAssociado" class="imgExpand" alt="Foto do Associado" />
                        </div>
                        <div class="col-sm">
                            <div class="row">
                                <div class="col-md-1">
                                    <label><b>Avaliado</b></label>
                                </div>
                                <div class="col-md-3">
                                    <label>@Associado?.Nome</label>
                                </div>
                                <div class="col-md-1">
                                    <label><b>Período</b></label>
                                </div>
                                <div class="col-md-3">
                                    <label>@Periodo</label>
                                </div>
                                <div class="col-md-1">
                                    <label><b>Cargo</b></label>
                                </div>
                                <div class="col-md-3">
                                    <label>@Associado?.Cargo?.Nome</label>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-1">
                                    <label><b>Próximo Cargo:</b></label>
                                </div>
                                <div class="col-md-3">
                                    <label>@Associado?.Cargo?.ProximoCargo?.Nome</label>
                                </div>
                                <div class="col-md-1">
                                    <label><b>Tempo de Cargo:</b></label>
                                </div>
                                <div class="col-md-3">
                                    <label>@TempoCargo</label>
                                </div>
                                <div class="col-md-1">
                                    <label><b>Tempo de Peers</b></label>
                                </div>
                                <div class="col-md-3">
                                    <label>@TempoPeers</label>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-1">
                                    <label><b>Mentor</b></label>
                                </div>
                                <div class="col-md-3">
                                    <label>@Associado?.Mentor?.Nome</label>
                                </div>
                                <div class="col-md-1">
                                    <label><b>Cronômetro</b></label>
                                </div>
                                <div class="col-sm">
                                    <div class="container">
                                        <div id="time">
                                            <span class="digit">00</span>
                                            <span class="txt">:</span>
                                            <span class="digit">00</span>
                                            <span class="txt">:</span>
                                            <span class="digit">00</span>
                                            <span class="txt">:</span>
                                            <span class="digit">00</span>
                                            <button class="btn btn-facebook" style="margin-left:40px" disabled>Iniciar</button>
                                            <button class="btn btn-facebook" disabled>Parar</button>
                                            <button class="btn btn-facebook" disabled>Reiniciar</button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="row">
                @if (Tabs != null)
                {
                    @Tabs
                }
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter] public Associado? Associado { get; set; }
    [Parameter] public string? Periodo { get; set; }
    [Parameter] public string? TempoCargo { get; set; }
    [Parameter] public string? TempoPeers { get; set; }
    [Parameter] public RenderFragment? Tabs { get; set; }
    [Parameter] public string? FotoAssociado { get; set; }
}
