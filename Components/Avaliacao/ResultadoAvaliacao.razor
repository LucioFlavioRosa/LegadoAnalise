@page "/resultado-avaliacao"
@using Peers.Moderno.Models
@using Services.Resultados.Common
@inject Services.Resultados.IResultadoService ResultadoService
@inject Services.Common.IMessageBoxService MessageBoxService
@inject Services.Common.ITelemetryService TelemetryService

<PageTitle>Resultado da Avaliação</PageTitle>

@if (isLoading)
{
    <div class="text-center mt-5">
        <span class="spinner-border" role="status" aria-hidden="true"></span>
        <span class="ml-2">Carregando dados...</span>
    </div>
}
else if (erro != null)
{
    <div class="alert alert-danger">@erro</div>
}
else if (Associado != null && Periodo != null)
{
    <div class="container-fluid page-content">
        <div class="card mb-3" style="position:sticky;top:80px;z-index:4;border-color: rgba(0, 0, 0, .25); border-width: 1px">
            <div class="card-body">
                <div class="row align-items-center">
                    <div class="col-auto">
                        <img src="@(FotoAssociado ?? "assets/images/users/usernophoto.jpg")" class="rounded-circle" style="width:100px;height:100px;object-fit:cover;" alt="Foto Associado" />
                    </div>
                    <div class="col">
                        <div class="row">
                            <div class="col-md-3"><strong>Avaliado:</strong> @Associado.Nome</div>
                            <div class="col-md-3"><strong>Período:</strong> @Periodo.Nome</div>
                            <div class="col-md-3"><strong>Cargo:</strong> @Associado.Cargo?.Nome</div>
                            <div class="col-md-3"><strong>Mentor:</strong> @Associado.Mentor?.Nome</div>
                        </div>
                        <div class="row mt-2">
                            <div class="col-md-3"><strong>Próximo Cargo:</strong> @Associado.Cargo?.ProximoCargo?.Nome</div>
                            <div class="col-md-3"><strong>Tempo de Cargo:</strong> @TempoCargo</div>
                            <div class="col-md-3"><strong>Tempo de Peers:</strong> @TempoPeers</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="card mb-3">
            <div class="card-body">
                <ul class="nav nav-pills mb-3" id="pills-tab" role="tablist">
                    <li class="nav-item">
                        <a class="nav-link @(tabAtiva == "resultados" ? "active btn btn-facebook" : "btn btn-facebook")" @onclick="() => SelecionarTab("resultados")">Resultados</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(tabAtiva == "mentor" ? "active btn btn-danger" : "btn btn-danger")" @onclick="() => SelecionarTab("mentor")">Mentor</a>
                    </li>
                </ul>
                <div class="tab-content" id="pills-tabContent">
                    @if (tabAtiva == "resultados")
                    {
                        <div class="tab-pane fade show active" id="tab-competencia" role="tabpanel">
                            <TabelaProjetos Projetos="Projetos" />
                        </div>
                    }
                    else if (tabAtiva == "mentor")
                    {
                        <div class="tab-pane fade show active" id="tab-performance" role="tabpanel">
                            <ConsideracoesMentor Associado="Associado" Periodo="Periodo" />
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public int? IdAssociado { get; set; }
    [Parameter] public int? IdPeriodo { get; set; }

    private Associado? Associado;
    private PERIODOSAVALIACOES? Periodo;
    private List<ResultadoProjetosModel> Projetos = new();
    private string? FotoAssociado;
    private string? TempoCargo;
    private string? TempoPeers;
    private string tabAtiva = "resultados";
    private bool isLoading = true;
    private string? erro;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            isLoading = true;
            erro = null;
            int idAssociado = IdAssociado ?? 0;
            int idPeriodo = IdPeriodo ?? 0;
            if (idAssociado == 0 || idPeriodo == 0)
            {
                erro = "Parâmetros obrigatórios não informados.";
                return;
            }
            var resultado = await ResultadoService.ObterResultadoAssociadoAsync(idAssociado, idPeriodo);
            Associado = resultado.Associado;
            Periodo = resultado.Periodo;
            Projetos = resultado.Projetos?.ToList() ?? new List<ResultadoProjetosModel>();
            FotoAssociado = resultado.FotoAssociado;
            TempoCargo = resultado.TempoCargo;
            TempoPeers = resultado.TempoPeers;
        }
        catch (Exception ex)
        {
            erro = "Erro ao carregar dados: " + ex.Message;
            TelemetryService.TrackException(ex);
            MessageBoxService.ShowError(erro, "Erro");
        }
        finally
        {
            isLoading = false;
        }
    }

    private void SelecionarTab(string tab)
    {
        tabAtiva = tab;
    }
}
