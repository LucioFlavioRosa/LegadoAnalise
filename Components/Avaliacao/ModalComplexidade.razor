@using Services.Common
@inject IMessageBoxService MessageBoxService
@inject Services.Projetos.IProjetosService ProjetosService
@inject Services.Projetos.Common.IProjetosComboHelper ProjetosComboHelper
@inject IJSRuntime JSRuntime

@code {
    [Parameter] public bool Show { get; set; }
    [Parameter] public EventCallback<bool> ShowChanged { get; set; }
    [Parameter] public int IdProjeto { get; set; }
    [Parameter] public EventCallback<int> OnComplexidadeSalva { get; set; }

    private List<ComboItem> Complexidades = new();
    private int IdComplexidadeSelecionada = 0;
    private string NomeProjeto = string.Empty;
    private bool IsLoading = true;

    protected override async Task OnParametersSetAsync()
    {
        if (Show)
        {
            await CarregarDadosAsync();
        }
    }

    private async Task CarregarDadosAsync()
    {
        IsLoading = true;
        var projeto = await ProjetosService.ObterProjetoAsync(IdProjeto);
        if (projeto != null)
        {
            NomeProjeto = projeto.Nome;
            IdComplexidadeSelecionada = projeto.IdComplexidade;
        }
        Complexidades = await ProjetosComboHelper.GetComplexidadesComboAsync();
        IsLoading = false;
    }

    private async Task SalvarComplexidadeAsync()
    {
        if (IdComplexidadeSelecionada == 0)
        {
            MessageBoxService.ShowWarning("Selecione uma complexidade.");
            return;
        }
        var sucesso = await ProjetosService.AlterarComplexidadeProjetoAsync(IdProjeto, IdComplexidadeSelecionada);
        if (sucesso)
        {
            MessageBoxService.ShowSuccess("Complexidade salva com sucesso.");
            await OnComplexidadeSalva.InvokeAsync(IdComplexidadeSelecionada);
            await FecharModal();
        }
        else
        {
            MessageBoxService.ShowError("Erro ao salvar complexidade do projeto.");
        }
    }

    private async Task FecharModal()
    {
        await ShowChanged.InvokeAsync(false);
    }
}

@if (Show)
{
    <div class="modal fade show" id="modalComplexidade" tabindex="-1" style="display:block;" aria-modal="true" role="dialog">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@NomeProjeto</h5>
                    <button type="button" class="close" aria-label="Close" @onclick="FecharModal">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    @if (IsLoading)
                    {
                        <span class="spinner-border"></span> Carregando...
                    }
                    else
                    {
                        <div class="form-group">
                            <label for="ddlComplexidade" class="col-form-label">Complexidade:</label>
                            <select class="form-control" id="ddlComplexidade" @bind="IdComplexidadeSelecionada">
                                @foreach (var item in Complexidades)
                                {
                                    <option value="@item.Value" selected="@(item.Value == IdComplexidadeSelecionada.ToString())">@item.Text</option>
                                }
                            </select>
                        </div>
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-primary" @onclick="SalvarComplexidadeAsync">Salvar</button>
                    <button type="button" class="btn btn-secondary" @onclick="FecharModal">Cancelar</button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade show"></div>
}
