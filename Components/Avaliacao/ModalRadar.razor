@inject IJSRuntime JSRuntime

@code {
    [Parameter] public bool Show { get; set; }
    [Parameter] public EventCallback<bool> ShowChanged { get; set; }
    [Parameter] public string Titulo { get; set; } = "Radar";
    [Parameter] public string CanvasId { get; set; } = "radar_modal";
    [Parameter] public object? RadarData { get; set; }

    private ElementReference ModalRef;
    private bool IsInitialized = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (Show && !IsInitialized)
        {
            await JSRuntime.InvokeVoidAsync("$('#modalRadar').modal", "show");
            IsInitialized = true;
            await RenderRadarChartAsync();
        }
        else if (!Show && IsInitialized)
        {
            await JSRuntime.InvokeVoidAsync("$('#modalRadar').modal", "hide");
            IsInitialized = false;
        }
    }

    private async Task RenderRadarChartAsync()
    {
        if (RadarData != null)
        {
            await JSRuntime.InvokeVoidAsync("renderRadarChart", CanvasId, RadarData);
        }
    }

    private async Task FecharModal()
    {
        await ShowChanged.InvokeAsync(false);
    }
}

@if (Show)
{
    <div class="modal fade show" id="modalRadar" tabindex="-1" style="display:block;" aria-modal="true" role="dialog">
        <div class="modal-dialog modal-lg" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@Titulo</h5>
                    <button type="button" class="close" aria-label="Close" @onclick="FecharModal">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    <canvas id="@CanvasId"></canvas>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="FecharModal">Fechar</button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade show"></div>
}
