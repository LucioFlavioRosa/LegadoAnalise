@rendermode InteractiveAuto
@using Services.AvaliacaoMentorCompetencia.Common
@inject IAplicacaoMentorCompetenciaService AvaliacaoMentorCompetenciaService

<div class="card">
    <div class="card-header" id="headingResultados">
        <h5 class="mb-0">
            <button class="btn btn-link" type="button" data-bs-toggle="collapse" data-bs-target="#Resultados" aria-expanded="true" aria-controls="Resultados">
                Resultados do Semestre
            </button>
        </h5>
    </div>
    <div id="Resultados" class="collapse show" aria-labelledby="headingResultados">
        <div class="card-body resultado-group scroll-grid">
            @if (Resultados != null)
            {
                <div class="row">
                    @foreach (var projeto in Resultados.Projetos)
                    {
                        <div class="col-md-3">
                            <div class="row">
                                <div class="col-md-12">
                                    <table class="table table-striped border tbresultado">
                                        <tbody>
                                            <tr>
                                                <td class="tdBranco" colspan="2">Projeto @projeto.Nome</td>
                                            </tr>
                                            <tr>
                                                <td class="thresultado" colspan="2" title="@projeto.Nome">
                                                    <button type="button" class="btn btn-sm btncollapse" @onclick="() => ToggleProjeto(projeto.Id)">
                                                        <i class="fas fa-plus-circle"></i>
                                                    </button>
                                                    @projeto.Nome
                                                </td>
                                            </tr>
                                            <tr>
                                                <td class="tdresultado" style="width: 70%">Complexidade</td>
                                                <td class="text-center" style="width: 30%">@projeto.Complexidade</td>
                                            </tr>
                                            <tr>
                                                <td class="tdresultado">Nível</td>
                                                <td class="text-center">@projeto.Nivel</td>
                                            </tr>
                                            <tr>
                                                <td class="tdresultado">Nota Competências</td>
                                                <td class="text-center">@projeto.NotaCompetencias</td>
                                            </tr>
                                            @foreach (var eixo in projeto.Eixos)
                                            {
                                                <tr class="hidelinha">
                                                    <td>@eixo.Nome</td>
                                                    <td class="text-center">@eixo.Percentual</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-12">
                                    <table class="table table-striped border tbresultado">
                                        <tbody>
                                            <tr>
                                                <td class="tdresultado" style="width: 70%">Nota Performance </td>
                                                <td class="text-center" style="width: 30%">@projeto.NotaPerformance</td>
                                            </tr>
                                            @foreach (var perf in projeto.Performances)
                                            {
                                                <tr class="hidelinha">
                                                    <td>@perf.Nome</td>
                                                    <td class="text-center">@perf.Nota</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    }
                    <div class="col-md-3">
                        <table class="table table-striped border tbresultado">
                            <tbody>
                                <tr>
                                    <td class="tdBranco" colspan="2">Consolidado</td>
                                </tr>
                                <tr>
                                    <td class="tdComite" style="width: 70%">Complexidade Comitê</td>
                                    <td class="text-center" style="width: 30%">@Resultados.Consolidado.ComplexidadeComite</td>
                                </tr>
                                <tr>
                                    <td class="tdresultado">Competência no Cargo</td>
                                    <td class="text-center">@Resultados.Consolidado.CompetenciaCargo</td>
                                </tr>
                                <tr>
                                    <td class="tdresultado">Competência Cargo Acima</td>
                                    <td class="text-center">@Resultados.Consolidado.CompetenciaProximoCargo</td>
                                </tr>
                                <tr>
                                    <td class="tdresultado">Nota Performance</td>
                                    <td class="text-center">@Resultados.Consolidado.NotaPerformance</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            }
            else
            {
                <div class="alert alert-info">Nenhum resultado encontrado para o semestre.</div>
            }
        </div>
    </div>
</div>

@code {
    [Parameter] public Associado? Associado { get; set; }
    [Parameter] public Periodo? Periodo { get; set; }
    [Parameter] public Projeto? Projeto { get; set; }

    private ResultadosMentorModel? Resultados;
    private int? ProjetoAbertoId;

    protected override async Task OnParametersSetAsync()
    {
        if (Associado != null && Periodo != null)
        {
            Resultados = await AvaliacaoMentorCompetenciaService.ObterResultadosMentorAsync(Associado.Id, Periodo.Id, Projeto?.Id);
        }
    }

    private void ToggleProjeto(int idProjeto)
    {
        ProjetoAbertoId = ProjetoAbertoId == idProjeto ? null : idProjeto;
    }
}
