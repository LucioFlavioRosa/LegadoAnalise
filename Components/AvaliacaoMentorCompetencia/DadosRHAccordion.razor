@rendermode InteractiveAuto
@using Peers.Moderno.Services.AvaliacaoMentorCompetencia.Common
@inject IAvaliacaoMentorCompetenciaService AvaliacaoMentorCompetenciaService
@inject IMessageBoxService MessageBoxService

@code {
    [Parameter]
    public int IdAssociado { get; set; }
    [Parameter]
    public int IdPeriodo { get; set; }
    [Parameter]
    public string TipoAvaliacao { get; set; } = "desempenho";
    [Parameter]
    public string Escopo { get; set; } = "projeto";

    private DadosRHModel? DadosRH;
    private bool IsLoading = true;
    private string? ErrorMessage;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            DadosRH = await AvaliacaoMentorCompetenciaService.ObterDadosRHAsync(IdAssociado, IdPeriodo, TipoAvaliacao, Escopo);
        }
        catch (Exception ex)
        {
            ErrorMessage = ex.Message;
            MessageBoxService.Show(ErrorMessage, "Erro", MessageBoxType.Error);
        }
        finally
        {
            IsLoading = false;
        }
    }
}

@if (IsLoading)
{
    <div class="spinner-border" role="status"><span class="sr-only">Carregando...</span></div>
}
else if (!string.IsNullOrEmpty(ErrorMessage))
{
    <div class="alert alert-danger">@ErrorMessage</div>
}
else if (DadosRH != null && DadosRH.LiberadoRH)
{
    <div class="card" id="accordionDadosRH">
        <div class="card-header" id="headindDadosRH">
            <h5 class="mb-0">
                <button class="btn btn-link collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#dadosRH" aria-expanded="false" aria-controls="collapseThree">
                    Dados do RH
                </button>
            </h5>
        </div>
        <div id="dadosRH" class="collapse show" aria-labelledby="headindDadosRH" data-parent="#headindDadosRH">
            <div class="card-body">
                <div class="row">
                    <div class="col-sm">
                        <label style="font-size:18px;list-style-type: none;padding-left: 0px;float:left;width: 40%;">Ação comitê:</label>
                        <span style="background-color:#F2F2F2;font-size:18px;list-style-type: none;float:right;width: 60%;text-align:center">@DadosRH.AcaoComite</span>
                    </div>
                    <div class="col-sm">
                        <label style="font-size:18px;list-style-type: none;padding-left: 0px;float:left;width: 40%;">Próximo cargo:</label>
                        <span style="background-color:#F2F2F2;font-size:18px;list-style-type: none;float:right;width: 60%;text-align:center">@DadosRH.ProximoCargo</span>
                    </div>
                </div>
                <div class="row">
                    <div class="col-sm">
                        <label style="font-size:18px;list-style-type: none;padding-left: 0px;float:left;width: 40%;">Salário atual:</label>
                        <span style="background-color:#F2F2F2;font-size:18px;list-style-type: none;float:right;width: 60%;text-align:center">@DadosRH.SalarioAtual</span>
                    </div>
                    <div class="col-sm">
                        <label style="font-size:18px;list-style-type: none;padding-left: 0px;float:left;width: 40%;">Próximo salário:</label>
                        <span style="background-color:#F2F2F2;font-size:18px;list-style-type: none;float:right;width: 60%;text-align:center">@DadosRH.SalarioNovo</span>
                    </div>
                    <div class="col-sm">
                        <label style="font-size:18px;list-style-type: none;padding-left: 0px;float:left;width: 40%;">Incremento(%):</label>
                        <span style="background-color:#F2F2F2;font-size:18px;list-style-type: none;float:right;width: 60%;text-align:center">@DadosRH.Incremento</span>
                    </div>
                </div>
                <div class="row">
                    <div class="col-sm">
                        <label style="font-size:18px;list-style-type: none;padding-left: 0px;float:left;width: 40%;">Regime de contratação atual:</label>
                        <span style="background-color:#F2F2F2;font-size:18px;list-style-type: none;float:right;width: 60%;text-align:center">@DadosRH.RegimeContratacaoAtual</span>
                    </div>
                    <div class="col-sm">
                        <label style="font-size:18px;list-style-type: none;padding-left: 0px;float:left;width: 40%;">Regime de contratação novo:</label>
                        <span style="background-color:#F2F2F2;font-size:18px;list-style-type: none;float:right;width: 60%;text-align:center">@DadosRH.RegimeContratacaoNovo</span>
                    </div>
                </div>
                <br />
                <div class="row">
                    <div class="col-sm">
                        <label style="font-size:18px;list-style-type: none;padding-left: 0px;float:left;width: 100%;position:relative;z-index:1;height:6px">Pontos Fortes:</label>
                    </div>
                </div>
                <div class="row">
                    <div class="col-sm">
                        <span style="background-color:#F2F2F2;font-size:15px;list-style-type: none;float:right;width: 100%;height: 100px;vertical-align:top;text-align:left;border:none;padding-top:7px">@DadosRH.PontosFortesRH</span>
                    </div>
                </div>
                <div class="row">
                    <div class="col-sm">
                        <label style="font-size:18px;list-style-type: none;padding-left: 0px;float:left;width: 100%;position:relative;z-index:1;height:6px">Pontos de atenção:</label>
                    </div>
                </div>
                <div class="row">
                    <div class="col-sm">
                        <span style="background-color:#F2F2F2;font-size:15px;list-style-type: none;float:right;width: 100%;height: 100px;vertical-align:top;text-align:left;border:none;padding-top:7px">@DadosRH.PontosFracosRH</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
